import std.test;
import raster_sine;

fn test_a_line_goes_out_and_back_smoothly() -> [] int {
    var s = raster_sine.start(2000);
    // 64 ticks of 1024 phase units: one line
    var lo = 1000000;
    var hi = 0 - 1;
    var last = raster_sine.x_of(s, 1000, 3000);
    var maxjump = 0;
    var t = 0;
    while t < 64 {
        let x = raster_sine.x_of(s, 1000, 3000);
        if x < lo { lo = x; }
        if x > hi { hi = x; }
        var d = x - last;
        if d < 0 { d = 0 - d; }
        if d > maxjump { maxjump = d; }
        last = x;
        s = raster_sine.step(s, 1024, 2, 250);
        t = t + 1;
    }
    // it starts at x0, reaches x0 + amp (within one table step of it), and no step is bigger than the sine's steepest tick (amp * pi * 1024 / 65536 = 147)
    test.assert(lo >= 1000);
    test.assert(lo <= 1001);
    test.assert(hi >= 3999);
    test.assert(hi <= 4000);
    test.assert(maxjump <= 150);
    // after one line the slow axis has stepped and the second line has begun
    test.assert_eq(s.line, 1);
    test.assert_eq(s.y, 2250);
    return 0;
}

fn test_it_traces_on_the_first_half_and_stops_after_the_last_line() -> [] int {
    var s = raster_sine.start(0);
    var traced = 0;
    var ticks = 0;
    while s.done == 0 && ticks < 1000 {
        traced = traced + raster_sine.tracing(s);
        s = raster_sine.step(s, 2048, 3, 100);
        ticks = ticks + 1;
    }
    // 3 lines of 32 ticks, half of each traced
    test.assert_eq(ticks, 96);
    test.assert_eq(traced, 48);
    test.assert_eq(s.done, 1);
    test.assert_eq(s.line, 2);
    test.assert_eq(s.y, 200);
    // done is final
    let again = raster_sine.step(s, 2048, 3, 100);
    test.assert_eq(again.phase, s.phase);
    return 0;
}
