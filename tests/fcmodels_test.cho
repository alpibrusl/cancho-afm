import std.test;
import adequacy;
import forcecurve;
import dfs;
import bilayer;
import fcmodels;

// docs/dynamics.md: the force-curve model library. The checks are of direction and of consistency between the pieces, not of agreement with a membrane: the rupture kinetics and the moduli are stand-ins.

fn test_the_models_order_as_the_physics_they_were_given() -> [] int {
    region r {
        let m = alloc_slice[r](6 * 8, 0.0);
        let v = alloc_slice[r](8, 0.0);
        let one = alloc_slice[r](8, 0.0);
        var i = 0;
        while i < 6 {
            fcmodels.ensemble(i, 16, 8, 1, one, v);
            var t = 0;
            while t < 8 { m[i * 8 + t] = one[t]; t = t + 1; }
            i = i + 1;
        }
        // breakthrough: gel > fluid > melted; the same for the Hertz modulus
        test.assert(m[1 * 8 + 0] > m[0 * 8 + 0]);
        test.assert(m[0 * 8 + 0] > m[2 * 8 + 0]);
        test.assert(m[1 * 8 + 1] > m[0 * 8 + 1]);
        test.assert(m[0 * 8 + 1] > m[2 * 8 + 1]);
        // ten times the speed: a larger breakthrough force (dynamic force spectroscopy) and the same Hertz modulus (the elastic branch does not depend on the speed), within 2%
        test.assert(m[4 * 8 + 0] > 1.1 * m[0 * 8 + 0]);
        var d = m[4 * 8 + 1] - m[0 * 8 + 1];
        if d < 0.0 { d = 0.0 - d; }
        test.assert(d < 0.02 * m[0 * 8 + 1]);
        // the mixture's spread of breakthrough forces is much larger than that of one phase
        test.assert(m[5 * 8 + 5] > 3.0 * m[0 * 8 + 5]);
        // every curve found its breakthrough
        test.assert(m[0 * 8 + 6] > 0.99);
    }
    return 0;
}

fn test_a_force_curve_model_reproduces_itself_and_not_the_others() -> [] int {
    region r {
        let gm = alloc_slice[r](24, 0.0);
        let gv = alloc_slice[r](24, 0.0);
        let pm = alloc_slice[r](24, 0.0);
        let pv = alloc_slice[r](24, 0.0);
        let am = alloc_slice[r](8, 0.0);
        let av = alloc_slice[r](8, 0.0);
        let bm = alloc_slice[r](8, 0.0);
        let bv = alloc_slice[r](8, 0.0);
        let z = alloc_slice[r](8, 0.0);
        var i = 0;
        while i < 3 {
            fcmodels.ensemble(i, 16, 12, 1, am, av);
            fcmodels.ensemble(i, 16, 12, 1001, bm, bv);
            var t = 0;
            while t < 8 { gm[i * 8 + t] = am[t]; gv[i * 8 + t] = av[t]; pm[i * 8 + t] = bm[t]; pv[i * 8 + t] = bv[t]; t = t + 1; }
            i = i + 1;
        }
        i = 0;
        while i < 3 {
            var j = 0;
            while j < 3 {
                var t = 0;
                while t < 8 { am[t] = gm[i * 8 + t]; av[t] = gv[i * 8 + t]; bm[t] = pm[j * 8 + t]; bv[t] = pv[j * 8 + t]; t = t + 1; }
                let d = adequacy.compare2(am, av, 12, bm, bv, 12, z);
                if i == j { test.assert(d < 2.5); } else { test.assert(d > 3.0); }
                j = j + 1;
            }
            i = i + 1;
        }
    }
    return 0;
}
