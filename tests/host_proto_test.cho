import std.test;
import board;
import proto;
import twin_link;

fn test_the_requests_are_the_bytes_the_bridge_expects() -> [] int {
    region r {
        let b = alloc_slice[r](16, byte_of(0));
        test.assert_eq(proto.write_req(b, 1, 3735928559), 9);
        test.assert_eq(int_of(b[0]), 87);
        test.assert_eq(int_of(b[1]), 64);
        test.assert_eq(int_of(b[2]), 0);
        test.assert_eq(int_of(b[3]), 0);
        test.assert_eq(int_of(b[4]), 4);
        test.assert_eq(int_of(b[5]), 222);
        test.assert_eq(int_of(b[6]), 173);
        test.assert_eq(int_of(b[7]), 190);
        test.assert_eq(int_of(b[8]), 239);
        test.assert_eq(proto.read_req(b, 33), 5);
        test.assert_eq(int_of(b[0]), 82);
        test.assert_eq(int_of(b[4]), 132);
    }
    return 0;
}

// The twin's bridge answers the bytes the way the Verilog bridge does (compare gen/uart_bridge_tb.v and gen/afm_top_tb.v phase 1).
fn test_the_twin_answers_like_the_bridge() -> [] int {
    region r {
        let rf = alloc_slice[r](64, 0);
        let st = alloc_slice[r](32, 0);
        let fl = alloc_slice[r](24, 0.0);
        board.reset(rf, st, fl);
        let req = alloc_slice[r](16, byte_of(0));
        let rsp = alloc_slice[r](16, byte_of(0));
        // the identifier
        proto.read_req(req, 0);
        test.assert_eq(twin_link.exchange(rf, st, req, rsp, fl), 5);
        test.assert_eq(proto.resp_code(rsp), 0);
        test.assert_eq(proto.resp_value(rsp), 0xAF500001);
        // a write and its read-back
        proto.write_req(req, 3, 77);
        test.assert_eq(twin_link.exchange(rf, st, req, rsp, fl), 1);
        test.assert_eq(proto.resp_code(rsp), 0);
        proto.read_req(req, 3);
        twin_link.exchange(rf, st, req, rsp, fl);
        test.assert_eq(proto.resp_value(rsp), 77);
        // a write to a read-only register is SLVERR and changes nothing
        proto.write_req(req, 2, 1);
        twin_link.exchange(rf, st, req, rsp, fl);
        test.assert_eq(proto.resp_code(rsp), 2);
        // an address with no register, and one below the base, are SLVERR
        proto.read_req(req, 60);
        twin_link.exchange(rf, st, req, rsp, fl);
        test.assert_eq(proto.resp_code(rsp), 2);
        req[1] = byte_of(0);
        twin_link.exchange(rf, st, req, rsp, fl);
        test.assert_eq(proto.resp_code(rsp), 2);
        // a byte that is not a command is ignored
        req[0] = byte_of(65);
        test.assert_eq(twin_link.exchange(rf, st, req, rsp, fl), 0);
        // a value with the top bit set comes back whole, and signed reads give the negative number
        proto.write_req(req, 8, 4294967286);
        twin_link.exchange(rf, st, req, rsp, fl);
        proto.read_req(req, 8);
        twin_link.exchange(rf, st, req, rsp, fl);
        test.assert_eq(proto.signed(proto.resp_value(rsp)), 0 - 10);
    }
    return 0;
}
