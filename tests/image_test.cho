import std.test;
import std.math;
import image;

// Images of 32 x 32 (a region holds 64 KiB): flat, three particles (raised cosine, 450 to 600 pm) and a known tilt.
fn bump(x: float, y: float, cx: float, cy: float, h: float) -> [] float {
    let d2 = ((x - cx) * (x - cx) + (y - cy) * (y - cy)) / 16.0;
    if d2 >= 1.0 { return 0.0; }
    return h * (1.0 - d2) * (1.0 - d2);
}

fn tilted_with_particles[&a](z: &!a [float], bx: float, by: float) -> [] int {
    var j = 0;
    while j < 32 {
        var i = 0;
        while i < 32 {
            let x = float_of(i);
            let y = float_of(j);
            z[j * 32 + i] = bx * (x - 15.5) + by * (y - 15.5) + bump(x, y, 6.0, 7.0, 600.0) + bump(x, y, 20.0, 12.0, 450.0) + bump(x, y, 11.0, 23.0, 600.0);
            i = i + 1;
        }
        j = j + 1;
    }
    return 0;
}

fn near(a: float, b: float, tol: float) -> [] int {
    var d = a - b;
    if d < 0.0 { d = 0.0 - d; }
    if d <= tol { return 1; }
    return 0;
}

fn test_the_plain_plane_is_pulled_by_particles_the_robust_one_is_not() -> [] int {
    region r {
        let z = alloc_slice[r](32 * 32, 0.0);
        let w = alloc_slice[r](32 * 32, byte_of(1));
        tilted_with_particles(z, 2.0, 0.0 - 1.5);
        let plain = image.plane_fit(z, w, 32, 32);
        let rob = image.plane_robust(z, 32, 32, 3, 2.5);
        // the plain fit is off by over a pm per pixel (three particles); the robust one is within 0.02
        test.assert_eq(near(plain.bx, 2.0, 0.5), 0);
        test.assert_eq(near(rob.bx, 2.0, 0.02), 1);
        test.assert_eq(near(rob.by, 0.0 - 1.5, 0.02), 1);
    }
    return 0;
}

fn test_subtracting_the_tilt_leaves_the_particles() -> [] int {
    region r {
        let z = alloc_slice[r](32 * 32, 0.0);
        tilted_with_particles(z, 2.0, 0.0 - 1.5);
        let rob = image.plane_robust(z, 32, 32, 3, 2.5);
        image.subtract_tilt(z, 32, 32, rob);
        // a corner is flat now (it was 2 * 15.5 + 1.5 * 15.5 = 54 pm off the centre), the first particle's top is near 600
        test.assert_eq(near(z[0], 0.0, 2.0), 1);
        test.assert_eq(near(z[31 * 32 + 31], 0.0, 2.0), 1);
        test.assert_eq(near(z[7 * 32 + 6], 600.0, 5.0), 1);
    }
    return 0;
}

fn test_line_offsets_go_and_a_step_across_the_lines_stays() -> [] int {
    region r {
        let z = alloc_slice[r](32 * 32, 0.0);
        var j = 0;
        while j < 32 {
            let off = float_of((j * 1103515245 + 12345) / 65536 % 81 - 40);
            var step = 0.0;
            if j >= 16 { step = 150.0; }
            var i = 0;
            while i < 32 { z[j * 32 + i] = off + step; i = i + 1; }
            j = j + 1;
        }
        image.level_lines(z, 32, 32, 4);
        // away from the step (more than 4 lines): near the two levels, within 20 pm; across the step, still about 150
        test.assert_eq(near(z[2 * 32], 0.0, 20.0), 1);
        test.assert_eq(near(z[29 * 32], 150.0, 20.0), 1);
        test.assert_eq(near(z[17 * 32] - z[14 * 32], 150.0, 50.0), 1);
    }
    return 0;
}

// A bow of 60 pm at the edges (quadratic about the middle of the 32 pixel line) under a grating of pitch 8 (4 periods), 30 pm peak to peak: after `level_bow` the edge-to-middle difference of the
// column medians is a few pm, not 60.
fn test_a_bow_along_x_is_levelled_out() -> [] int {
    region g {
        let z = alloc_slice[g](32 * 32, 0.0);
        var j = 0;
        while j < 32 {
            var i = 0;
            while i < 32 {
                let u = (float_of(i) - 15.5) / 15.5;
                z[j * 32 + i] = 60.0 * u * u + 15.0 * math.sin(6.283185307179586 * float_of(i) / 8.0);
                i = i + 1;
            }
            j = j + 1;
        }
        image.level_bow(z, 32, 32);
        // the end of the line (x = 0, a sine zero) against its middle (x = 16, also a zero): 60 pm apart before
        var d = z[0] - z[16];
        if d < 0.0 { d = 0.0 - d; }
        var ok = 0;
        if d < 8.0 { ok = 1; }
        test.assert_eq(ok, 1);
    }
    return 0;
}
