import std.test;
import board;
import plant;
import pid;
import raster;
import lockin;

fn test_defaults_and_refusals_match_the_hardware() -> [] int {
    region r {
        let rf = alloc_slice[r](64, 0);
        let st = alloc_slice[r](32, 0);
        let fl = alloc_slice[r](48, 0.0);
        board.reset(rf, st, fl);
        let (id, r0) = board.read(rf, st, 0);
        test.assert_eq(id, 0xAF500001);
        test.assert_eq(r0, 0);
        // fails closed: every limit zero, nothing running
        let (zmax, r1) = board.read(rf, st, 14);
        test.assert_eq(zmax, 0);
        let (ctrl, r2) = board.read(rf, st, 1);
        test.assert_eq(ctrl, 0);
        // read-back
        test.assert_eq(board.write(rf, st, 3, 103), 0);
        let (sd, r3) = board.read(rf, st, 3);
        test.assert_eq(sd, 103);
        // a write to a read-only register, and to and from unmapped ones, are refused
        test.assert_eq(board.write(rf, st, 2, 1), 2);
        test.assert_eq(board.write(rf, st, 0, 1), 2);
        test.assert_eq(board.write(rf, st, 52, 1), 2);
        // the optical lever's two registers are read-only
        test.assert_eq(board.write(rf, st, 50, 1), 2);
        test.assert_eq(board.write(rf, st, 51, 1), 2);
        let (z, r4) = board.read(rf, st, 52);
        test.assert_eq(r4, 2);
        test.assert_eq(board.write(rf, st, 27, 7), 0);
        let (pd, r5) = board.read(rf, st, 27);
        test.assert_eq(pd, 7);
    }
    return 0;
}

// The same settings the Verilog system test uses (gen/afm_top_tb.v): window 64, sample 103 clocks, 2,000 pm free, a first-order lag of 0.0016
// per conversion (f0 = 32,768 Hz, Q = 245 gives pi f0 / (Q fs) = 0.0016 at 262 kS/s). The Verilog run measured a free figure of 41,822 and
// settled Z at 1,599 pm against a 1,600 pm target.
fn setup[&a, &b, &c](rf: &!a [int], st: &!b [int], fl: &!c [float]) -> [] int {
    board.reset(rf, st, fl);
    board.set_plant(fl, 32768.0, 245.0, 2000.0, 2000.0, 0.0, 0.0, 0.0);
    board.write(rf, st, 5, 64);
    return 0;
}

fn test_the_free_figure_matches_the_verilog_run() -> [] int {
    region r {
        let rf = alloc_slice[r](64, 0);
        let st = alloc_slice[r](32, 0);
        let fl = alloc_slice[r](48, 0.0);
        setup(rf, st, fl);
        board.write(rf, st, 1, 24);        // manual + adc_run
        board.write(rf, st, 28, 2500);     // Z at 40,000 pm: far above the surface
        board.advance(rf, st, fl, 2000);
        let (fig, rr) = board.read(rf, st, 32);
        // Verilog: 41,822. The twin has the same detector arithmetic and the same samples, so it matches to a few counts
        test.assert(fig > 41700);
        test.assert(fig < 41950);
        let (adc0, r1) = board.read(rf, st, 38);
        test.assert(adc0 > 1000);
        test.assert(adc0 < 3100);
    }
    return 0;
}

fn test_the_loop_settles_where_the_verilog_run_does() -> [] int {
    region r {
        let rf = alloc_slice[r](64, 0);
        let st = alloc_slice[r](32, 0);
        let fl = alloc_slice[r](48, 0.0);
        setup(rf, st, fl);
        board.write(rf, st, 1, 24); board.write(rf, st, 28, 2500);
        board.advance(rf, st, fl, 2000);
        let (free_fig, rr) = board.read(rf, st, 32);
        board.write(rf, st, 1, 0);
        board.write(rf, st, 7, 4); board.write(rf, st, 8, (free_fig * 8 / 10) / 16); board.write(rf, st, 9, 2304);
        board.write(rf, st, 12, 65535); board.write(rf, st, 13, 0); board.write(rf, st, 14, 60000);
        board.write(rf, st, 15, 3000); board.write(rf, st, 16, 60000); board.write(rf, st, 17, 40000000);
        board.write(rf, st, 1, 19);        // run + drive + adc_run
        // the Verilog run reached the end of its phase 3 after about 285 windows of 64 conversions
        board.advance(rf, st, fl, 285 * 64);
        let (zz, r1) = board.read(rf, st, 33);
        // Verilog: 1,599 pm (and the DAC 1,584 after its 16 pm quantisation). The twin lands within a few pm of it.
        test.assert(zz > 1560);
        test.assert(zz < 1640);
        let (status, r2) = board.read(rf, st, 2);
        test.assert_eq(status % 2, 0);
    }
    return 0;
}

fn test_the_limit_the_deadman_and_the_reset() -> [] int {
    region r {
        let rf = alloc_slice[r](64, 0);
        let st = alloc_slice[r](32, 0);
        let fl = alloc_slice[r](48, 0.0);
        setup(rf, st, fl);
        board.write(rf, st, 7, 4); board.write(rf, st, 8, 2190); board.write(rf, st, 9, 2304);
        board.write(rf, st, 12, 65535); board.write(rf, st, 13, 0); board.write(rf, st, 14, 60000);
        board.write(rf, st, 15, 3000); board.write(rf, st, 16, 60000); board.write(rf, st, 17, 300000);
        board.write(rf, st, 1, 17);        // run + adc_run
        // a heartbeat every 80,000 clocks (about 776 conversions) keeps a 300,000-clock deadman quiet
        var i = 0;
        while i < 15 {
            board.write(rf, st, 18, 0);
            board.advance(rf, st, fl, 776);
            i = i + 1;
        }
        let (s1, r1) = board.read(rf, st, 2);
        test.assert_eq(s1 % 2, 0);
        // lowering the limit clamps Z at once
        board.write(rf, st, 14, 1000);
        let (z1, r2) = board.read(rf, st, 33);
        test.assert_eq(z1, 1000);
        board.write(rf, st, 14, 60000);
        // no more heartbeats: the deadman latches, Z goes to the retract value
        board.advance(rf, st, fl, 4000);
        let (s2, r3) = board.read(rf, st, 2);
        test.assert_eq(s2 % 2, 1);
        let (z2, r4) = board.read(rf, st, 33);
        test.assert_eq(z2, 60000);
        // run off clears the fault and returns Z to rest
        board.write(rf, st, 1, 16);
        let (s3, r5) = board.read(rf, st, 2);
        test.assert_eq(s3 % 2, 0);
        let (z3, r6) = board.read(rf, st, 33);
        test.assert_eq(z3, 3000);
    }
    return 0;
}

// The raster, one pixel per 3 loop steps, as the Verilog phase 6 runs it: 4 pixels, 2 lines: 12 ticks, 36 windows; X ends at 1,000, Y at 2,250.
fn test_the_scan_ends_where_the_verilog_scan_does() -> [] int {
    region r {
        let rf = alloc_slice[r](64, 0);
        let st = alloc_slice[r](32, 0);
        let fl = alloc_slice[r](48, 0.0);
        setup(rf, st, fl);
        board.write(rf, st, 7, 4); board.write(rf, st, 8, 2190); board.write(rf, st, 9, 2304);
        board.write(rf, st, 12, 65535); board.write(rf, st, 14, 60000); board.write(rf, st, 15, 3000); board.write(rf, st, 16, 60000);
        board.write(rf, st, 21, 4); board.write(rf, st, 22, 2); board.write(rf, st, 23, 1000); board.write(rf, st, 24, 2000);
        board.write(rf, st, 25, 100); board.write(rf, st, 26, 250); board.write(rf, st, 27, 3);
        board.write(rf, st, 1, 21);        // run + scan + adc_run
        board.advance(rf, st, fl, 20 * 64);
        let (s1, r1) = board.read(rf, st, 2);
        test.assert_eq(s1 / 8 % 2, 0);     // 20 windows: not done (36 are needed)
        board.advance(rf, st, fl, 30 * 64);
        let (s2, r2) = board.read(rf, st, 2);
        test.assert_eq(s2 / 8 % 2, 1);
        let (xx, r3) = board.read(rf, st, 34);
        let (yy, r4) = board.read(rf, st, 35);
        test.assert_eq(xx, 1000);
        test.assert_eq(yy, 2250);
    }
    return 0;
}

// The sinusoidal fast axis (CTRL bit 6, registers 48 and 49): x = x0 + amp (1 - cos) / 2, four ticks a line at PSTEP 16384, three windows a tick.
fn test_the_sine_scan_follows_the_cosine() -> [] int {
    region r {
        let rf = alloc_slice[r](64, 0);
        let st = alloc_slice[r](32, 0);
        let fl = alloc_slice[r](48, 0.0);
        setup(rf, st, fl);
        board.write(rf, st, 7, 4); board.write(rf, st, 8, 2190); board.write(rf, st, 9, 2304);
        board.write(rf, st, 12, 65535); board.write(rf, st, 14, 60000); board.write(rf, st, 15, 3000); board.write(rf, st, 16, 60000);
        board.write(rf, st, 22, 2); board.write(rf, st, 23, 1000); board.write(rf, st, 24, 2000);
        board.write(rf, st, 26, 250); board.write(rf, st, 27, 3);
        board.write(rf, st, 48, 40000); board.write(rf, st, 49, 16384);
        let (a48, ra) = board.read(rf, st, 48);
        test.assert_eq(a48, 40000);
        board.write(rf, st, 1, 85);        // run + scan + adc_run + sine
        board.advance(rf, st, fl, 6 * 64);
        let (xm, r1) = board.read(rf, st, 34);
        test.assert_eq(xm, 40999);          // half a turn: x0 + amp * 65535 / 65536
        let (s1, r2) = board.read(rf, st, 2);
        test.assert_eq(s1 / 8 % 2, 0);
        board.advance(rf, st, fl, 18 * 64);
        let (s2, r3) = board.read(rf, st, 2);
        test.assert_eq(s2 / 8 % 2, 1);      // 8 ticks: two lines
        let (xx, r4) = board.read(rf, st, 34);
        let (yy, r5) = board.read(rf, st, 35);
        test.assert_eq(xx, 1000);
        test.assert_eq(yy, 2250);
    }
    return 0;
}

// The coarse motor, as the Verilog phase 7 runs it: fails closed (MOTOR_MAX = 0 refuses everything, a disabled driver ignores), counts, direction,
// the maximum, and an abort when disabled. 198.4375 pm of tip travel per microstep.
fn test_the_motor_fails_closed_and_moves_the_tip() -> [] int {
    region r {
        let rf = alloc_slice[r](64, 0);
        let st = alloc_slice[r](32, 0);
        let fl = alloc_slice[r](48, 0.0);
        board.reset(rf, st, fl);
        board.set_distance(fl, 10000.0, 198.4375);
        let (mx, r0) = board.read(rf, st, 47);
        test.assert_eq(mx, 0);
        board.write(rf, st, 44, 40);
        board.write(rf, st, 1, 32);            // motor enable only
        // MOTOR_MAX = 0: a command is refused and nothing moves
        board.write(rf, st, 43, 1);
        let (s0, r1) = board.read(rf, st, 45);
        test.assert_eq(s0 / 4 % 2, 1);
        board.advance(rf, st, fl, 100);
        let (p0, r2) = board.read(rf, st, 46);
        test.assert_eq(p0, 0);
        board.write(rf, st, 47, 10);
        board.write(rf, st, 43, 5);
        board.advance(rf, st, fl, 100);        // 10,300 clocks: 5 steps of 40 clocks take 200
        let (s1, r3) = board.read(rf, st, 45);
        test.assert_eq(s1 % 8, 2);              // idle, enabled, not refused
        let (p1, r4) = board.read(rf, st, 46);
        test.assert_eq(p1, 5);
        // 5 microsteps toward the sample lowered the distance by 5 x 198.4375 pm
        test.assert(fl[11] > 9007.0);
        test.assert(fl[11] < 9008.5);
        board.write(rf, st, 43, 4294967293);   // -3
        board.advance(rf, st, fl, 100);
        let (p2, r5) = board.read(rf, st, 46);
        test.assert_eq(p2, 2);
        // longer than the maximum: refused
        board.write(rf, st, 43, 20);
        let (s2, r6) = board.read(rf, st, 45);
        test.assert_eq(s2 / 4 % 2, 1);
        let (p3, r7) = board.read(rf, st, 46);
        test.assert_eq(p3, 2);
        // disabling aborts a move in progress
        board.write(rf, st, 44, 4000);
        board.write(rf, st, 43, 8);
        board.advance(rf, st, fl, 20);          // about 2,000 clocks: not even one step
        board.advance(rf, st, fl, 60);          // 6,180 clocks in all: one step
        board.write(rf, st, 1, 0);
        let (s3, r8) = board.read(rf, st, 45);
        test.assert_eq(s3 % 2, 0);
        let (p4, r9) = board.read(rf, st, 46);
        test.assert(p4 >= 3);
        test.assert(p4 < 10);
    }
    return 0;
}

// The Z scanner (docs/high-speed.md, H2). A step of the commanded Z (manual mode, 0 to 1600 pm) at 262 kS/s: a scanner with a resonance 100 times under the sample rate
// and a high Q rings (overshoots by more than half the step); a critically damped one does not; an amplifier slew limit bounds the speed; an ideal one follows at once.
fn step_peak(f_res: float, q: float, slew: float, n: int) -> [] float {
    var peak = 0.0;
    region r {
        let rf = alloc_slice[r](64, 0);
        let st = alloc_slice[r](32, 0);
        let fl = alloc_slice[r](48, 0.0);
        board.reset(rf, st, fl);
        board.set_scanner(fl, f_res, q, slew);
        board.write(rf, st, 28, 0);
        board.write(rf, st, 1, 25);       // run + manual + adc
        board.advance(rf, st, fl, 4);
        board.write(rf, st, 28, 100);     // 1600 pm
        var k = 0;
        while k < n {
            board.advance(rf, st, fl, 1);
            let z = board.z_actual(rf, st, fl);
            if z > peak { peak = z; }
            k = k + 1;
        }
    }
    return peak;
}

fn above(a: float, b: float) -> [] int { if a > b { return 1; } return 0; }
fn below(a: float, b: float) -> [] int { if a < b { return 1; } return 0; }

fn test_a_high_q_scanner_rings() -> [] int {
    test.assert_eq(above(step_peak(2600.0, 10.0, 0.0, 400), 2400.0), 1);
    return 0;
}

fn test_a_critically_damped_scanner_does_not_ring() -> [] int {
    let peak = step_peak(2600.0, 0.5, 0.0, 400);
    test.assert_eq(below(peak, 1610.0), 1);
    test.assert_eq(above(peak, 1500.0), 1);
    return 0;
}

fn test_the_amplifier_slew_limit_bounds_the_speed() -> [] int {
    // 5 pm/us over 10 conversions of 3.8 us is at most 190 pm; an ideal scanner is at 1600 at once
    test.assert_eq(below(step_peak(2600.0, 0.5, 5.0, 10), 200.0), 1);
    test.assert_eq(above(step_peak(0.0, 0.0, 0.0, 10), 1599.0), 1);
    return 0;
}

// CTRL bit 7 (the parallel ADC): a sample every 2 x HALF clocks instead of SAMPLE_DIV, and ADC_RUN counts them (nsamp, register 40) at that rate.
fn test_the_parallel_adc_sets_the_sample_rate_by_half() -> [] int {
    region r {
        let rf = alloc_slice[r](64, 0);
        let st = alloc_slice[r](32, 0);
        let fl = alloc_slice[r](48, 0.0);
        board.reset(rf, st, fl);
        test.assert_eq(board.sample_clocks(rf), 103);
        test.assert_eq(board.write(rf, st, 6, 3), 0);
        test.assert_eq(board.write(rf, st, 1, 128), 0);
        test.assert_eq(board.sample_clocks(rf), 6);
        test.assert_eq(board.write(rf, st, 6, 0), 0);
        test.assert_eq(board.sample_clocks(rf), 2);   // HALF 0 behaves as 1, like the Verilog
        test.assert_eq(board.write(rf, st, 6, 3), 0);
        test.assert_eq(board.write(rf, st, 1, 144), 0);   // ADC_RUN + ADC_PAR
        board.advance_clocks(rf, st, fl, 600);
        let (n, r1) = board.read(rf, st, 40);
        test.assert_eq(n, 100);
        // the same clocks with the Pmod AD1 (SAMPLE_DIV 103): 5 samples
        test.assert_eq(board.write(rf, st, 1, 0), 0);
        test.assert_eq(board.write(rf, st, 1, 16), 0);
        board.advance_clocks(rf, st, fl, 600);
        let (m, r2) = board.read(rf, st, 40);
        test.assert_eq(m, 5);
    }
    return 0;
}

// The dynamic sample (sim/board.cho `dynamic`; docs/high-speed.md): A moves along x at 700 codes/s and bounces, B circles, C is fixed, D grows over 6 s. Heights in units of a 1,000 pm step.
fn test_the_dynamic_sample_moves() -> [] int {
    // A starts at x 1,500 (4,000 pm high); 2 s later it is at 2,900, and the old place is empty
    test.assert(close_f(board.dynamic_at(1500.0, 2000.0, 1000.0, 0.0), 4000.0, 1.0) == 1);
    test.assert(close_f(board.dynamic_at(1500.0, 2000.0, 1000.0, 2.0), 0.0, 1.0) == 1);
    test.assert(close_f(board.dynamic_at(2900.0, 2000.0, 1000.0, 2.0), 4000.0, 1.0) == 1);
    // it bounces: at 10 s it is back at 1,500 (a round trip of 10,000 codes)
    test.assert(close_f(board.dynamic_at(1500.0, 2000.0, 1000.0, 10.0 / 0.7), 4000.0, 1.0) == 1);
    // C does not move
    test.assert(close_f(board.dynamic_at(2200.0, 5300.0, 1000.0, 0.0), 4000.0, 1.0) == 1);
    test.assert(close_f(board.dynamic_at(2200.0, 5300.0, 1000.0, 9.0), 4000.0, 1.0) == 1);
    // D grows: nothing at t = 0, half at 3 s, full from 6 s on
    test.assert(close_f(board.dynamic_at(5600.0, 5600.0, 1000.0, 0.0), 0.0, 1.0) == 1);
    test.assert(close_f(board.dynamic_at(5600.0, 5600.0, 1000.0, 3.0), 2000.0, 1.0) == 1);
    test.assert(close_f(board.dynamic_at(5600.0, 5600.0, 1000.0, 8.0), 4000.0, 1.0) == 1);
    // B is on its circle: at t = 0 at (4,000 + 1,300, 4,500), a quarter turn (1 s) later at (4,000, 4,500 + 1,300)
    test.assert(close_f(board.dynamic_at(5300.0, 4500.0, 1000.0, 0.0), 4000.0, 1.0) == 1);
    test.assert(close_f(board.dynamic_at(4000.0, 5800.0, 1000.0, 1.0), 4000.0, 1.0) == 1);
    return 0;
}

fn close_f(got: float, want: float, tol: float) -> [] int {
    var d = got - want;
    if d < 0.0 { d = 0.0 - d; }
    if d <= tol { return 1; }
    return 0;
}

// Diffusing particles (docs/dynamics.md, D1): with a negligible D the three particles stay where the static sample has them; with D = 1 um^2/s they are far away 2 s later; the same D
// and time always give the same positions (the walk is stateless). 64 floats: the diffusion cache lives in fl[48] to fl[54].
fn test_diffusing_particles_move_by_the_coefficient() -> [] int {
    region r {
        let rf = alloc_slice[r](64, 0);
        let st = alloc_slice[r](32, 0);
        let fl = alloc_slice[r](64, 0.0);
        board.reset(rf, st, fl);
        board.set_plant(fl, 500000.0, 3.0, 2000.0, 2000.0, 100.0, 1200.0, 2.0);
        fl[10] = 1000.0;
        board.set_diffusion(rf, fl, 0.000000001, 0.0);
        test.assert(close_f(fl[48], 2200.0, 1.0) == 1);
        test.assert(close_f(fl[49], 2300.0, 1.0) == 1);
        test.assert(close_f(fl[52], 3300.0, 1.0) == 1);
        // 1e-9 um^2/s for 2 s: a displacement of about 0.09 nm (6 codes) at most
        board.set_diffusion(rf, fl, 0.000000001, 2.0);
        test.assert(close_f(fl[48], 2200.0, 20.0) == 1);
        // D = 1 um^2/s: rms 2D displacement in 2 s is 2.8 um (180,000 codes): far from the start
        board.set_diffusion(rf, fl, 1.0, 2.0);
        let x1 = fl[48];
        test.assert(close_f(x1, 2200.0, 5000.0) == 0);
        // the same call again gives the same place
        board.set_diffusion(rf, fl, 1.0, 2.0);
        test.assert(close_f(fl[48], x1, 0.0001) == 1);
        // and the surface follows: a negligible D at t = 0 has the particle's top under its start; D = 1 at t = 2 s has nothing there
        board.set_diffusion(rf, fl, 0.000000001, 0.0);
        st[19] = 2200; st[20] = 2300;
        test.assert(board.surface_at(rf, st, fl) > 3500.0);
        board.set_diffusion(rf, fl, 1.0, 2.0);
        test.assert(board.surface_at(rf, st, fl) < 500.0);
    }
    return 0;
}
