import std.test;
import plant;
import tune;

// A sweep of `n` points from `f_start` in steps of `step`, of a resonator f0 / q / a0 measured with figure gain k and a deterministic
// error of +-`nz` counts, into the slices.
fn sweep[&a, &b](f: &!a [float], r: &!b [float], n: int, f_start: float, step: float, f0: float, q: float, a0: float, k: float, nz: int) -> [] int {
    var i = 0;
    while i < n {
        let fi = f_start + float_of(i) * step;
        f[i] = fi;
        let noise = ((i * 1103515245 + 12345) / 65536) % (2 * nz + 1) - nz;
        r[i] = float_of(truncate(k * plant.response(fi, f0, q, a0) + 0.5) + noise);
        i = i + 1;
    }
    return 0;
}

fn close(got: float, want: float, tol: float) -> [] int {
    var d = got - want;
    if d < 0.0 { d = 0.0 - d; }
    if d <= tol { return 1; }
    return 0;
}

// a 32,768 Hz fork, Q 5,000 (width 6.5 Hz), swept +-50 Hz in 1 Hz steps, 2 nm amplitude, 16 counts per pm
fn test_it_finds_the_resonance_and_its_q() -> [] int {
    region r {
        let f = alloc_slice[r](101, 0.0);
        let d = alloc_slice[r](101, 0.0);
        sweep(f, d, 101, 32718.0, 1.0, 32768.0, 5000.0, 2000.0, 16.0, 0);
        let t = tune.analyse(f, d, 101);
        test.assert_eq(t.ok, 1);
        test.assert(close(t.f0, 32768.0, 0.1) == 1);
        test.assert(close(t.q, 5000.0, 150.0) == 1);
    }
    return 0;
}

fn test_it_finds_it_off_centre_and_with_noise() -> [] int {
    region r {
        let f = alloc_slice[r](101, 0.0);
        let d = alloc_slice[r](101, 0.0);
        // resonance 21.3 Hz above the sweep's centre, +-300 counts of noise on a 32,000-count peak
        sweep(f, d, 101, 32718.0, 1.0, 32789.3, 5000.0, 2000.0, 16.0, 300);
        let t = tune.analyse(f, d, 101);
        test.assert_eq(t.ok, 1);
        test.assert(close(t.f0, 32789.3, 0.5) == 1);
        test.assert(close(t.q, 5000.0, 400.0) == 1);
    }
    return 0;
}

fn test_it_refuses_with_a_reason() -> [] int {
    region r {
        let f = alloc_slice[r](101, 0.0);
        let d = alloc_slice[r](101, 0.0);
        // the peak is outside the sweep: the maximum is at an edge
        sweep(f, d, 101, 32718.0, 1.0, 32900.0, 5000.0, 2000.0, 16.0, 0);
        test.assert_eq(tune.analyse(f, d, 101).why, 1);
        // no resonance in range: a Q so low the response is flat; it is refused (the flat top's maximum lands at an edge, reason 1)
        sweep(f, d, 101, 32718.0, 1.0, 32768.0, 0.5, 2000.0, 16.0, 0);
        test.assert_eq(tune.analyse(f, d, 101).ok, 0);
        // a sweep of +-2 Hz around a 6.5 Hz-wide peak: no contrast against the floor (reason 2; reason 3, a sweep that does not
        // bracket the half-power points, needs more contrast than a Lorentzian can give without bracketing them, so it is defensive)
        sweep(f, d, 101, 32766.0, 0.04, 32768.0, 5000.0, 2000.0, 16.0, 0);
        let narrow = tune.analyse(f, d, 101);
        test.assert_eq(narrow.ok, 0);
        test.assert(narrow.why == 2 || narrow.why == 3);
    }
    return 0;
}

// the rule: a fork (slow, tau 49 ms) with a 1 ms window needs a big shift; a 300 kHz cantilever of Q 400 with a 30 us window a smaller one.
// Either way kp has resolution and the loop gain that results is within 12% of the target alpha / 2.
fn test_the_gain_rule_follows_the_plant_speed() -> [] int {
    let fork = tune.T { ok: 1, why: 0, f0: 32768.0, q: 5000.0, peak: 32000.0 };
    let g1 = tune.choose(fork, 16.0, 0.001, 0.8);
    test.assert(g1.alpha > 0.015);
    test.assert(g1.alpha < 0.025);
    test.assert_eq(g1.shift, 6);
    test.assert_eq(g1.setpoint, 400);
    test.assert(g1.kp >= 2048);
    test.assert(close(g1.gloop, g1.alpha / 2.0, g1.alpha / 2.0 * 0.12) == 1);
    let cant = tune.T { ok: 1, why: 0, f0: 300000.0, q: 400.0, peak: 32000.0 };
    let g2 = tune.choose(cant, 16.0, 0.00003, 0.8);
    test.assert(g2.shift < g1.shift);
    test.assert(g2.gloop > g1.gloop);
    test.assert(close(g2.gloop, g2.alpha / 2.0, g2.alpha / 2.0 * 0.12) == 1);
    // Q16 gains leave room for a real, slow integral term: Ti = kp / ki is about 8 / alpha samples (here about 390 for the fork), and ki is not 0
    test.assert(g1.ki >= 1);
    test.assert(close(float_of(g1.kp) / float_of(g1.ki), 8.0 / g1.alpha, 8.0 / g1.alpha * 0.15) == 1);
    test.assert(g2.ki >= 1);
    test.assert(g2.ki * 8 <= g2.kp);
    return 0;
}
