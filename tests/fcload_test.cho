import std.test;
import std.math;
import forcecurve;
import dfs;
import bilayer;
import fcload;

// docs/dynamics.md: the loader of two-column force-curve text. Not a test on any real file: the text is written here, from twin curves.

fn near(got: float, want: float, tol: float) -> [] int {
    var d = got - want;
    if d < 0.0 { d = 0.0 - d; }
    if d <= tol { return 1; }
    return 0;
}

// write v with 4 decimals into out at `at`; returns the new position
fn put_float[&a](out: &!a [byte], at: int, v: float) -> [] int {
    var p = at;
    var x = v;
    if x < 0.0 { out[p] = byte_of(45); p = p + 1; x = 0.0 - x; }
    let c = truncate(x * 10000.0 + 0.5);
    let whole = c / 10000;
    var rest = c % 10000;
    // whole part
    var digits = 1;
    var t = whole;
    while t >= 10 { t = t / 10; digits = digits + 1; }
    var k = digits - 1;
    var w = whole;
    while k >= 0 {
        var pw = 1;
        var q = 0;
        while q < k { pw = pw * 10; q = q + 1; }
        out[p] = byte_of(48 + (w / pw) % 10);
        p = p + 1;
        k = k - 1;
    }
    out[p] = byte_of(46);
    p = p + 1;
    var div = 1000;
    while div > 0 {
        out[p] = byte_of(48 + (rest / div) % 10);
        p = p + 1;
        rest = rest % div;
        div = div / 10;
    }
    return p;
}

fn put_text[&a, &b](out: &!a [byte], at: int, s: &b [byte]) -> [] int {
    var p = at;
    var i = 0;
    while i < len(s) { out[p] = s[i]; p = p + 1; i = i + 1; }
    return p;
}

fn test_numbers_are_read_whole_or_refused() -> [] int {
    let a = fcload.parse_number("12.5e-3,", 0, 8);
    test.assert_eq(a.ok, 1);
    test.assert(near(a.v, 0.0125, 0.0000001) == 1);
    let b = fcload.parse_number("-3.25", 0, 5);
    test.assert_eq(b.ok, 1);
    test.assert(near(b.v, 0.0 - 3.25, 0.0000001) == 1);
    let c = fcload.parse_number("z_nm", 0, 4);
    test.assert_eq(c.ok, 0);
    let d = fcload.parse_number("1.5x", 0, 4);
    test.assert_eq(d.ok, 0);
    let e = fcload.parse_number("2e", 0, 2);
    test.assert_eq(e.ok, 0);
    return 0;
}

fn test_headers_blank_lines_and_every_delimiter_are_handled() -> [] int {
    let text = "Z (nm); Deflection (nm)\nnm;nm\n\n1.0;2.0\n3,4\n5\t6\n7 8 9\nbad,line\n";
    test.assert_eq(fcload.count_rows(text), 4);
    region r {
        let z = alloc_slice[r](8, 0.0);
        let d = alloc_slice[r](8, 0.0);
        let n = fcload.read_rows(text, 1, 1.0, 1.0, z, d, 8);
        test.assert_eq(n, 4);
        test.assert(near(z[2], 5.0, 0.0000001) == 1);
        test.assert(near(d[3], 8.0, 0.0000001) == 1);
        // metres to nm, and every second row
        let m = fcload.read_rows(text, 2, 1000000000.0, 1000000000.0, z, d, 8);
        test.assert_eq(m, 2);
        test.assert(near(z[1], 5000000000.0, 1.0) == 1);
    }
    return 0;
}

// a twin curve written as text (z rising as it pushes, a retract after it, a header line), read back and analysed, gives the breakthrough the generator recorded
fn test_a_written_curve_round_trips_through_the_loader() -> [] int {
    region r {
        let z = alloc_slice[r](720, 0.0);
        let d = alloc_slice[r](720, 0.0);
        let gs = alloc_slice[r](8, 0.0);
        let s = bilayer.sample_of(0, 0);
        let l = bilayer.lever_khadka();
        let n = bilayer.generate(s, l, 3, z, d, gs, 720);
        test.assert(gs[2] > 0.5);
        let out = alloc_slice[r](26000, byte_of(0));
        var p = put_text(out, 0, "Z (nm),Deflection (nm)\n");
        var i = 0;
        while i < n {
            // z rising as it pushes: 200 - z, in nm
            p = put_float(out, p, 200.0 - z[i]);
            out[p] = byte_of(44);
            p = p + 1;
            p = put_float(out, p, d[i]);
            out[p] = byte_of(10);
            p = p + 1;
            i = i + 1;
        }
        // a retract: the last 40 points backwards
        i = 0;
        while i < 40 {
            p = put_float(out, p, 200.0 - z[n - 1 - i]);
            out[p] = byte_of(44);
            p = p + 1;
            p = put_float(out, p, d[n - 1 - i]);
            out[p] = byte_of(10);
            p = p + 1;
            i = i + 1;
        }
        let text = alloc_slice[r](p, byte_of(0));
        var q = 0;
        while q < p { text[q] = out[q]; q = q + 1; }
        test.assert_eq(fcload.count_rows(text), n + 40);
        let zz = alloc_slice[r](900, 0.0);
        let dd = alloc_slice[r](900, 0.0);
        let rows = fcload.read_rows(text, 1, 1.0, 1.0, zz, dd, 900);
        test.assert_eq(rows, n + 40);
        let na = fcload.approach(zz, dd, rows);
        // the retract is cut: the approach is the n points up to the turn-around (the last pushed point is the largest z)
        test.assert_eq(na, n);
        let a = fcload.analyse(zz, dd, na, l.k, l.r);
        test.assert_eq(a.why, 0);
        test.assert(near(a.breakthrough, gs[6], 0.001 * gs[6]) == 1);
    }
    return 0;
}

fn test_a_short_file_is_refused_with_a_tag() -> [] int {
    region r {
        let z = alloc_slice[r](10, 0.0);
        let d = alloc_slice[r](10, 0.0);
        let a = fcload.analyse(z, d, 10, 0.35, 32.0);
        test.assert_eq(a.why, 9);
    }
    return 0;
}

// the bootstrap of the summaries against the closed forms: the variance of a mean of n values is their sample variance over n, and the variance of a share p over n curves is p (1 - p) / n; 100 curves, 400
// resamples, each within 25%
fn test_the_bootstrap_spread_matches_the_closed_forms() -> [] int {
    region r {
        let per = alloc_slice[r](600, 0.0);
        let out = alloc_slice[r](8, 0.0);
        var sum = 0.0;
        var sum2 = 0.0;
        var ok = 0;
        var i = 0;
        while i < 100 {
            var u = math.sin(12.9898 * float_of(i) + 4.1414) * 43758.5453;
            if u < 0.0 { u = 0.0 - u; }
            u = u - math.floor(u);
            // one curve in five is not analysed
            var good = 1.0;
            if i % 5 == 0 { good = 0.0; }
            per[i * 6] = good;
            per[i * 6 + 1] = 10.0 * u;
            per[i * 6 + 2] = 5.0;
            per[i * 6 + 3] = 5.0;
            per[i * 6 + 4] = 5.0;
            per[i * 6 + 5] = 5.0;
            if good > 0.5 { sum = sum + 10.0 * u; sum2 = sum2 + 100.0 * u * u; ok = ok + 1; }
            i = i + 1;
        }
        let used = fcload.bootstrap(per, 100, 400, 7, out);
        test.assert(used > 390);
        let f = float_of(ok);
        let mean = sum / f;
        let sample_var = (sum2 / f - mean * mean) * f / (f - 1.0);
        // the mean of the analysed curves of a resample is over a random number of them (about 80): close to the sample variance over 80
        test.assert(near(out[0], sample_var / 80.0, 0.25 * sample_var / 80.0) == 1);
        // a column that does not vary has no spread
        test.assert(out[1] < 0.0000001);
        // the share: p (1 - p) / n with p = 0.8, n = 100
        test.assert(near(out[6], 0.8 * 0.2 / 100.0, 0.25 * 0.0016) == 1);
    }
    return 0;
}

// ---- dense curves: nothing thinned ----

fn dense_lever() -> [] bilayer.Lever {
    let base = bilayer.lever_khadka();
    // 20 times the rows: 0.01 nm a row instead of 0.2
    return bilayer.Lever { k: base.k, r: base.r, v: 200.0, dt: 0.01 / 200.0, sigma: 0.02, f_cap: base.f_cap, z0: base.z0, zc: base.zc };
}

// a dense twin curve (20 times the usual rows) is read whole, and gives the breakthrough the generator recorded and a modulus within 5% of the same curve read at the usual spacing
fn test_a_dense_curve_is_read_whole_and_agrees_with_the_coarse_one[&h](heap: &!h Heap) -> [heap] int {
    let cap = 20000;
    let zb = box_slice(heap, cap, 0.0);
    let db = box_slice(heap, cap, 0.0);
    let gsb = box_slice(heap, 8, 0.0);
    let tb = box_slice(heap, cap * 24, byte_of(0));
    var rows = 0;
    var truth = 0.0;
    var kept = 0;
    var why = 9;
    var bt = 0.0;
    var e_dense = 0.0;
    var e_thin = 0.0;
    var thin_kept = 0;
    borrow mut zb as &!zw in { borrow mut db as &!dw in { borrow mut gsb as &!gw in { borrow mut tb as &!tw in {
        let z = contents(zw);
        let d = contents(dw);
        let gs = contents(gw);
        let text = contents(tw);
        let s = bilayer.sample_of(0, 0);
        let l = dense_lever();
        rows = bilayer.generate(s, l, 3, z, d, gs, cap);
        truth = gs[6];
        var p = put_text(text, 0, "Z (nm),Deflection (nm)\n");
        var i = 0;
        while i < rows {
            p = put_float(text, p, 200.0 - z[i]);
            text[p] = byte_of(44);
            p = p + 1;
            p = put_float(text, p, d[i]);
            text[p] = byte_of(10);
            p = p + 1;
            i = i + 1;
        }
        let whole = text[0..p];
        let ld = fcload.load_and_analyse(heap, whole, 1, 1.0, 1.0, l.k, l.r);
        kept = ld.kept;
        why = ld.a.why;
        bt = ld.a.breakthrough;
        e_dense = ld.a.e0;
        let lt = fcload.load_and_analyse(heap, whole, 20, 1.0, 1.0, l.k, l.r);
        thin_kept = lt.kept;
        e_thin = lt.a.e0;
    } } } }
    unbox_slice(heap, tb);
    unbox_slice(heap, gsb);
    unbox_slice(heap, db);
    unbox_slice(heap, zb);
    test.assert(rows > 4000);
    test.assert_eq(kept, rows);
    test.assert_eq(why, 0);
    test.assert(near(bt, truth, 0.002 * truth) == 1);
    test.assert(thin_kept < rows / 19);
    // the modulus of the dense curve against the thinned one: within 5%
    test.assert(near(e_dense, e_thin, 0.05 * e_thin) == 1);
    return 0;
}

// THE CATCH OF NOT THINNING. The breakthrough is the largest SINGLE-STEP force drop of at least 400 pN (nanoindent's rule). A real detector has a finite bandwidth, so a rupture is spread over several rows,
// and at a dense spacing no one row drops by 400 pN. The twin's rupture is instantaneous at any spacing, so to show it the deflection is smoothed here by a 20-row boxcar (a detector bandwidth of 20 rows):
// read whole, the curve is refused with tag 4 (no breakthrough); thinned to every 20th row it is analysed and gives the breakthrough within 20% of the generator's.
fn test_a_bandwidth_limited_dense_curve_needs_thinning_for_the_single_step_rule[&h](heap: &!h Heap) -> [heap] int {
    let cap = 20000;
    let zb = box_slice(heap, cap, 0.0);
    let db = box_slice(heap, cap, 0.0);
    let sb = box_slice(heap, cap, 0.0);
    let gsb = box_slice(heap, 8, 0.0);
    let tb = box_slice(heap, cap * 24, byte_of(0));
    var rows = 0;
    var truth = 0.0;
    var why_whole = 0;
    var why_thin = 9;
    var bt_thin = 0.0;
    borrow mut zb as &!zw in { borrow mut db as &!dw in { borrow mut sb as &!sw in { borrow mut gsb as &!gw in { borrow mut tb as &!tw in {
        let z = contents(zw);
        let d = contents(dw);
        let sm = contents(sw);
        let gs = contents(gw);
        let text = contents(tw);
        let s = bilayer.sample_of(0, 0);
        let l = dense_lever();
        rows = bilayer.generate(s, l, 3, z, d, gs, cap);
        truth = gs[6];
        // causal boxcar of 20 rows
        var i = 0;
        while i < rows {
            var sum = 0.0;
            var c = 0;
            var j = i;
            while j >= 0 && c < 20 { sum = sum + d[j]; c = c + 1; j = j - 1; }
            sm[i] = sum / float_of(c);
            i = i + 1;
        }
        var p = put_text(text, 0, "Z (nm),Deflection (nm)\n");
        i = 0;
        while i < rows {
            p = put_float(text, p, 200.0 - z[i]);
            text[p] = byte_of(44);
            p = p + 1;
            p = put_float(text, p, sm[i]);
            text[p] = byte_of(10);
            p = p + 1;
            i = i + 1;
        }
        let whole = text[0..p];
        let a = fcload.load_and_analyse(heap, whole, 1, 1.0, 1.0, l.k, l.r);
        why_whole = a.a.why;
        let b = fcload.load_and_analyse(heap, whole, 20, 1.0, 1.0, l.k, l.r);
        why_thin = b.a.why;
        bt_thin = b.a.breakthrough;
    } } } } }
    unbox_slice(heap, tb);
    unbox_slice(heap, gsb);
    unbox_slice(heap, sb);
    unbox_slice(heap, db);
    unbox_slice(heap, zb);
    test.assert_eq(why_whole, 4);
    test.assert_eq(why_thin, 0);
    test.assert(near(bt_thin, truth, 0.2 * truth) == 1);
    return 0;
}
