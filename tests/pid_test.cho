import std.test;
import pid;
import loop;

fn test_the_output_never_leaves_the_hardware_limit() -> [] int {
    var s = pid.start(5000);
    var t = 0;
    while t < 200 {
        s = pid.step(s, 20000, 60000, 16384, 0, 100000, 0, 30000);
        test.assert(s.z >= 0);
        test.assert(s.z <= 30000);
        t = t + 1;
    }
    return 0;
}

fn test_the_integral_does_not_wind_up() -> [] int {
    var s = pid.start(0);
    var t = 0;
    while t < 1000 {
        s = pid.step(s, 5000, 0, 2048, 0, 1000, 0 - 100000, 100000);
        t = t + 1;
    }
    test.assert_eq(s.integ, 1000);
    return 0;
}

fn test_pi_settles_on_a_flat_surface() -> [] int {
    var s = pid.start(40000);
    var t = 0;
    while t < 400 {
        let a = loop.amplitude(s.z);
        s = pid.step(s, a - loop.setpoint(), 32768, 4096, 0, 200000, 0, 60000);
        t = t + 1;
    }
    var e = loop.amplitude(s.z) - loop.setpoint();
    if e < 0 {
        e = 0 - e;
    }
    test.assert(e <= 10);
    return 0;
}
