edition 7;

import std.buffer;
import std.math;
import nucleation;
import vesicles;
import adequacy;
import forcecurve;
import dfs;
import bilayer;
import fcmodels;

// Force curves: how model identification blurs as an experiment shrinks to fewer curves (docs/dynamics.md). Each of the six models is predicted from a reference of 24 experiments of n curves; for each n (1, 2, 4,
// 8, 16) six new experiments of n curves are made under each model, each is compared with the six references (adequacy.compare2, one experiment against 24), and the smallest discrepancy names the model.
// A prediction of this software; stand-in models, one family.
//   cancho run host/fc_blur.cho sim/fcmodels.cho sim/adequacy.cho sim/vesicles.cho sim/nucleation.cho sim/bilayer.cho sim/forcecurve.cho sim/dfs.cho --std
fn text[&h, &r](heap: &!h Heap, b: buffer.Buffer, s: &r [byte]) -> [heap] buffer.Buffer { return buffer.append(heap, b, s); }

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi); release(fs); release(net); release(clock); release(signals); release(exec); release(args);
    borrow mut heap as &!h in {
        var o = buffer.empty(h, 16384);
        region r {
            let nm = fcmodels.n_models();
            let pm = alloc_slice[r](nm * 8, 0.0);
            let pv = alloc_slice[r](nm * 8, 0.0);
            let am = alloc_slice[r](8, 0.0);
            let av = alloc_slice[r](8, 0.0);
            let bm = alloc_slice[r](8, 0.0);
            let bv = alloc_slice[r](8, 0.0);
            let z = alloc_slice[r](8, 0.0);
            let conf = alloc_slice[r](nm * nm, 0);
            o = text(h, o, "curves per experiment | experiments | named correctly | true model kept (d < 3) | wrong models rejected (d > 3, of 5 each)\n");
            var ns = 0;
            var seed0 = 5001;
            while ns < 5 {
                var n = 1;
                if ns == 1 { n = 2; }
                if ns == 2 { n = 4; }
                if ns == 3 { n = 8; }
                if ns == 4 { n = 16; }
                var i = 0;
                while i < nm {
                    fcmodels.ensemble(i, n, 24, 1001, am, av);
                    var t = 0;
                    while t < 8 { pm[i * 8 + t] = am[t]; pv[i * 8 + t] = av[t]; t = t + 1; }
                    i = i + 1;
                }
                var cell = 0;
                while cell < nm * nm { conf[cell] = 0; cell = cell + 1; }
                var right = 0;
                var kept = 0;
                var rejected = 0;
                var total = 0;
                i = 0;
                while i < nm {
                    var rep = 0;
                    while rep < 6 {
                        fcmodels.summary(i, n, seed0, am);
                        seed0 = seed0 + 1;
                        var t0 = 0;
                        while t0 < 8 { av[t0] = 0.0; t0 = t0 + 1; }
                        var best = 0;
                        var bestd = 1000000.0;
                        var j = 0;
                        while j < nm {
                            var t = 0;
                            while t < 8 { bm[t] = pm[j * 8 + t]; bv[t] = pv[j * 8 + t]; t = t + 1; }
                            let d = adequacy.compare2(am, av, 1, bm, bv, 24, z);
                            if d < bestd { bestd = d; best = j; }
                            if j == i { if d < 3.0 { kept = kept + 1; } } else { if d > 3.0 { rejected = rejected + 1; } }
                            j = j + 1;
                        }
                        conf[i * nm + best] = conf[i * nm + best] + 1;
                        if best == i { right = right + 1; }
                        total = total + 1;
                        rep = rep + 1;
                    }
                    i = i + 1;
                }
                o = buffer.push_nat(h, o, n);
                o = text(h, o, " | ");
                o = buffer.push_nat(h, o, total);
                o = text(h, o, " | ");
                o = buffer.push_nat(h, o, right);
                o = text(h, o, " | ");
                o = buffer.push_nat(h, o, kept);
                o = text(h, o, " of ");
                o = buffer.push_nat(h, o, total);
                o = text(h, o, " | ");
                o = buffer.push_nat(h, o, rejected);
                o = text(h, o, " of ");
                o = buffer.push_nat(h, o, total * 5);
                o = text(h, o, "\n");
                if n <= 2 {
                    o = text(h, o, "   confusion (rows: made under, columns: named):\n");
                    i = 0;
                    while i < nm {
                        o = text(h, o, "   m");
                        o = buffer.push_nat(h, o, i);
                        o = text(h, o, ":");
                        var j = 0;
                        while j < nm { o = text(h, o, " "); o = buffer.push_nat(h, o, conf[i * nm + j]); j = j + 1; }
                        o = text(h, o, "\n");
                        i = i + 1;
                    }
                }
                ns = ns + 1;
            }
        }
        var code = 0;
        borrow mut io as &!w in { borrow o as &b in { code = buffer.write(w, b); } }
        buffer.drop(h, o);
    }
    release(heap);
    release(io);
    return 0;
}
