edition 7;

import std.buffer;
import std.math;
import nucleation;
import vesicles;

// D7 slice 3 (docs/dynamics.md): the scanning tip as a cause of rupture (mechanism C: each frame the tip ruptures an adsorbed vesicle with probability p_touch). What the analysis can say about it, and how
// it contaminates the edge-share statistic. A prediction of this software; p_touch is a stand-in for the tip's force, which is not modelled.
//   cancho run host/d7_tip.cho sim/vesicles.cho sim/nucleation.cho --std
fn text[&h, &r](heap: &!h Heap, b: buffer.Buffer, s: &r [byte]) -> [heap] buffer.Buffer { return buffer.append(heap, b, s); }

fn dec[&h](heap: &!h Heap, o: buffer.Buffer, v: float, places: int) -> [heap] buffer.Buffer {
    var b = o;
    var x = v;
    if x < 0.0 { b = text(heap, b, "-"); x = 0.0 - x; }
    var scale = 1;
    var p = 0;
    while p < places { scale = scale * 10; p = p + 1; }
    let c = truncate(x * float_of(scale) + 0.5);
    b = buffer.push_nat(heap, b, c / scale);
    if places > 0 {
        b = text(heap, b, ".");
        var rest = c % scale;
        var div = scale / 10;
        while div > 0 {
            b = buffer.push_nat(heap, b, rest / div);
            rest = rest % div;
            div = div / 10;
        }
    }
    return b;
}

fn mk(gamma: int, k_e: float, tf: float, p_touch: float) -> [] vesicles.Model {
    return vesicles.Model { size: 40, r: 2.0, lam: 0.003, gamma: gamma, k_e: k_e, hp: 1.0, hv: 2.0, sigma: 0.1, tf: tf, frames: truncate(60.0 / tf), dt: 0.25, filter: 0, p_touch: p_touch };
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi); release(fs); release(net); release(clock); release(signals); release(exec); release(args);
    borrow mut heap as &!h in {
        var o = buffer.empty(h, 16384);
        // (1) and (2): the tip alone (no critical density, no edge process): true tip ruptures per touch, and against the frame time
        o = text(h, o, "-- the tip alone (mechanism C only), p_touch 0.02 per frame, 8 movies of 60 s\n");
        o = text(h, o, "frame s | tip ruptures | touches | ruptures per touch | ruptures per movie\n");
        var c = 0;
        while c < 3 {
            var tf = 0.5;
            if c == 1 { tf = 1.0; }
            if c == 2 { tf = 2.0; }
            var rc = 0;
            var touches = 0;
            var seed = 1;
            while seed <= 8 {
                let s = vesicles.study(mk(1000, 0.0, tf, 0.02), seed, 20, 4.0, 0.25);
                rc = rc + s.rc;
                touches = touches + s.touches;
                seed = seed + 1;
            }
            o = dec(h, o, tf, 1);
            o = text(h, o, " | ");
            o = buffer.push_nat(h, o, rc);
            o = text(h, o, " | ");
            o = buffer.push_nat(h, o, touches);
            o = text(h, o, " | ");
            o = dec(h, o, float_of(rc) / float_of(touches), 3);
            o = text(h, o, " | ");
            o = dec(h, o, float_of(rc) / 8.0, 1);
            o = text(h, o, "\n");
            c = c + 1;
        }
        // (3): the tip on top of critical density + edge-induced rupture: the edge-share statistic
        o = text(h, o, "-- the edge-share statistic with the tip on (critical density + edge-induced k_e 0.5, 0.5 s frames), 8 movies pooled per group, 6 groups\n");
        o = text(h, o, "p_touch | events/group | share vs chance | mean z | called (z>3)\n");
        var pi = 0;
        while pi < 5 {
            var p = 0.0;
            if pi == 1 { p = 0.005; }
            if pi == 2 { p = 0.01; }
            if pi == 3 { p = 0.03; }
            if pi == 4 { p = 0.1; }
            var zs = 0.0;
            var called = 0;
            var evs = 0.0;
            var sh = 0.0;
            var ch = 0.0;
            var j = 0;
            while j < 6 {
                var ev = 0;
                var nr = 0;
                var cs = 0.0;
                var k = 0;
                while k < 8 {
                    let s = vesicles.study(mk(3, 0.5, 0.5, p), 1 + j * 8 + k, 20, 4.0, 0.25);
                    ev = ev + s.events;
                    nr = nr + s.near;
                    cs = cs + s.chance_sum;
                    k = k + 1;
                }
                let share = float_of(nr) / float_of(ev);
                let chance = cs / float_of(ev);
                let z = (share - chance) / math.sqrt(chance * (1.0 - chance) / float_of(ev));
                zs = zs + z;
                if z > 3.0 { called = called + 1; }
                evs = evs + float_of(ev);
                sh = sh + share;
                ch = ch + chance;
                j = j + 1;
            }
            o = dec(h, o, p, 3);
            o = text(h, o, " | ");
            o = dec(h, o, evs / 6.0, 0);
            o = text(h, o, " | ");
            o = dec(h, o, sh / 6.0, 2);
            o = text(h, o, " vs ");
            o = dec(h, o, ch / 6.0, 2);
            o = text(h, o, " | ");
            o = dec(h, o, zs / 6.0, 1);
            o = text(h, o, " | ");
            o = buffer.push_nat(h, o, called);
            o = text(h, o, " of 6\n");
            pi = pi + 1;
        }
        var code = 0;
        borrow mut io as &!w in { borrow o as &b in { code = buffer.write(w, b); } }
        buffer.drop(h, o);
    }
    release(heap);
    release(io);
    return 0;
}
