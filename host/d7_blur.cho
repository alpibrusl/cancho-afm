edition 7;

import std.buffer;
import std.math;
import nucleation;
import vesicles;
import adequacy;

// D7: how the model-identification blurs as the experiment shrinks (docs/dynamics.md). The library's six models are each predicted from a reference ensemble of 24 movies (seeds 1001 to 1024). For each
// number k of movies in the "experiment" (1, 2, 3, 4, 8, 12, 24) and each model, six independent experiments of k movies are made (seeds from 2001, not reused), each is compared with the six reference
// ensembles, and the model with the smallest discrepancy is the one the experiment would name. A table of how often that is the right one, and of what it is mistaken for. A prediction of this software;
// every model is a stand-in and all are one family.
//   cancho run host/d7_blur.cho sim/adequacy.cho sim/vesicles.cho sim/nucleation.cho --std
fn text[&h, &r](heap: &!h Heap, b: buffer.Buffer, s: &r [byte]) -> [heap] buffer.Buffer { return buffer.append(heap, b, s); }

fn dec[&h](heap: &!h Heap, o: buffer.Buffer, v: float, places: int) -> [heap] buffer.Buffer {
    var b = o;
    var x = v;
    if x < 0.0 { b = text(heap, b, "-"); x = 0.0 - x; }
    var scale = 1;
    var p = 0;
    while p < places { scale = scale * 10; p = p + 1; }
    let c = truncate(x * float_of(scale) + 0.5);
    b = buffer.push_nat(heap, b, c / scale);
    if places > 0 {
        b = text(heap, b, ".");
        var rest = c % scale;
        var div = scale / 10;
        while div > 0 {
            b = buffer.push_nat(heap, b, rest / div);
            rest = rest % div;
            div = div / 10;
        }
    }
    return b;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi); release(fs); release(net); release(clock); release(signals); release(exec); release(args);
    borrow mut heap as &!h in {
        var o = buffer.empty(h, 32768);
        region r {
            let nm = adequacy.n_models();
            let pm = alloc_slice[r](nm * 8, 0.0);
            let pv = alloc_slice[r](nm * 8, 0.0);
            let am = alloc_slice[r](8, 0.0);
            let av = alloc_slice[r](8, 0.0);
            let bm = alloc_slice[r](8, 0.0);
            let bv = alloc_slice[r](8, 0.0);
            let z = alloc_slice[r](8, 0.0);
            let conf = alloc_slice[r](nm * nm, 0);
            let ev2 = alloc_slice[r](8, 0.0);
            var i = 0;
            while i < nm {
                adequacy.ensemble(i, 24, 1001, am, av);
                var t = 0;
                while t < 8 { pm[i * 8 + t] = am[t]; pv[i * 8 + t] = av[t]; t = t + 1; }
                i = i + 1;
            }
            o = text(h, o, "k movies | experiments | named correctly | true model kept (d < 3) | wrong models rejected (d > 3, of 5 each) | mean d to the true model | mean smallest wrong\n");
            var ks = 0;
            var seed0 = 2001;
            while ks < 7 {
                var k = 1;
                if ks == 1 { k = 2; }
                if ks == 2 { k = 3; }
                if ks == 3 { k = 4; }
                if ks == 4 { k = 8; }
                if ks == 5 { k = 12; }
                if ks == 6 { k = 24; }
                var kept = 0;
                var rejected = 0;
                var kept2 = 0;
                var rejected2 = 0;
                var right2 = 0;
                var cell = 0;
                while cell < nm * nm { conf[cell] = 0; cell = cell + 1; }
                var right = 0;
                var total = 0;
                var d_true = 0.0;
                var d_wrong = 0.0;
                i = 0;
                while i < nm {
                    var rep = 0;
                    while rep < 6 {
                        adequacy.ensemble(i, k, seed0, am, av);
                        seed0 = seed0 + k;
                        var best = 0;
                        var best2 = 0;
                        var bestd2 = 1000000.0;
                        var bestd = 1000000.0;
                        var wrongmin = 1000000.0;
                        var j = 0;
                        while j < nm {
                            var t = 0;
                            while t < 8 { bm[t] = pm[j * 8 + t]; bv[t] = pv[j * 8 + t]; t = t + 1; }
                            let d = adequacy.compare2(am, av, k, bm, bv, 24, z);
                            // the same with the TWIN's spread for the experiment too (its own variance, not estimated from k movies)
                            let d2 = adequacy.compare2(am, bv, k, bm, bv, 24, ev2);
                            if d2 < bestd2 { bestd2 = d2; best2 = j; }
                            if j == i { if d2 < 3.0 { kept2 = kept2 + 1; } } else { if d2 > 3.0 { rejected2 = rejected2 + 1; } }
                            if d < bestd { bestd = d; best = j; }
                            if j == i { d_true = d_true + d; if d < 3.0 { kept = kept + 1; } } else { if d < wrongmin { wrongmin = d; } if d > 3.0 { rejected = rejected + 1; } }
                            j = j + 1;
                        }
                        d_wrong = d_wrong + wrongmin;
                        conf[i * nm + best] = conf[i * nm + best] + 1;
                        if best == i { right = right + 1; }
                        if best2 == i { right2 = right2 + 1; }
                        total = total + 1;
                        rep = rep + 1;
                    }
                    i = i + 1;
                }
                o = buffer.push_nat(h, o, k);
                o = text(h, o, " | ");
                o = buffer.push_nat(h, o, total);
                o = text(h, o, " | ");
                o = buffer.push_nat(h, o, right);
                o = text(h, o, " (");
                o = dec(h, o, 100.0 * float_of(right) / float_of(total), 0);
                o = text(h, o, "%) | ");
                o = buffer.push_nat(h, o, kept);
                o = text(h, o, " of ");
                o = buffer.push_nat(h, o, total);
                o = text(h, o, " | ");
                o = buffer.push_nat(h, o, rejected);
                o = text(h, o, " of ");
                o = buffer.push_nat(h, o, total * 5);
                o = text(h, o, " | ");
                o = dec(h, o, d_true / float_of(total), 1);
                o = text(h, o, " | ");
                o = dec(h, o, d_wrong / float_of(total), 1);
                o = text(h, o, "   with the twin's spread: named ");
                o = buffer.push_nat(h, o, right2);
                o = text(h, o, " of ");
                o = buffer.push_nat(h, o, total);
                o = text(h, o, ", true kept ");
                o = buffer.push_nat(h, o, kept2);
                o = text(h, o, ", wrong rejected ");
                o = buffer.push_nat(h, o, rejected2);
                o = text(h, o, " of ");
                o = buffer.push_nat(h, o, total * 5);
                o = text(h, o, "\n");
                if k == 1 || k == 2 {
                    o = text(h, o, "   confusion (rows: made under, columns: named), 6 experiments each:\n");
                    i = 0;
                    while i < nm {
                        o = text(h, o, "   m");
                        o = buffer.push_nat(h, o, i);
                        o = text(h, o, ":");
                        var j = 0;
                        while j < nm { o = text(h, o, " "); o = buffer.push_nat(h, o, conf[i * nm + j]); j = j + 1; }
                        o = text(h, o, "\n");
                        i = i + 1;
                    }
                }
                ks = ks + 1;
            }
        }
        var code = 0;
        borrow mut io as &!w in { borrow o as &b in { code = buffer.write(w, b); } }
        buffer.drop(h, o);
    }
    release(heap);
    release(io);
    return 0;
}
