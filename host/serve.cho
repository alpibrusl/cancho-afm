edition 8;

import std.io;
import std.buffer;
import std.http;
import proto;
import regs;
import live_json;
import http.server;

// serve.cho -- the live console's server, in cancho: one program on the Pi that READS the board over its serial port (never writes a register, after checking the identifier)
// and serves the console page and its data over HTTP, with no other process. Routes (GET only):
//   /live.json   the latest reading of the board, one object (host/live_json.cho, source "board"); `Cache-Control: no-store`
//   /  /live.html  /live.js   the console (ui/live.html, ui/live.js), read from DIR below at each request
// The board is read once per loop turn (at most every 250 ms), before the turn's requests are answered, with its own poller so that the HTTP server's poller is not disturbed.
// DIR is a literal because `narrow` takes one: change it for another checkout. Authority: `cancho authority` lists net_in, conn_*, tty_*, fs_read(DIR), poll, clock, heap.
//   cancho build host/serve.cho host/live_json.cho host/proto.cho host/regs.cho <cancho>/packages/http-server/server.cho --std -o serve
//   ./serve 8765

// One request, one answer: write `n` request bytes, collect `want` answer bytes. Returns how many arrived.
fn exchange[&q, &p, &a, &b, &c, &d](port: &!q Port, pw: &!p Poller, req: &a [byte], n: int, rsp: &!b [byte], want: int, chunk: &!c [byte], ev: &!d [int]) -> [poll, tty_read, tty_write] int {
    tty_flush_input(port);
    tty_write(port, req[0..n]);
    var got = 0;
    var tries = 0;
    while got < want && tries < 60 {
        let k = tty_read(port, chunk);
        if k > 0 {
            var i = 0;
            while i < k && got < want {
                rsp[got] = chunk[i];
                got = got + 1;
                i = i + 1;
            }
        } else {
            poller_wait(pw, ev, 20);
            tries = tries + 1;
        }
    }
    return got;
}

// read register `idx`: ans[0] = the answer code (-1 if it did not answer), ans[1] = the value
fn read_reg[&q, &p, &a, &b, &c, &d, &e](port: &!q Port, pw: &!p Poller, req: &!a [byte], rsp: &!b [byte], chunk: &!c [byte], ev: &!d [int], ans: &!e [int], idx: int) -> [poll, tty_read, tty_write] int {
    proto.read_req(req, idx);
    let got = exchange(port, pw, req, 5, rsp, 5, chunk, ev);
    if got == 5 {
        ans[0] = proto.resp_code(rsp);
        ans[1] = proto.resp_value(rsp);
    } else {
        ans[0] = 0 - 1;
        ans[1] = 0;
    }
    return ans[0];
}

// the board's seven live registers into v (CTRL, STATUS, AMP, ZOUT, XOUT, YOUT, ADC0) and a count of good snapshots in v[7]; 0 if every read answered
fn snapshot[&q, &p, &a, &b, &c, &d, &e, &f](port: &!q Port, pw: &!p Poller, req: &!a [byte], rsp: &!b [byte], chunk: &!c [byte], ev: &!d [int], ans: &!e [int], v: &!f [int]) -> [poll, tty_read, tty_write] int {
    var bad = 0;
    bad = bad + read_reg(port, pw, req, rsp, chunk, ev, ans, regs.ctrl());
    let w0 = ans[1];
    bad = bad + read_reg(port, pw, req, rsp, chunk, ev, ans, regs.status());
    let w1 = ans[1];
    bad = bad + read_reg(port, pw, req, rsp, chunk, ev, ans, regs.amp());
    let w2 = ans[1];
    bad = bad + read_reg(port, pw, req, rsp, chunk, ev, ans, regs.zout());
    let w3 = proto.signed(ans[1]);
    bad = bad + read_reg(port, pw, req, rsp, chunk, ev, ans, regs.xout());
    let w4 = ans[1];
    bad = bad + read_reg(port, pw, req, rsp, chunk, ev, ans, regs.yout());
    let w5 = ans[1];
    bad = bad + read_reg(port, pw, req, rsp, chunk, ev, ans, regs.adc0());
    let w6 = ans[1];
    if bad == 0 {
        v[0] = w0; v[1] = w1; v[2] = w2; v[3] = w3; v[4] = w4; v[5] = w5; v[6] = w6;
        v[7] = v[7] + 1;
    }
    return bad;
}

fn same[&s](a: &s [byte], b: &static [byte]) -> [] bool {
    if len(a) != len(b) { return false; }
    var i = 0;
    while i < len(a) {
        if int_of(a[i]) != int_of(b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

// one request in, one response appended to `out`. A page is not answered here: want[0] is set to 1 (live.html) or 2 (live.js) and want[1] to the keep-alive flag, and the loop reads the file.
fn handle[&h, &q, &t, &v, &w](heap: &!h Heap, request: &q [byte], table: &t [int], v: &v [int], want: &!w [int], out: buffer.Buffer) -> [heap] buffer.Buffer {
    let keep = http.keeps_alive(table);
    let path = http.path(request, table);
    let method = http.method(request, table);
    if !same(method, "GET") { return server.failure(heap, out, 405, "method not allowed", keep); }
    if same(path, "/live.json") {
        var body = live_json.line(heap, buffer.empty(heap, 256), "board", v[7], v[0], v[1], v[2], v[3], v[4], v[5], v[6]);
        var answer = out;
        borrow body as &bb in {
            answer = server.reply_with(heap, answer, 200, buffer.bytes(bb), keep, "Cache-Control: no-store\r\n");
        }
        buffer.drop(heap, body);
        return answer;
    }
    if same(path, "/") || same(path, "/live.html") {
        want[0] = 1;
        if keep { want[1] = 1; } else { want[1] = 0; }
        return out;
    }
    if same(path, "/live.js") {
        want[0] = 2;
        if keep { want[1] = 1; } else { want[1] = 0; }
        return out;
    }
    return server.failure(heap, out, 404, "not found", keep);
}

fn number_of[&t](text: &t [byte]) -> [] int {
    if len(text) == 0 || len(text) > 5 { return 0 - 1; }
    var n = 0;
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c < 48 || c > 57 { return 0 - 1; }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    return n;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi); release(signals); release(exec);
    var port = 0 - 1;
    borrow args as &g in {
        if arg_count(g) > 1 { port = number_of(arg(g, 1)); }
    }
    var status = 2;
    let device = narrow(tty, "/dev");
    let files = narrow(fs, "/srv/afm/ui");
    if port > 0 && port < 65536 {
        status = 3;
        match poller_new() {
            Polling::Failed(e) => { status = 1; }
            Polling::Ok(open) => {
                var pt = open;
                borrow device as &t in {
                    match tty_open(t, "/dev/ttyUSB1") {
                        TtyOpened::Failed(errno) => { status = 4; }
                        TtyOpened::Ok(tp) => {
                            borrow mut tp as &!q in {
                                if tty_configure(q, 115200) != 0 { status = 5; }
                                else {
                                    borrow mut pt as &!pw in { poller_add_tty(pw, q, 1, 1); }
                                    region r {
                                        let req = alloc_slice[r](16, byte_of(0));
                                        let rsp = alloc_slice[r](16, byte_of(0));
                                        let chunk = alloc_slice[r](16, byte_of(0));
                                        let ev = alloc_slice[r](2, 0);
                                        let ans = alloc_slice[r](2, 0);
                                        let v = alloc_slice[r](8, 0);
                                        let file = alloc_slice[r](49152, byte_of(0));
                                        let want = alloc_slice[r](2, 0);
                                        var code = 0;
                                        borrow mut pt as &!pw in { code = read_reg(q, pw, req, rsp, chunk, ev, ans, regs.id()); }
                                        if code != 0 || ans[1] != 0xAF500001 { status = 6; }
                                        else {
                                            status = 7;
                                            borrow net as &nn in {
                                                match tcp_listen(nn, port, 1024, 1) {
                                                    Listening::Failed(e) => { status = 8; }
                                                    Listening::Ok(l) => {
                                                        var listener = l;
                                                        borrow mut listener as &!lh in {
                                                            listener_nonblocking(lh);
                                                            borrow mut heap as &!h in {
                                                                match poller_new() {
                                                                    Polling::Failed(e) => { status = 9; }
                                                                    Polling::Ok(ps) => {
                                                                        var srv = server.open(h, ps, lh, 16384, 0, 30);
                                                                        borrow clock as &c in {
                                                                            status = 0;
                                                                            while status == 0 {
                                                                                srv = server.wait(h, srv, c, lh, 250);
                                                                                borrow mut pt as &!pw in { snapshot(q, pw, req, rsp, chunk, ev, ans, v); }
                                                                                var out = buffer.empty(h, 1024);
                                                                                var more = true;
                                                                                while more {
                                                                                    var slot = 0 - 1;
                                                                                    borrow mut srv as &!sw in { slot = server.next(h, sw); }
                                                                                    if slot < 0 { more = false; }
                                                                                    else {
                                                                                        borrow mut out as &!ob in { buffer.clear(ob); }
                                                                                        borrow srv as &sr in {
                                                                                            borrow files as &fd in {
                                                                                                want[0] = 0;
                                                                                                out = handle(h, server.head(sr), server.parsed(sr), v, want, out);
                                                                                                if want[0] != 0 {
                                                                                                    var n = 0 - 1;
                                                                                                    if want[0] == 1 { n = fs_read(fd, "/srv/afm/ui/live.html", file); }
                                                                                                    if want[0] == 2 { n = fs_read(fd, "/srv/afm/ui/live.js", file); }
                                                                                                    let keep = want[1] == 1;
                                                                                                    if n < 0 { out = server.failure(h, out, 404, "not found", keep); }
                                                                                                    else if want[0] == 1 { out = server.reply_as(h, out, 200, "text/html; charset=utf-8", file[0..n], keep, ""); }
                                                                                                    else { out = server.reply_as(h, out, 200, "text/javascript; charset=utf-8", file[0..n], keep, ""); }
                                                                                                }
                                                                                            }
                                                                                        }
                                                                                        borrow mut srv as &!sw in { borrow out as &ob in { server.respond(sw, buffer.bytes(ob)); } }
                                                                                    }
                                                                                }
                                                                                buffer.drop(h, out);
                                                                            }
                                                                        }
                                                                        server.close(h, srv);
                                                                    }
                                                                }
                                                            }
                                                        }
                                                        listener_close(listener);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            tty_close(tp);
                        }
                    }
                }
                poller_close(pt);
            }
        }
    }
    release(files);
    release(device);
    release(net); release(clock); release(args); release(io); release(heap);
    return status;
}
