edition 7;

import std.buffer;
import board;
import script;
import run_twin;
import session;
import regs;
import image;
import metrics;
import features;
import drift;
import report;
import force;
import png;

// The twin's automatic procedure up to the loop being closed (host/session.cho: tune, choose, approach), then a larger raster (64 x 64) over the made-up sample of sim/board.cho
// (grating, terrace step, three particles) with noise and slow drift. Prints the image (Z, pm), one `line pixel Z` record per reading (a pixel may be read more than once; the last reading is the one the loop settled to). A prediction of this software, not a measurement.
//   cancho build host/scan_twin.cho -o scan_twin ...same files... --std; ./scan_twin [0|1]   (cancho run cannot pass arguments)
//   files: host/scan_twin.cho host/session.cho host/script.cho host/run_twin.cho host/proto.cho host/twin_link.cho sim/board.cho sim/lockin.cho sim/pid.cho sim/raster.cho
//    sim/raster_sine.cho sim/plant.cho sim/tune.cho sim/approach.cho host/regs.cho --std
fn text[&h, &r](heap: &!h Heap, b: buffer.Buffer, s: &r [byte]) -> [heap] buffer.Buffer { return buffer.append(heap, b, s); }

fn num[&h](heap: &!h Heap, b: buffer.Buffer, n: int) -> [heap] buffer.Buffer {
    if n < 0 { return buffer.push_nat(heap, buffer.append(heap, b, "-"), 0 - n); }
    return buffer.push_nat(heap, b, n);
}

// The scan's image cells hold two heights in one int (a region is 64 KiB, and two 64 x 64 images of ints do not fit beside the rest): the trace in the low 24 bits and the retrace of the same pixel above;
// a retrace of 0 means the scan did not visit the pixel (x = 0 and 63). Heights are pm, clamped to 1 .. 16777215.
fn tr_of(v: int) -> [] int { return v % 16777216; }
fn rt_of(v: int) -> [] int { return v / 16777216 % 16777216; }
fn force_of(v: int) -> [] int { return v / 281474976710656; }       // the pixel's tapping force in pN, packed above the two 24-bit heights (S9.3); 0 when force is not modelled
fn pack(force: int, rt: int, tr: int) -> [] int { return force * 281474976710656 + rt * 16777216 + tr; }
fn clampf(v: float) -> [] int {
    var n = truncate(v + 0.5);
    if n < 0 { n = 0; }
    if n > 32767 { n = 32767; }
    return n;
}
fn clampz(v: int) -> [] int {
    if v < 1 { return 1; }
    if v > 16777215 { return 16777215; }
    return v;
}

fn side() -> [] int { return 64; }

// The levelling check on the twin's own image (docs/image-processing.md, I1): `pic` is the scanned trace, 64 x 64 heights in pm. The truth is that image levelled by its own robust plane. A copy gets a known tilt
// (2 and -1.5 pm per pixel) and line offsets (a deterministic +-40 pm), is levelled (robust plane, then lines within 4), and is scored against the truth, with the mean removed.
fn line_off(j: int) -> [] float { return float_of((j * 1103515245 + 12345) / 65536 % 81 - 40); }

fn rms_diff[&a, &b](x: &a [float], y: &b [float]) -> [] float {
    var mx = 0.0;
    var my = 0.0;
    var k = 0;
    while k < 4096 { mx = mx + x[k]; my = my + y[k]; k = k + 1; }
    mx = mx / 4096.0;
    my = my / 4096.0;
    var sum = 0.0;
    k = 0;
    while k < 4096 {
        let d = (x[k] - mx) - (y[k] - my);
        sum = sum + d * d;
        k = k + 1;
    }
    return sqrt(sum / 4096.0);
}

fn analyse[&h, &a](heap: &!h Heap, o: buffer.Buffer, pic: &a [int]) -> [heap] buffer.Buffer {
    var b = o;
    region r1 {
        let tr = alloc_slice[r1](4096, 0.0);
        var k = 0;
        while k < 4096 { tr[k] = float_of(tr_of(pic[k])); k = k + 1; }
        let p = image.plane_robust(tr, 64, 64, 3, 2.5);
        image.subtract_tilt(tr, 64, 64, p);
        region r2 {
            let t = alloc_slice[r2](4096, 0.0);
            var j = 0;
            while j < 64 {
                var i = 0;
                while i < 64 {
                    t[j * 64 + i] = float_of(tr_of(pic[j * 64 + i])) + 2.0 * (float_of(i) - 31.5) - 1.5 * (float_of(j) - 31.5) + line_off(j);
                    i = i + 1;
                }
                j = j + 1;
            }
            let q = image.plane_robust(t, 64, 64, 3, 2.5);
            image.subtract_tilt(t, 64, 64, q);
            let e1 = rms_diff(t, tr);
            image.level_lines(t, 64, 64, 4);
            let e2 = rms_diff(t, tr);
            b = text(heap, b, "level: robust plane of the twin image bx "); b = num(heap, b, truncate(p.bx * 1000.0)); b = text(heap, b, " by "); b = num(heap, b, truncate(p.by * 1000.0));
            b = text(heap, b, " (milli pm per pixel); tilt added 2000 -1500; estimate error bx "); b = num(heap, b, truncate((q.bx - p.bx - 2.0) * 1000.0));
            b = text(heap, b, " by "); b = num(heap, b, truncate((q.by - p.by + 1.5) * 1000.0)); b = text(heap, b, "\n");
            b = text(heap, b, "level: rms difference from the truth in milli pm, after the plane "); b = num(heap, b, truncate(e1 * 1000.0));
            b = text(heap, b, ", after the plane and the lines "); b = num(heap, b, truncate(e2 * 1000.0)); b = text(heap, b, "\n");
        }
    }
    return b;
}

// The metrics check on the twin's own image (docs/image-processing.md, I2): the same numbers are read off the scanned trace and off the sample's true surface at the pixels' places (`surface_at`, x = 1000 + 100 i,
// y = 1000 + 100 j), no noise, no tracking error. The true values of the sample are a 150 pm terrace from line 25, a grating of 100 pm peak to peak and 12 pixels' pitch.
fn report[&h, &t, &a](heap: &!h Heap, o: buffer.Buffer, tag: &t [byte], z: &a [float]) -> [heap] buffer.Buffer {
    var b = o;
    let q = metrics.rough(z, 64, 64);
    let s = metrics.step_fit(z, 64, 64, 4);
    let g = metrics.grating_fit(z, 64, 64);
    b = text(heap, b, tag); b = text(heap, b, ": Ra "); b = num(heap, b, truncate(q.ra * 1000.0)); b = text(heap, b, " Rq "); b = num(heap, b, truncate(q.rq * 1000.0)); b = text(heap, b, " Rz "); b = num(heap, b, truncate(q.rz * 1000.0));
    b = text(heap, b, " (milli pm); step at line "); b = num(heap, b, s.line); b = text(heap, b, " height "); b = num(heap, b, truncate(s.height * 1000.0)); b = text(heap, b, " slope "); b = num(heap, b, truncate(s.slope * 1000.0));
    b = text(heap, b, "; grating pitch "); b = num(heap, b, truncate(g.pitch * 1000.0)); b = text(heap, b, " (milli pixel), height "); b = num(heap, b, truncate(g.height * 1000.0)); b = text(heap, b, " (milli pm), fit rms "); b = num(heap, b, truncate(g.rms * 1000.0)); b = text(heap, b, "\n");
    return b;
}

fn metrics_check[&h, &a, &b2, &c, &d](heap: &!h Heap, o: buffer.Buffer, pic: &a [int], rf: &b2 [int], st: &!c [int], fl: &d [float]) -> [heap] buffer.Buffer {
    var b = o;
    region r1 {
        let t = alloc_slice[r1](4096, 0.0);
        var k = 0;
        while k < 4096 { t[k] = float_of(tr_of(pic[k])); k = k + 1; }
        b = report(heap, b, "measured", t);
    }
    region r2 {
        let t = alloc_slice[r2](4096, 0.0);
        var j = 0;
        while j < 64 {
            var i = 0;
            while i < 64 {
                st[19] = 1000 + 100 * i; st[20] = 1000 + 100 * j;
                t[j * 64 + i] = board.surface_at(rf, st, fl);
                i = i + 1;
            }
            j = j + 1;
        }
        b = report(heap, b, "truth   ", t);
    }
    return b;
}

// A float as a decimal with two places ("12.34"; negative values are not needed here).
fn dec[&h](heap: &!h Heap, o: buffer.Buffer, v: float) -> [heap] buffer.Buffer {
    let c = truncate(v * 100.0 + 0.5);
    var b = num(heap, o, c / 100);
    b = text(heap, b, ".");
    if c % 100 < 10 { b = text(heap, b, "0"); }
    return num(heap, b, c % 100);
}

// The particles of the twin's trace as CSV (docs/image-processing.md, I3): `x,y,height_pm,area_px`, centres in pixels, one row per particle. The twin's true particles are at (12, 13), (32, 18) and (23, 33) pixels, 600, 450 and 600 pm.
fn particles_csv[&h, &a](heap: &!h Heap, o: buffer.Buffer, pic: &a [int]) -> [heap] buffer.Buffer {
    var b = text(heap, o, "x,y,height_pm,area_px\n");
    region r {
        let t = alloc_slice[r](4096, 0.0);
        let out = alloc_slice[r](4 * 32, 0.0);
        var k = 0;
        while k < 4096 { t[k] = float_of(tr_of(pic[k])); k = k + 1; }
        let n = features.find_particles(t, 64, 64, 15, 0.0, 4, out, 32);
        var p = 0;
        while p < n {
            b = dec(heap, b, out[4 * p]); b = text(heap, b, ","); b = dec(heap, b, out[4 * p + 1]); b = text(heap, b, ","); b = dec(heap, b, out[4 * p + 2]); b = text(heap, b, ","); b = num(heap, b, truncate(out[4 * p + 3])); b = text(heap, b, "\n");
            p = p + 1;
        }
    }
    return b;
}

// The drift check on the twin's own scan (docs/image-processing.md, I4). The twin drifts the sample under the tip by `xd` milli-pixels per tick along x and `zd` milli-pm per tick in height (set before the
// scan, a tick being one pixel of the raster); the trace and the retrace of the same lines (both in `pic`) give the estimate, and the corrected image is scored against the true surface at the middle of each
// line's time (the twin's `surface_at` with its drift clock set to that time), as is the raw trace.
fn drift_check[&h, &a, &c, &d, &e](heap: &!h Heap, o: buffer.Buffer, pic: &a [int], rf: &c [int], st: &!d [int], fl: &!e [float], pd: int, xd: int, zd: int) -> [heap] buffer.Buffer {
    var bb = o;
    region r1 {
        let t = alloc_slice[r1](4096, 0.0);
        var k = 0;
        while k < 4096 { t[k] = float_of(tr_of(pic[k])); k = k + 1; }
        region r2 {
            let r = alloc_slice[r2](4096, 0.0);
            k = 0;
            while k < 4096 { r[k] = float_of(rt_of(pic[k])); k = k + 1; }
            let est = drift.estimate(t, r, 64, 64, 0.5, 3.0);
            bb = text(heap, bb, "drift set: x "); bb = num(heap, bb, xd); bb = text(heap, bb, " milli-px/tick, z "); bb = num(heap, bb, zd); bb = text(heap, bb, " milli-pm/tick\n");
            var vm = truncate(est.v * 1000000.0);
            var wm = truncate(est.w * 1000.0);
            bb = text(heap, bb, "drift estimated: x "); if vm < 0 { bb = text(heap, bb, "-"); vm = 0 - vm; } bb = num(heap, bb, vm / 1000); bb = text(heap, bb, "."); bb = num(heap, bb, vm % 1000 / 100);
            bb = text(heap, bb, " milli-px/tick, z "); if wm < 0 { bb = text(heap, bb, "-"); wm = 0 - wm; } bb = num(heap, bb, wm); bb = text(heap, bb, " milli-pm/tick, loop lag shift "); bb = num(heap, bb, truncate(est.shift * 1000.0));
            bb = text(heap, bb, " milli-px, fit rms "); bb = num(heap, bb, truncate(est.rms * 1000.0)); bb = text(heap, bb, " milli-pm\n");
            region r3 {
                let c = alloc_slice[r3](4096, 0.0);
                drift.correct(t, r, 64, 64, 0.5, est, c);
                var ec = 0.0; var et = 0.0; var mc = 0.0; var mt = 0.0; var n = 0.0;
                var j = 0;
                while j < 64 {
                    fl[22] = float_of((j * 126 + 63) * pd);
                    var i = 4;
                    while i < 60 {
                        st[19] = 1000 + 100 * i; st[20] = 1000 + 100 * j;
                        let tru = board.surface_at(rf, st, fl);
                        let dc = c[j * 64 + i] - tru;
                        let dt = t[j * 64 + i] - tru;
                        ec = ec + dc * dc; et = et + dt * dt; mc = mc + dc; mt = mt + dt;
                        n = n + 1.0;
                        i = i + 1;
                    }
                    j = j + 1;
                }
                bb = text(heap, bb, "rms difference from the truth, the mean (the Z baseline) removed (milli pm): raw trace "); bb = num(heap, bb, truncate(sqrt(et / n - mt / n * mt / n) * 1000.0));
                bb = text(heap, bb, ", corrected "); bb = num(heap, bb, truncate(sqrt(ec / n - mc / n * mc / n) * 1000.0)); bb = text(heap, bb, "\n");
            }
        }
    }
    return bb;
}

// A float with one decimal and a sign ("-1.5").
fn sdec[&h](heap: &!h Heap, o: buffer.Buffer, v: float) -> [heap] buffer.Buffer {
    var b = o;
    var x = v;
    if x < 0.0 { b = text(heap, b, "-"); x = 0.0 - x; }
    let c = truncate(x * 10.0 + 0.5);
    b = num(heap, b, c / 10); b = text(heap, b, "."); return num(heap, b, c % 10);
}

// The console's document for one scan (docs/image-processing.md, I5), mode 5: one line of JSON, flat, every value a number or a string the page prints as it is; mode 6: the levelled image as a PNG.
// The analysis is `report.run`; `frame_us` is the scan's duration in the twin's time. "source" is "twin": a prediction of this software.
fn scan_out[&h, &a](heap: &!h Heap, o: buffer.Buffer, pic: &a [int], mode: int, frame_us: int, prof: int, fk: int, fth: int) -> [heap] buffer.Buffer {
    var b = o;
    region r1 {
        let t = alloc_slice[r1](4096, 0.0);
        var k = 0;
        while k < 4096 { t[k] = float_of(tr_of(pic[k])); k = k + 1; }
        region r2 {
            let r = alloc_slice[r2](4096, 0.0);
            k = 0;
            while k < 4096 { r[k] = float_of(rt_of(pic[k])); k = k + 1; }
            region r3 {
                let lev = alloc_slice[r3](4096, 0.0);
                let parts = alloc_slice[r3](4 * 16, 0.0);
                let rp = report.run(t, r, 64, 64, 0.005, lev, parts, 16);
                if mode == 5 {
                    b = text(heap, b, "{\"source\":\"twin\",\"profile\":\""); if prof == 2 { b = text(heap, b, "liquid cantilever"); } else if prof == 1 { b = text(heap, b, "high-speed cantilever"); } else { b = text(heap, b, "tuning fork"); }
                    b = text(heap, b, "\",\"size\":\"64 x 64\",\"frame_s\":"); b = sdec(heap, b, float_of(frame_us) / 1000000.0);
                    b = text(heap, b, ",\"ra_pm\":"); b = sdec(heap, b, rp.ra); b = text(heap, b, ",\"rq_pm\":"); b = sdec(heap, b, rp.rq); b = text(heap, b, ",\"rz_pm\":"); b = sdec(heap, b, rp.rz);
                    b = text(heap, b, ",\"step_line\":"); b = num(heap, b, rp.step_line); b = text(heap, b, ",\"step_pm\":"); b = sdec(heap, b, rp.step_pm);
                    b = text(heap, b, ",\"pitch_px\":"); b = sdec(heap, b, rp.pitch); b = text(heap, b, ",\"grating_pm\":"); b = sdec(heap, b, rp.grating_pm);
                    b = text(heap, b, ",\"particles\":"); b = num(heap, b, rp.particles);
                    b = text(heap, b, ",\"particles_text\":\"");
                    var p = 0;
                    while p < rp.particles && p < 16 {
                        if p > 0 { b = text(heap, b, "; "); }
                        b = num(heap, b, p + 1); b = text(heap, b, ": x "); b = sdec(heap, b, parts[4 * p]); b = text(heap, b, " y "); b = sdec(heap, b, parts[4 * p + 1]);
                        b = text(heap, b, " px, "); b = num(heap, b, truncate(parts[4 * p + 2])); b = text(heap, b, " pm, area "); b = num(heap, b, truncate(parts[4 * p + 3])); b = text(heap, b, " px");
                        p = p + 1;
                    }
                    b = text(heap, b, "\",\"drift_text\":\"x "); b = sdec(heap, b, rp.dv * 1000.0); b = text(heap, b, " milli-px/tick, height "); b = sdec(heap, b, rp.dw * 1000.0); b = text(heap, b, " milli-pm/tick, loop lag ");
                    b = sdec(heap, b, rp.dshift); b = text(heap, b, " px; image "); if rp.corrected == 1 { b = text(heap, b, "drift-corrected"); } else { if rp.corrected == 2 { b = text(heap, b, "trace only (loop lag over a pixel: drift cannot be told from it)"); } else { b = text(heap, b, "trace only (drift under the 5 milli-px/tick floor)"); } }
                    b = text(heap, b, "\",\"z_min_pm\":"); b = sdec(heap, b, rp.lo); b = text(heap, b, ",\"z_max_pm\":"); b = sdec(heap, b, rp.hi);
                    if fk > 0 {
                        // the force next to the image (docs/liquid.md, S9.7): the per-pixel proxy of S9.3, its largest value, the pixels over the stated threshold, and what it is
                        var fmx = 0; var fov = 0; var fnn = 0; var kf = 0;
                        while kf < 4096 { if tr_of(pic[kf]) > 0 { fnn = fnn + 1; if force_of(pic[kf]) > fmx { fmx = force_of(pic[kf]); } if fth > 0 && force_of(pic[kf]) > fth { fov = fov + 1; } } kf = kf + 1; }
                        b = text(heap, b, ",\"force_pn_max\":"); b = num(heap, b, fmx); b = text(heap, b, ",\"force_pixels_over\":"); b = num(heap, b, fov); b = text(heap, b, ",\"force_threshold_pn\":"); b = num(heap, b, fth);
                        b = text(heap, b, ",\"force_text\":\"proxy: stiffness "); b = num(heap, b, fk); b = text(heap, b, " hundredths of N/m times the amplitude given up, once per pixel; the twin's guess, not a measured force, and it misses transient peaks; a damage threshold is a parameter, not a finding\"");
                    }
                    b = text(heap, b, "}\n");
                } else {
                    // the levelled image through a 256-entry palette (dark purple, blue, teal, green, yellow: five stops), lowest to highest height
                    let pal = alloc_slice[r3](768, byte_of(0));
                    let pix = alloc_slice[r3](4096, byte_of(0));
                    var i = 0;
                    while i < 256 {
                        let f = float_of(i) / 255.0 * 4.0;
                        var seg = truncate(f);
                        if seg > 3 { seg = 3; }
                        let u = f - float_of(seg);
                        var c = 0;
                        while c < 3 {
                            var a0 = 0.0; var a1 = 0.0;
                            if c == 0 { if seg == 0 { a0 = 68.0; a1 = 59.0; } if seg == 1 { a0 = 59.0; a1 = 33.0; } if seg == 2 { a0 = 33.0; a1 = 94.0; } if seg == 3 { a0 = 94.0; a1 = 253.0; } }
                            if c == 1 { if seg == 0 { a0 = 1.0; a1 = 82.0; } if seg == 1 { a0 = 82.0; a1 = 145.0; } if seg == 2 { a0 = 145.0; a1 = 201.0; } if seg == 3 { a0 = 201.0; a1 = 231.0; } }
                            if c == 2 { if seg == 0 { a0 = 84.0; a1 = 139.0; } if seg == 1 { a0 = 139.0; a1 = 140.0; } if seg == 2 { a0 = 140.0; a1 = 98.0; } if seg == 3 { a0 = 98.0; a1 = 37.0; } }
                            pal[3 * i + c] = byte_of(truncate(a0 + (a1 - a0) * u + 0.5));
                            c = c + 1;
                        }
                        i = i + 1;
                    }
                    var lo = rp.lo;
                    var hi = rp.hi;
                    if mode == 7 {
                        // the raw trace as the instrument read it: no drift correction, no plane, no line offsets, stretched over its own range
                        lo = t[0]; hi = t[0];
                        k = 0;
                        while k < 4096 { lev[k] = t[k]; if t[k] < lo { lo = t[k]; } if t[k] > hi { hi = t[k]; } k = k + 1; }
                    }
                    var span = hi - lo;
                    if span < 1.0 { span = 1.0; }
                    k = 0;
                    while k < 4096 {
                        var q = truncate((lev[k] - lo) / span * 255.0 + 0.5);
                        if q < 0 { q = 0; }
                        if q > 255 { q = 255; }
                        pix[k] = byte_of(q);
                        k = k + 1;
                    }
                    b = png.indexed(heap, b, 64, 64, pix, pal);
                }
            }
        }
    }
    return b;
}

// the profile: argument 1 (the scanner, argument 2, and for the high-speed profile the cantilever's resonance in kHz, argument 3, the same way; default 500; argument 4 = 1 prints the levelling check, 2 the metrics check, 5 the console's scan.json, 6 its levelled image as a PNG, 7 the raw trace as a PNG, 4 the drift check (arguments 5 and 6: the sample's drift along x in milli-pixels per tick and in height in milli-pm per tick; 7 to 10: a tilt along x in pm per pixel, a tilt along y in pm per line, a bow in pm and line offsets of up to that many pm), of docs/image-processing.md instead of the pixels), `0` the tuning fork (the default), `1` the high-speed cantilever (docs/high-speed.md), `2` the same lever in liquid (docs/liquid.md, S9.6: the optical lever is always on, its defaults a sum of 2,000 counts and no noise, and the run reads its light); for profiles 1 and 2, arguments 11 to 13 make it a liquid lever (docs/liquid.md, S9.2): its Q in tenths (30 = 3.0; default 50), a forest of fluid-cell peaks whose nearest is this many percent of the lever's height (0 = none), and their spacing in kHz; arguments 14 to 16: the lever's stiffness in hundredths of N/m (15 = 0.15; 0 = force not modelled), the soft sample's stiffness in hundredths of N/m (0 = rigid) and the damage threshold in pN (docs/liquid.md, S9.3), which add a force line to the output; arguments 17 to 20 turn on the optical lever (docs/liquid.md, S9.4): its noise in ADC counts, the share of light reaching the photodiode in percent (default 100), the deflection's DC wander in thousandths of a count per detector window and the light lost in millionths per window
fn number_of[&t](text: &t [byte]) -> [] int {
    var n = 0;
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c < 48 || c > 57 { return 0; }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    return n;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi); release(fs);
    var prof = 0;
    var scn = 0;
    var fk = 0;
    var lv = 0;
    var xd = 0;
    var zd = 0;
    var tx = 0;
    var ty = 0;
    var bw = 0;
    var lo7 = 0;
    var lq = 0;
    var fr = 0;
    var fsp = 0;
    var lk = 0;
    var lks = 0;
    var lth = 0;
    var on = 0;
    var oa = 100;
    var ow = 0;
    var ol = 0;
    borrow args as &g in {
        if arg_count(g) > 1 { prof = number_of(arg(g, 1)); }
        if arg_count(g) > 2 { scn = number_of(arg(g, 2)); }
        if arg_count(g) > 3 { fk = number_of(arg(g, 3)); }
        if arg_count(g) > 4 { lv = number_of(arg(g, 4)); }
        if arg_count(g) > 5 { xd = number_of(arg(g, 5)); }
        if arg_count(g) > 6 { zd = number_of(arg(g, 6)); }
        if arg_count(g) > 7 { tx = number_of(arg(g, 7)); }
        if arg_count(g) > 8 { ty = number_of(arg(g, 8)); }
        if arg_count(g) > 9 { bw = number_of(arg(g, 9)); }
        if arg_count(g) > 10 { lo7 = number_of(arg(g, 10)); }
        if arg_count(g) > 11 { lq = number_of(arg(g, 11)); }
        if arg_count(g) > 12 { fr = number_of(arg(g, 12)); }
        if arg_count(g) > 13 { fsp = number_of(arg(g, 13)); }
        if arg_count(g) > 14 { lk = number_of(arg(g, 14)); }
        if arg_count(g) > 15 { lks = number_of(arg(g, 15)); }
        if arg_count(g) > 16 { lth = number_of(arg(g, 16)); }
        if arg_count(g) > 17 { on = number_of(arg(g, 17)); }
        if arg_count(g) > 18 { oa = number_of(arg(g, 18)); }
        if arg_count(g) > 19 { ow = number_of(arg(g, 19)); }
        if arg_count(g) > 20 { ol = number_of(arg(g, 20)); }
    }
    release(args); release(net); release(clock); release(signals); release(exec);
    borrow mut heap as &!h in {
        var o = buffer.empty(h, 65536);
        region r {
            let rf = alloc_slice[r](64, 0);
            let st = alloc_slice[r](32, 0);
            let fl = alloc_slice[r](48, 0.0);
            board.reset(rf, st, fl);
            if prof >= 1 { var fc = 500000.0; if fk > 0 { fc = 1000.0 * float_of(fk); } var qq = 5.0; if lq > 0 { qq = float_of(lq) / 10.0; } board.set_plant(fl, fc, qq, 2000.0, 2000.0, 100.0, 1200.0, 2.0); board.set_forest(fl, float_of(fr) / 100.0, 1000.0 * float_of(fsp), 15.0, 3); board.set_soft(fl, float_of(lk) / 100.0, float_of(lks) / 100.0, float_of(lth)); }
            else { board.set_plant(fl, 32781.4, 500.0, 2000.0, 2000.0, 100.0, 1200.0, 2.0); }
            fl[10] = 150.0;
            if on > 0 || oa != 100 || ow > 0 || ol > 0 || prof == 2 { board.set_optics(fl, 2000.0, float_of(oa) / 100.0, float_of(on), float_of(ow) / 1000.0, float_of(ol) / 1000000.0); }
            // argument 2, the Z scanner: 0 ideal, 1 a good small stack (100 kHz, Q 3), 2 a slow one (20 kHz, Q 10), 3 the good one behind a 20 pm/us amplifier, 4 to 6 a Q = 3 stack at 30, 50, 70 kHz (docs/high-speed.md, H2)
            if scn == 1 { board.set_scanner(fl, 100000.0, 3.0, 0.0); }
            if scn == 2 { board.set_scanner(fl, 20000.0, 10.0, 0.0); }
            if scn == 3 { board.set_scanner(fl, 100000.0, 3.0, 20.0); }
            if scn == 4 { board.set_scanner(fl, 30000.0, 3.0, 0.0); }
            if scn == 5 { board.set_scanner(fl, 50000.0, 3.0, 0.0); }
            if scn == 6 { board.set_scanner(fl, 70000.0, 3.0, 0.0); }
            fl[8] = float_of(zd) / 1000.0 / float_of(session.pixdiv(prof)); fl[20] = float_of(xd) / 1000.0 * 100.0 / float_of(session.pixdiv(prof));
            fl[24] = float_of(tx); fl[25] = float_of(ty); fl[26] = float_of(bw); fl[27] = float_of(lo7);
            board.set_distance(fl, 11000.0, 198.4375);
            let ss = alloc_slice[r](32, 0);
            ss[3] = prof;
            let sf = alloc_slice[r](8, 0.0);
            let sc = alloc_slice[r](4 * 200, 0);
            let out = alloc_slice[r](128, 0);
            let img = alloc_slice[r](64, 0 - 1);
            let pic = alloc_slice[r](4096, 0);
            let req = alloc_slice[r](16, byte_of(0));
            let rsp = alloc_slice[r](16, byte_of(0));
            var guard = 0;
            var failures = 0;
            while ss[0] != 5 && ss[0] != 98 && guard < 40000 {
                let n = session.build(ss, sf, sc);
                failures = failures + run_twin.run(sc, n, rf, st, fl, out, req, rsp);
                session.consume(ss, sf, out, img);
                guard = guard + 1;
            }
            if lv != 3 && lv != 5 && lv != 6 && lv != 7 {
            o = text(h, o, "twin scan; failure code "); o = num(h, o, ss[2]); o = text(h, o, ", refused writes "); o = num(h, o, failures);
            o = text(h, o, ", contact Z "); o = num(h, o, ss[9]); o = text(h, o, " pm; f0 "); o = num(h, o, truncate(sf[0])); o = text(h, o, " Hz, Q "); o = num(h, o, truncate(sf[1])); o = text(h, o, ", free figure "); o = num(h, o, ss[10]);
            o = text(h, o, ", window "); o = num(h, o, ss[15]); o = text(h, o, ", shift "); o = num(h, o, ss[11]); o = text(h, o, ", setpoint "); o = num(h, o, ss[12]); o = text(h, o, ", motor steps "); o = num(h, o, ss[21]); o = text(h, o, ", settled Z "); o = num(h, o, ss[22]); o = text(h, o, " pm\n");
            }
            var n = 0;
            n = script.write(sc, n, regs.npix(), side());
            n = script.write(sc, n, regs.nlines(), side());
            n = script.write(sc, n, regs.x0(), 1000);
            n = script.write(sc, n, regs.y0(), 1000);
            n = script.write(sc, n, regs.dx(), 100);
            n = script.write(sc, n, regs.dy(), 100);
            n = script.write(sc, n, regs.pixdiv(), session.pixdiv(prof));
            var cbits = 21;
            if prof == 2 { cbits = 21 + session.adc_bit(prof); }     // profile 2 keeps the parallel ADC and the optical lever on; profile 1 is left as it was
            n = script.write(sc, n, regs.ctrl(), cbits);
            failures = failures + run_twin.run(sc, n, rf, st, fl, out, req, rsp);
            var calls = 0;
            var done = 0;
            var line = 0 - 1;
            var guard2 = 0;
            while done == 0 && guard2 < 400000 {
                var m = 0;
                m = script.write(sc, m, regs.kick(), 0);
                m = script.wait(sc, m, (session.pixdiv(prof) - 1) * session.win_clocks(ss));
                m = script.read(sc, m, regs.pixline());
                m = script.read(sc, m, regs.zout());
                m = script.read(sc, m, regs.status());
                if lk > 0 { m = script.read(sc, m, regs.amp()); }
                m = script.wait(sc, m, session.win_clocks(ss));
                failures = failures + run_twin.run(sc, m, rf, st, fl, out, req, rsp);
                let pix = out[1] / 65536;
                let ln = out[1] % 65536;
                if out[3] % 2 == 1 || out[3] / 8 % 2 == 1 { done = 1; }
                if ln >= side() { done = 1; }
                else {
                    if pix < 64 && ln < 64 {
                        var fp = force_of(pic[ln * 64 + pix]);
                        if lk > 0 { fp = clampf(force.pixel(float_of(lk) / 100.0, session.free_pm(), float_of(ss[10]), float_of(out[4]))); }
                        pic[ln * 64 + pix] = pack(fp, rt_of(pic[ln * 64 + pix]), clampz(out[2]));
                    }
                    if pix >= 64 && pix < 126 && ln < 64 { pic[ln * 64 + (126 - pix)] = pack(force_of(pic[ln * 64 + (126 - pix)]), clampz(out[2]), tr_of(pic[ln * 64 + (126 - pix)])); }
                    if lv == 0 { o = num(h, o, ln); o = text(h, o, " "); o = num(h, o, pix); o = text(h, o, " "); o = num(h, o, out[2]); o = text(h, o, "\n"); }
                }
                guard2 = guard2 + 1;
                if ln < side() { calls = calls + 1; }
            }
            if lv == 1 { o = analyse(h, o, pic); }
            if lv == 2 { o = metrics_check(h, o, pic, rf, st, fl); }
            if lv == 3 { o = particles_csv(h, o, pic); }
            if lv == 5 || lv == 6 || lv == 7 { o = scan_out(h, o, pic, lv, calls * session.pixdiv(prof) * session.win_clocks(ss) / 27, prof, lk, lth); }
            if lv == 4 { o = drift_check(h, o, pic, rf, st, fl, session.pixdiv(prof), xd, zd); }
            if lv != 3 && lv != 5 && lv != 6 && lv != 7 && lk > 0 { o = text(h, o, "force_pn_max "); o = num(h, o, truncate(fl[36] + 0.5)); o = text(h, o, " windows_over_threshold "); o = num(h, o, truncate(fl[37])); o = text(h, o, " indentation_pm "); o = num(h, o, truncate(fl[38] + 0.5)); o = text(h, o, "\n"); var fmax = 0; var fover = 0; var fn_ = 0; var kk = 0; while kk < 4096 { if tr_of(pic[kk]) > 0 { fn_ = fn_ + 1; if force_of(pic[kk]) > fmax { fmax = force_of(pic[kk]); } if lth > 0 && force_of(pic[kk]) > lth { fover = fover + 1; } } kk = kk + 1; } o = text(h, o, "force_map_max "); o = num(h, o, fmax); o = text(h, o, " pixels_over_threshold "); o = num(h, o, fover); o = text(h, o, " of "); o = num(h, o, fn_); o = text(h, o, "\n"); }
            if lv != 3 && lv != 5 && lv != 6 && lv != 7 { o = text(h, o, "frame_us "); o = num(h, o, calls * session.pixdiv(prof) * session.win_clocks(ss) / 27); o = text(h, o, "\n"); }
        }
        var code = 0;
        borrow mut io as &!w in { borrow o as &b in { code = buffer.write(w, b); } }
        buffer.drop(h, o);
    }
    release(heap);
    release(io);
    return 0;
}
