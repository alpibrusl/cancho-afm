edition 7;

import std.buffer;
import std.math;
import nucleation;
import vesicles;
import adequacy;

// D7: the discrepancy matrix (docs/dynamics.md). Data are made under model i (rows, seeds 1 to K) and compared with what model j predicts (columns, seeds 1001 to 1000 + K): the discrepancy of the two
// ensembles of summaries, and for each pair the fingerprint (which summaries differ, in standard errors). A prediction of this software; the models are stand-ins.
//   cancho run host/d7_matrix.cho sim/adequacy.cho sim/vesicles.cho sim/nucleation.cho --std
fn text[&h, &r](heap: &!h Heap, b: buffer.Buffer, s: &r [byte]) -> [heap] buffer.Buffer { return buffer.append(heap, b, s); }

fn dec[&h](heap: &!h Heap, o: buffer.Buffer, v: float, places: int) -> [heap] buffer.Buffer {
    var b = o;
    var x = v;
    if x < 0.0 { b = text(heap, b, "-"); x = 0.0 - x; }
    var scale = 1;
    var p = 0;
    while p < places { scale = scale * 10; p = p + 1; }
    let c = truncate(x * float_of(scale) + 0.5);
    b = buffer.push_nat(heap, b, c / scale);
    if places > 0 {
        b = text(heap, b, ".");
        var rest = c % scale;
        var div = scale / 10;
        while div > 0 {
            b = buffer.push_nat(heap, b, rest / div);
            rest = rest % div;
            div = div / 10;
        }
    }
    return b;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi); release(fs); release(net); release(clock); release(signals); release(exec); release(args);
    borrow mut heap as &!h in {
        var o = buffer.empty(h, 32768);
        region r {
            let nm = adequacy.n_models();
            let k = 24;
            // ensembles: generated (seeds 1..) and predicted (seeds 1001..) of every model: means and variances, 8 floats a model
            let gm = alloc_slice[r](nm * 8, 0.0);
            let gv = alloc_slice[r](nm * 8, 0.0);
            let pm = alloc_slice[r](nm * 8, 0.0);
            let pv = alloc_slice[r](nm * 8, 0.0);
            let am = alloc_slice[r](8, 0.0);
            let av = alloc_slice[r](8, 0.0);
            let bm = alloc_slice[r](8, 0.0);
            let bv = alloc_slice[r](8, 0.0);
            let z = alloc_slice[r](8, 0.0);
            let dm = alloc_slice[r](nm * nm, 0.0);
            let zz = alloc_slice[r](nm * nm * 8, 0.0);
            var i = 0;
            while i < nm {
                adequacy.ensemble(i, k, 1, am, av);
                adequacy.ensemble(i, k, 1001, bm, bv);
                var j = 0;
                while j < 8 { gm[i * 8 + j] = am[j]; gv[i * 8 + j] = av[j]; pm[i * 8 + j] = bm[j]; pv[i * 8 + j] = bv[j]; j = j + 1; }
                i = i + 1;
            }
            i = 0;
            while i < nm {
                var j = 0;
                while j < nm {
                    var t = 0;
                    while t < 8 { am[t] = gm[i * 8 + t]; av[t] = gv[i * 8 + t]; bm[t] = pm[j * 8 + t]; bv[t] = pv[j * 8 + t]; t = t + 1; }
                    dm[i * nm + j] = adequacy.compare(am, av, bm, bv, k, z);
                    t = 0;
                    while t < 8 { zz[(i * nm + j) * 8 + t] = z[t]; t = t + 1; }
                    j = j + 1;
                }
                i = i + 1;
            }
            o = text(h, o, "discrepancy (rms of the 7 summary differences, in standard errors; about 1 when the two ensembles are the same model). rows: data made under; columns: model predicting\n");
            o = text(h, o, "models: 0 A (gamma 3) | 1 A + edge k_e 0.5 | 2 A + tip 3% | 3 A + edge + tip | 4 A + weak edge 0.1 | 5 A gamma 2\n");
            o = text(h, o, "      ");
            var j = 0;
            while j < nm { o = text(h, o, "   m"); o = buffer.push_nat(h, o, j); o = text(h, o, "  "); j = j + 1; }
            o = text(h, o, "  best model\n");
            i = 0;
            while i < nm {
                o = text(h, o, "data m");
                o = buffer.push_nat(h, o, i);
                o = text(h, o, " ");
                var best = 0;
                j = 0;
                while j < nm {
                    o = text(h, o, " ");
                    o = dec(h, o, dm[i * nm + j], 1);
                    if dm[i * nm + j] < 10.0 { o = text(h, o, " "); }
                    o = text(h, o, " ");
                    if dm[i * nm + j] < dm[i * nm + best] { best = j; }
                    j = j + 1;
                }
                o = text(h, o, "  -> m");
                o = buffer.push_nat(h, o, best);
                o = text(h, o, "\n");
                i = i + 1;
            }
            o = text(h, o, "\nfingerprints: z (standard errors) of [events, excess edge share, first event, dome rate, area, cover 15 s, cover 30 s], data made under row model against column model\n");
            i = 0;
            while i < nm {
                j = 0;
                while j < nm {
                    if i != j {
                        o = text(h, o, "m");
                        o = buffer.push_nat(h, o, i);
                        o = text(h, o, " vs m");
                        o = buffer.push_nat(h, o, j);
                        o = text(h, o, ":");
                        var t = 0;
                        while t < 7 {
                            o = text(h, o, " ");
                            o = dec(h, o, zz[(i * nm + j) * 8 + t], 1);
                            t = t + 1;
                        }
                        o = text(h, o, "\n");
                    }
                    j = j + 1;
                }
                i = i + 1;
            }
        }
        var code = 0;
        borrow mut io as &!w in { borrow o as &b in { code = buffer.write(w, b); } }
        buffer.drop(h, o);
    }
    release(heap);
    release(io);
    return 0;
}
