edition 7;

module report;

import image;
import metrics;
import features;
import drift;

// `report` -- everything the console shows about one scan, from its trace and retrace (docs/image-processing.md, I5). The order matters, and is the findings of I1 to I4:
//   1. the drift is estimated from the trace and the retrace; if it is large enough to see (more than `floor` pixels per tick, the estimate's own bias of I4) AND the loop's lag is under a pixel (the model of I4
//      takes the lag as one shift; the fork's 2 pixels is outside it and its "drift" is the lag) the image is the drift-corrected one, else the trace (`corrected` 0, or 2 when the drift was large but the lag too);
//   2. the step is measured on that image BEFORE any plane is taken out (a plane flattens a real step into a slope, I1);
//   3. the image is levelled: robust plane, then line offsets (I1);
//   4. roughness, the grating and the particles are read off the levelled image (I2, I3).
// The image is left levelled in `lev`, the particles in `parts` (4 floats each: x, y, height, area).

pub struct Report {
    ra: float, rq: float, rz: float,
    step_line: int, step_pm: float,
    pitch: float, grating_pm: float,
    particles: int,
    dv: float, dw: float, dshift: float, corrected: int,
    lo: float, hi: float
}

pub fn run[&a, &b, &c, &d](t: &a [float], r: &b [float], nx: int, ny: int, floor: float, lev: &!c [float], parts: &!d [float], cap: int) -> [] Report {
    let est = drift.estimate(t, r, nx, ny, 0.5, 3.0);
    var v = est.v;
    if v < 0.0 { v = 0.0 - v; }
    var sh = est.shift;
    if sh < 0.0 { sh = 0.0 - sh; }
    var corrected = 0;
    if v > floor && sh >= 1.0 { corrected = 2; }
    if v > floor && sh < 1.0 {
        corrected = 1;
        drift.correct(t, r, nx, ny, 0.5, est, lev);
    }
    if corrected != 1 {
        var k = 0;
        while k < nx * ny { lev[k] = t[k]; k = k + 1; }
    }
    let st = metrics.step_fit(lev, nx, ny, 4);
    let pl = image.plane_robust(lev, nx, ny, 3, 2.5);
    image.subtract_tilt(lev, nx, ny, pl);
    image.level_lines(lev, nx, ny, 4);
    let ro = metrics.rough(lev, nx, ny);
    let gr = metrics.grating_fit(lev, nx, ny);
    let np = features.find_particles(lev, nx, ny, 15, 0.0, 4, parts, cap);
    var lo = lev[0];
    var hi = lev[0];
    var k = 0;
    while k < nx * ny {
        if lev[k] < lo { lo = lev[k]; }
        if lev[k] > hi { hi = lev[k]; }
        k = k + 1;
    }
    return Report { ra: ro.ra, rq: ro.rq, rz: ro.rz, step_line: st.line, step_pm: st.height, pitch: gr.pitch, grating_pm: gr.height, particles: np, dv: est.v, dw: est.w, dshift: est.shift, corrected: corrected, lo: lo, hi: hi };
}
