edition 7;

import std.buffer;
import std.math;
import forcecurve;
import fcload;
import zipread;
import jpk;

// JPK FORCE CURVES IN (docs/dynamics.md, "A JPK reader"): each file is a `.jpk-force` (one curve) or a `.jpk-force-map` (many); every curve's first EXTEND segment is read (sim/jpk.cho), analysed as the
// text loader's curves are, and printed. NOT TESTED ON ANY REAL JPK FILE. The spring constant is the file's own; give the tip radius.
//   cancho build host/jpk_load.cho sim/jpk.cho sim/zipread.cho sim/fcload.cho sim/forcecurve.cho --std -o jpk_load
//   ./jpk_load R WINDOW file1 file2 ...
//     R       the tip radius in tenths of nm (320 = 32 nm)
//     WINDOW  the breakthrough rule: 0 nanoindent's single-step drop; n > 0 the largest drop within n tenths of a nm of piezo travel (sim/forcecurve.cho)
// One line per curve (the tag of a refusal, or the breakthrough force, modulus, height, the height channel used) and, per file, how many curves were analysed. A map is read up to 20,000 curves and 65,534
// archive entries (a larger archive is ZIP64, refused with tag 12).
fn text[&h, &r](heap: &!h Heap, b: buffer.Buffer, s: &r [byte]) -> [heap] buffer.Buffer { return buffer.append(heap, b, s); }

fn number_of[&t](txt: &t [byte]) -> [] int {
    var n = 0;
    var i = 0;
    while i < len(txt) {
        let c = int_of(txt[i]);
        if c < 48 || c > 57 { return 0; }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    return n;
}

fn dec[&h](heap: &!h Heap, o: buffer.Buffer, v: float, places: int) -> [heap] buffer.Buffer {
    var b = o;
    var x = v;
    if x < 0.0 { b = text(heap, b, "-"); x = 0.0 - x; }
    var scale = 1;
    var p = 0;
    while p < places { scale = scale * 10; p = p + 1; }
    let c = truncate(x * float_of(scale) + 0.5);
    b = buffer.push_nat(heap, b, c / scale);
    if places > 0 {
        b = text(heap, b, ".");
        var rest = c % scale;
        var div = scale / 10;
        while div > 0 {
            b = buffer.push_nat(heap, b, rest / div);
            rest = rest % div;
            div = div / 10;
        }
    }
    return b;
}

fn read_file[&h, &f, &p](heap: &!h Heap, fs: &f Fs(""), path: &p [byte], text_in: buffer.Buffer) -> [heap, fs_read(""), file_read] (buffer.Buffer, int) {
    var out = text_in;
    var total = 0;
    var trouble = 0;
    match open_read(fs, path) {
        Opened::Failed(reason) => {
            trouble = reason;
            if trouble == 0 { trouble = 1; }
        }
        Opened::Ok(opened) => {
            var file = opened;
            var chunk = buffer.empty(heap, 65536);
            borrow mut file as &!handle in {
                var going = true;
                while going {
                    var got = 0;
                    borrow mut chunk as &!c in {
                        match file_read(handle, buffer.room(c)) {
                            Read::Got(n) => { got = n; buffer.filled(c, n); }
                            Read::End => { going = false; }
                            Read::Failed(reason) => { going = false; trouble = reason; if trouble == 0 { trouble = 1; } }
                        }
                    }
                    if got > 0 {
                        borrow chunk as &c in { out = buffer.append(heap, out, buffer.bytes(c)); }
                        total = total + got;
                        borrow mut chunk as &!c in { buffer.clear(c); }
                    }
                }
            }
            file_close(file);
            buffer.drop(heap, chunk);
        }
    }
    if trouble != 0 { return (out, 0 - 1); }
    return (out, total);
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi); release(net); release(clock); release(signals); release(exec);
    var r_tenth = 320;
    var window = 0;
    var nfiles = 0;
    var usage = 0;
    borrow args as &g in {
        if arg_count(g) < 4 { usage = 1; } else {
            r_tenth = number_of(arg(g, 1));
            window = number_of(arg(g, 2));
            nfiles = arg_count(g) - 3;
        }
    }
    borrow mut heap as &!h in {
        var o = buffer.empty(h, 65536);
        if usage == 1 {
            o = text(h, o, "usage: jpk_load R WINDOW file...   (R in tenths of nm, WINDOW 0 single step or tenths of nm)\n");
        } else {
            let rad = float_of(r_tenth) / 10.0;
            let win = float_of(window) / 10.0;
            var f = 0;
            while f < nfiles {
                var scratch = buffer.empty(h, 65536);
                var got = 0 - 1;
                borrow args as &g in {
                    borrow fs as &fsr in {
                        let (grown, n) = read_file(h, fsr, arg(g, 3 + f), scratch);
                        scratch = grown;
                        got = n;
                    }
                }
                if got < 0 {
                    o = text(h, o, "file ");
                    o = buffer.push_nat(h, o, f + 1);
                    o = text(h, o, ": cannot be read\n");
                } else {
                    let nums = box_slice(h, 20000, 0);
                    var count = 0;
                    var ok = 0;
                    var sb = 0.0;
                    borrow mut nums as &!nw in {
                        let ns = contents(nw);
                        borrow scratch as &s in {
                            let z = buffer.bytes(s);
                            count = jpk.curve_numbers(z, ns, 20000);
                            if count == 0 {
                                let probe = zipread.open(z);
                                o = text(h, o, "file ");
                                o = buffer.push_nat(h, o, f + 1);
                                o = text(h, o, ": REFUSED, tag ");
                                var tag = probe.why;
                                if tag == 0 { tag = 13; }
                                o = buffer.push_nat(h, o, tag);
                                o = text(h, o, " (no curve in the archive)\n");
                            }
                            var c = 0;
                            while c < count {
                                let a = jpk.analyse_curve(h, z, ns[c], rad, win);
                                o = text(h, o, "file ");
                                o = buffer.push_nat(h, o, f + 1);
                                if ns[c] >= 0 { o = text(h, o, " curve "); o = buffer.push_nat(h, o, ns[c]); }
                                o = text(h, o, ": ");
                                if a.why != 0 {
                                    o = text(h, o, "REFUSED, tag ");
                                    o = buffer.push_nat(h, o, a.why);
                                } else {
                                    o = buffer.push_nat(h, o, a.points);
                                    o = text(h, o, " rows, approach ");
                                    o = buffer.push_nat(h, o, a.approach);
                                    o = text(h, o, ", k ");
                                    o = dec(h, o, a.k, 3);
                                    o = text(h, o, " N/m, z from ");
                                    if a.zsrc == 0 { o = text(h, o, "the measured height"); } else { o = text(h, o, "the piezo height"); }
                                    o = text(h, o, ", breakthrough ");
                                    o = dec(h, o, a.a.breakthrough / 1000.0, 2);
                                    o = text(h, o, " nN, E ");
                                    o = dec(h, o, a.a.e0, 1);
                                    o = text(h, o, " MPa, height ");
                                    o = dec(h, o, a.a.height, 2);
                                    o = text(h, o, " nm");
                                    ok = ok + 1;
                                    sb = sb + a.a.breakthrough / 1000.0;
                                }
                                o = text(h, o, "\n");
                                c = c + 1;
                            }
                        }
                    }
                    unbox_slice(h, nums);
                    if count > 0 {
                        o = text(h, o, "file ");
                        o = buffer.push_nat(h, o, f + 1);
                        o = text(h, o, ": ");
                        o = buffer.push_nat(h, o, ok);
                        o = text(h, o, " of ");
                        o = buffer.push_nat(h, o, count);
                        o = text(h, o, " curves analysed");
                        if ok > 0 { o = text(h, o, ", mean breakthrough "); o = dec(h, o, sb / float_of(ok), 2); o = text(h, o, " nN"); }
                        o = text(h, o, "\n");
                    }
                }
                buffer.drop(h, scratch);
                f = f + 1;
            }
        }
        var code = 0;
        borrow mut io as &!w in { borrow o as &b in { code = buffer.write(w, b); } }
        buffer.drop(h, o);
    }
    release(heap);
    release(io);
    release(args);
    release(fs);
    return 0;
}
