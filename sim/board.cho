edition 5;

module board;

import std.math;
import lockin;
import pid;
import raster;
import raster_sine;
import plant;

// `board` -- a software twin of the whole instrument: the register interface of `afm_top` (docs/registers.md) in front of the detector, the
// Z loop with its limit and deadman, the raster, and a model of the fork, the tip and a surface. A host program that talks to the real board
// over the serial port can talk to this instead, with no hardware, and a scenario can run for a million samples in seconds.
//
// What it IS: the validated models of this repository (sim/lockin.cho, sim/pid.cho, sim/raster.cho) wired as afm_top wires them, one ADC
// conversion per step, with the same register indexes, defaults, read-only and unmapped refusals, and response codes. tests/board_test.cho
// checks it against the numbers the Verilog system test gets (the free figure and the settled Z).
// What it is NOT: clock-accurate (a window is applied at once, not 13 clocks later; the SPI masters, the serial link and the DAC refresh are
// not modelled, so a DAC code is what the loop says at once); and the fork, tip and surface are the simplest models with the right shape
// (docs/tune-approach.md), not any real sensor. Results from it are predictions of this software, not measurements.
//
// State lives in three slices the caller owns: rf (64 register words), st (internal integers), fl (plant floats). Index tables:
//   st: 0 phase, 1 acc_i, 2 acc_q, 3 cnt, 4 out_i, 5 out_q, 6 figure, 7 integ, 8 prev, 9 z, 10 fault, 11 wd (clocks since a kick),
//       12 overflow seen, 13 nsamp, 14 nwin, 15 adc0, 16 adc1, 17 r_t, 18 r_line, 19 r_x, 20 r_y, 21 r_done, 22 pixel counter, 23 trace,
//       24 motor busy, 25 motor steps remaining, 26 motor direction (1 = toward the sample), 27 motor clocks into the step, 28 motor position,
//       29 motor step period, 30 last motor command refused
//   fl: 0 amplitude now (pm), 1 f0 (Hz), 2 Q, 3 free amplitude a0 (pm), 4 contact range (pm), 5 grating height (pm), 6 grating period
//       (X DAC codes; 0 = flat), 7 ADC noise (counts), 8 surface drift (pm per window), 9 loopback (1.0: ADC channel 0 reads the Z DAC, the
//       bench wiring of tutorial Part 5), 11 tip-sample distance at Z = 0 (pm; the coarse motor lowers it), 13 pm the tip moves per microstep,
//       10 sample step height (pm; 0 = just the grating, see `surface`),
//       12 Z scanner resonance (Hz; 0 = an ideal scanner that follows the DAC at once), 14 its Q, 15 amplifier slew limit (pm per us; 0 = none),
//       20 sample drift along x (X DAC codes per detector window while scanning), 22 detector windows since the scan started (the drift's clock;
//       8 is the same for Z, pm per window), 21 and 23 unused,
//       24 sample tilt along x (pm per pixel of 100 X codes), 25 tilt along y (pm per scan line), 26 scanner bow (pm at the left and right edges of
//       the 64 pixel line, quadratic about its middle), 27 line offsets (pm; each scan line gets a fixed pseudo-random offset in +-this value: the
//       slow vertical wander a real scanner adds between lines); all 0 for none (the image artifacts of docs/image-processing.md, which the pipeline levels out),
//       16 scanner position (pm), 17 its velocity (pm/s), 18 the slew-limited command (pm), 19 the scanner state has started (1 once it has),
//       32 lever stiffness (N/m; 0 = force not modelled), 33 stiffness of the soft sample (N/m; 0 = rigid), 34 damage threshold (pN; 0 = none), 35 tapping-force proxy now (pN),
//       36 its largest at a detector window since the scan started, 37 windows of the scan over the threshold, 38 the soft sample's indentation under the tip (pm); docs/liquid.md, S9.3,
//       39 optical noise (ADC counts, uniform +-this, scaled by the light level), 40 the sum signal at best alignment (ADC counts; 0 = the optical lever is not modelled),
//       41 alignment (0 to 1: the share of the nominal light and deflection signal that reaches the photodiode), 42 DC wander of the deflection signal (ADC counts per detector window
//       since power-up), 43 loss of light (a fraction of the nominal per detector window); docs/liquid.md, S9.4,
//       28 to 31 the forest of fluid-cell peaks (docs/liquid.md, S9.2): the nearest peak's height over the lever's free amplitude, their spacing (Hz), their Q, how many each side; 0 in 28 = none

pub fn rf_len() -> [] int { return 64; }
pub fn st_len() -> [] int { return 32; }
pub fn fl_len() -> [] int { return 32; }

fn clampi(v: int, lo: int, hi: int) -> [] int {
    if v < lo { return lo; }
    if v > hi { return hi; }
    return v;
}

// a 32-bit register word as a signed number
fn s32(v: int) -> [] int {
    if v >= 2147483648 { return v - 4294967296; }
    return v;
}

fn u32(v: int) -> [] int {
    if v < 0 { return v + 4294967296; }
    return v;
}

fn pow2(n: int) -> [] int {
    var r = 1;
    var i = 0;
    while i < n && i < 31 {
        r = r * 2;
        i = i + 1;
    }
    return r;
}

// Power-on state: every register at its default (docs/registers.md), nothing running, every limit zero.
pub fn reset[&a, &b, &c](rf: &!a [int], st: &!b [int], fl: &!c [float]) -> [] int {
    var i = 0;
    while i < 64 { rf[i] = 0; i = i + 1; }
    i = 0;
    while i < 32 { st[i] = 0; i = i + 1; }
    rf[44] = 27000; rf[3] = 103; rf[4] = 536870912; rf[5] = 256; rf[6] = 2; rf[20] = 32768; rf[21] = 2; rf[22] = 1; rf[27] = 1; rf[31] = 32768;
    fl[0] = 2000.0; fl[1] = 32768.0; fl[2] = 5000.0; fl[3] = 2000.0; fl[4] = 2000.0; fl[5] = 0.0; fl[6] = 0.0; fl[7] = 0.0; fl[8] = 0.0; fl[9] = 0.0; fl[11] = 0.0; fl[13] = 198.4375;
    fl[24] = 0.0; fl[25] = 0.0; fl[26] = 0.0; fl[27] = 0.0; fl[20] = 0.0; fl[21] = 0.0; fl[22] = 0.0; fl[23] = 0.0; fl[12] = 0.0; fl[14] = 0.0; fl[15] = 0.0; fl[16] = 0.0; fl[17] = 0.0; fl[18] = 0.0; fl[19] = 0.0; fl[28] = 0.0; fl[29] = 0.0; fl[30] = 0.0; fl[31] = 0.0;
    fl[32] = 0.0; fl[33] = 0.0; fl[34] = 0.0; fl[35] = 0.0; fl[36] = 0.0; fl[37] = 0.0; fl[38] = 0.0;
    fl[39] = 0.0; fl[40] = 0.0; fl[41] = 1.0; fl[42] = 0.0; fl[43] = 0.0;
    return 0;
}

// The sample: its fork, its tip's contact range, a grating of `height` pm and `period` X-DAC codes (0 for none), ADC noise in counts.
pub fn set_plant[&c](fl: &!c [float], f0: float, q: float, a0: float, contact_range: float, height: float, period: float, noise: float) -> [] int {
    fl[1] = f0; fl[2] = q; fl[3] = a0; fl[4] = contact_range; fl[5] = height; fl[6] = period; fl[7] = noise; fl[0] = a0;
    return 0;
}

// A forest of fluid-cell peaks around the lever (sim/plant.cho `forest`, docs/liquid.md S9.2): the nearest peak's height relative to the lever's free amplitude, the
// spacing in Hz, their Q, and how many on each side. Added to the amplitude and not reduced by contact. rel = 0 (the default) is no forest.
pub fn set_forest[&c](fl: &!c [float], rel: float, spacing: float, q: float, n: int) -> [] int {
    fl[28] = rel; fl[29] = spacing; fl[30] = q; fl[31] = float_of(n);
    return 0;
}

// The lever and a soft sample (docs/liquid.md, S9.3): the lever's stiffness in N/m, the stiffness in N/m of the soft sample (0 = rigid) and the force in pN over which a window
// counts as damaging (0 = never). The force is a PROXY, k times the amplitude the tip has lost to the surface (N/m times pm is pN); the indentation is that force over the
// sample's stiffness, only where the surface is raised (the soft sample on a rigid substrate; a flat sample is soft everywhere). Not a measurement of any lever or sample.
pub fn set_soft[&c](fl: &!c [float], k: float, ks: float, threshold: float) -> [] int {
    fl[32] = k; fl[33] = ks; fl[34] = threshold;
    return 0;
}

// The optical lever (docs/liquid.md, S9.4): the sum signal at best alignment in ADC counts (0 = not modelled and every earlier result), how much of it reaches the photodiode (0 to 1),
// the optical noise in counts, the deflection signal's DC wander in counts per detector window, and the fraction of the light lost per detector window. A GUESS at the shape of what a
// photodiode does, not a model of any laser, lens or lever: it exists so the software meets noise, drift and a misaligned spot before a real one.
pub fn set_optics[&c](fl: &!c [float], sum0: float, align: float, noise: float, wander: float, loss: float) -> [] int {
    fl[40] = sum0; fl[41] = align; fl[39] = noise; fl[42] = wander; fl[43] = loss;
    return 0;
}

// The share of the nominal light still reaching the photodiode now (1 when the optical lever is not modelled): the alignment, less the loss so far, never below 0.
pub fn light[&b, &c](st: &b [int], fl: &c [float]) -> [] float {
    if fl[40] <= 0.0 { return 1.0; }
    var g = fl[41] * (1.0 - fl[43] * float_of(st[14]));
    if g < 0.0 { g = 0.0; }
    return g;
}

// What the photodiode's two slow outputs read, in ADC counts (what S9.5 will make registers): the sum signal, and the deflection's DC level (the mid-scale 0 plus the wander).
pub fn sum_now[&b, &c](st: &b [int], fl: &c [float]) -> [] float {
    return fl[40] * light(st, fl);
}

pub fn deflection_now[&b, &c](st: &b [int], fl: &c [float]) -> [] float {
    if fl[40] <= 0.0 { return 0.0; }
    return fl[42] * float_of(st[14]);
}

// The bench wiring (Part 5): the Z DAC's output goes into ADC channel 0. DA3: 0 to 2.5 V over 16 bits; AD1 at 3.3 V: 12 bits over 0 to 3.3 V.
pub fn set_loopback[&c](fl: &!c [float], on: int) -> [] int {
    fl[9] = float_of(on);
    return 0;
}

// The sample's distance from the tip with Z at 0, pm, and how far one microstep of the coarse motor moves the tip (a 0.635 mm lead screw at
// 1.8 degrees and 1/16 microstepping: 198.4 pm; an assumption about a screw that has not been chosen).
pub fn set_distance[&c](fl: &!c [float], distance: float, pm_per_microstep: float) -> [] int {
    fl[11] = distance;
    fl[13] = pm_per_microstep;
    return 0;
}

// the Z the loop wants out, pm: the clamped loop value, or after a fault the clamped retract value
fn zout[&a, &b](rf: &a [int], st: &b [int]) -> [] int {
    if st[10] == 1 { return clampi(s32(rf[16]), s32(rf[13]), s32(rf[14])); }
    return clampi(st[9], s32(rf[13]), s32(rf[14]));
}

// The Z scanner between the DAC and the tip, as a second-order system (resonance fl[12], Q fl[14]) behind an amplifier slew limit (fl[15]); with fl[12] = 0 it is
// ideal. Sub-stepped so the integration stays stable however fast the resonance is against one conversion. The simplest model with the right shape: a guess
// until a real scanner is measured (docs/high-speed.md, H2). Returns the tip's Z, pm.
fn scanner[&c](fl: &!c [float], u: float, dt: float) -> [] float {
    if fl[12] <= 0.0 { return u; }
    if fl[19] < 0.5 { fl[16] = u; fl[17] = 0.0; fl[18] = u; fl[19] = 1.0; }
    var us = u;
    if fl[15] > 0.0 {
        let lim = fl[15] * dt * 1000000.0;
        let d = u - fl[18];
        if d > lim { us = fl[18] + lim; }
        else if d < 0.0 - lim { us = fl[18] - lim; }
    }
    fl[18] = us;
    let w = 6.283185307179586 * fl[12];
    var q = fl[14];
    if q < 0.01 { q = 0.01; }
    var ns = truncate(w * dt / 0.1) + 1;
    if ns > 200 { ns = 200; }
    let h = dt / float_of(ns);
    var k = 0;
    while k < ns {
        fl[17] = fl[17] + h * (w * w * (us - fl[16]) - w / q * fl[17]);
        fl[16] = fl[16] + h * fl[17];
        k = k + 1;
    }
    return fl[16];
}

// the surface height under the tip, pm
fn surface[&a, &b, &c](rf: &a [int], st: &b [int], fl: &c [float]) -> [] float {
    // the sample drifts under the tip: along x by fl[20] codes and in height by fl[8] pm for every detector window since the scan started
    return surface0(rf, st, fl) + fl[8] * fl[22] + artifacts(st, fl);
}

// The image artifacts: a tilt, a bow along the fast axis and an offset of its own for every scan line (a hash of the line number, so the same line always gets the same offset)
fn artifacts[&b, &c](st: &b [int], fl: &c [float]) -> [] float {
    let px = float_of(st[19]) / 100.0;
    let u = (px - 31.5) / 31.5;
    let k = (st[18] * 37 + 11) % 17;
    return fl[24] * px + fl[25] * float_of(st[18]) + fl[26] * u * u + fl[27] * float_of(k - 8) / 8.0;
}

fn surface0[&a, &b, &c](rf: &a [int], st: &b [int], fl: &c [float]) -> [] float {
    if fl[6] <= 0.0 { return 0.0; }
    let x = float_of(st[19]) + fl[20] * fl[22];
    let g = fl[5] / 2.0 * (1.0 + math.sin(6.283185307179586 * x / fl[6]));
    if fl[10] <= 0.0 { return g; }
    // a made-up sample when fl[10] > 0 (the step height, pm): the grating, a terrace edge across the scan, and three particles
    // (raised-cosine bumps, 4 x the step in height, 400 X/Y DAC codes in radius) at fixed places; nothing measured, shapes only
    let y = float_of(st[20]);
    var h = g;
    if y >= 3500.0 { h = h + fl[10]; }
    h = h + bump(x, y, 2200.0, 2300.0, 4.0 * fl[10]) + bump(x, y, 4200.0, 2800.0, 3.0 * fl[10]) + bump(x, y, 3300.0, 4300.0, 4.0 * fl[10]);
    return h;
}

fn bump(x: float, y: float, cx: float, cy: float, h: float) -> [] float {
    let d2 = ((x - cx) * (x - cx) + (y - cy) * (y - cy)) / 160000.0;
    if d2 >= 1.0 { return 0.0; }
    return h * (1.0 - d2) * (1.0 - d2);
}

// What the host sees when the run bit, the scan bit or the ADC bit is off: the blocks they gate are held in reset.
fn resets[&a, &b](rf: &a [int], st: &!b [int]) -> [] int {
    let run = rf[1] % 2;
    let scan = rf[1] / 4 % 2;
    let adc = rf[1] / 16 % 2;
    if run == 0 {
        st[7] = 0; st[8] = 0; st[9] = s32(rf[15]); st[10] = 0; st[11] = 0; st[12] = 0;
    }
    // the sinusoidal raster (SINE, CTRL bit 6) and the triangle one are two blocks; the one not selected is held in reset, so a switch starts the other afresh
    let sine = rf[1] / 64 % 2;
    if sine != st[31] {
        st[31] = sine;
        st[17] = 0; st[18] = 0; st[19] = rf[23]; st[20] = rf[24]; st[21] = 0; st[22] = 0;
    }
    if run == 0 || scan == 0 {
        st[17] = 0; st[18] = 0; st[19] = rf[23]; st[20] = rf[24]; st[21] = 0; st[22] = 0;
    }
    // the motor driver stops at once when disabled, and (see step_one) when the deadman has latched
    if rf[1] / 32 % 2 == 0 { st[24] = 0; st[25] = 0; st[27] = 0; }
    if adc == 0 {
        st[0] = 0; st[1] = 0; st[2] = 0; st[3] = 0; st[13] = 0; st[14] = 0; st[15] = 0; st[16] = 0;
    }
    return 0;
}

// 0 = OKAY, 2 = SLVERR, like the serial bridge: a write to a read-only or unmapped register is refused and changes nothing.
pub fn write[&a, &b](rf: &!a [int], st: &!b [int], idx: int, value: int) -> [] int {
    if idx < 0 || idx > 51 { return 2; }
    if idx == 0 || idx == 2 || (idx >= 32 && idx <= 42) || idx == 45 || idx == 46 || idx == 50 || idx == 51 { return 2; }
    if idx == 18 {
        st[11] = 0;
        return 0;
    }
    if idx == 43 {
        // a command is refused if it is longer than MOTOR_MAX (0 after power-on: nothing may move until the host allows it); otherwise it
        // starts only when the driver is enabled, not held by a fault, idle, and the command is not zero
        let v = s32(value);
        var mag = v;
        if v < 0 { mag = 0 - v; }
        if mag > rf[47] {
            st[30] = 1;
        } else {
            st[30] = 0;
            if rf[1] / 32 % 2 == 1 && st[10] == 0 && st[24] == 0 && v != 0 {
                st[24] = 1; st[25] = mag; st[27] = 0;
                if v > 0 { st[26] = 1; } else { st[26] = 0; }
                var per = rf[44];
                if per < 4 { per = 4; }
                st[29] = per;
            }
        }
        return 0;
    }
    if idx == 1 || (idx >= 3 && idx <= 17) || (idx >= 19 && idx <= 31) || idx == 44 || idx == 47 || idx == 48 || idx == 49 {
        rf[idx] = value % 4294967296;
        // blocks held in reset load their start values continuously (x0, y0, zinit), so any write can change what a held block shows
        resets(rf, st);
        return 0;
    }
    return 2;
}

// (value, response) of a read, like the serial bridge.
pub fn read[&a, &b](rf: &a [int], st: &b [int], idx: int) -> [] (int, int) {
    if idx == 0 { return (0xAF500001, 0); }
    if idx == 2 {
        let status = st[10] + st[12] * 4 + st[21] * 8;
        return (status, 0);
    }
    if idx == 18 { return (0, 0); }
    if idx == 1 || (idx >= 3 && idx <= 17) || (idx >= 19 && idx <= 31) { return (rf[idx], 0); }
    if idx == 32 { return (st[6], 0); }
    if idx == 33 { return (u32(zout(rf, st)), 0); }
    if idx == 34 { return (st[19], 0); }
    if idx == 35 { return (st[20], 0); }
    if idx == 36 { return (u32(st[4]), 0); }
    if idx == 37 { return (u32(st[5]), 0); }
    if idx == 38 { return (st[15], 0); }
    if idx == 39 { return (st[16], 0); }
    if idx == 40 { return (st[13], 0); }
    if idx == 41 { return (st[14], 0); }
    if idx == 42 { return (st[17] % 65536 * 65536 + st[18] % 65536, 0); }
    if idx == 43 { return (0, 0); }
    if idx == 44 || idx == 47 || idx == 48 || idx == 49 { return (rf[idx], 0); }
    if idx == 45 { return (st[24] + rf[1] / 32 % 2 * 2 + st[30] * 4, 0); }
    if idx == 46 { return (u32(st[28]), 0); }
    if idx == 50 || idx == 51 { return (rf[idx], 0); }
    return (0, 2);
}

fn step_one[&a, &b, &c](rf: &!a [int], st: &!b [int], fl: &!c [float]) -> [] int {
    resets(rf, st);
    let run = rf[1] % 2;
    let scan = rf[1] / 4 % 2;
    if run == 0 || scan == 0 { fl[22] = 0.0; fl[36] = 0.0; fl[37] = 0.0; }
    let manual = rf[1] / 8 % 2;
    let adc = rf[1] / 16 % 2;
    let sdiv = sample_clocks(rf);
    // the deadman counts clocks while the loop is enabled
    if run == 1 {
        st[11] = st[11] + sdiv;
        if rf[17] != 0 && st[11] >= rf[17] { st[10] = 1; }
    }
    // the coarse motor: one step per period of MOTOR_RATE clocks; a fault stops it
    if st[24] == 1 {
        if st[10] == 1 {
            st[24] = 0; st[25] = 0; st[27] = 0;
        } else {
            st[27] = st[27] + sdiv;
            while st[27] >= st[29] && st[24] == 1 {
                st[27] = st[27] - st[29];
                st[25] = st[25] - 1;
                if st[26] == 1 {
                    st[28] = st[28] + 1;
                    fl[11] = fl[11] - fl[13];
                } else {
                    st[28] = st[28] - 1;
                    fl[11] = fl[11] + fl[13];
                }
                if st[25] == 0 { st[24] = 0; }
            }
        }
    }
    if adc == 0 { rf[50] = 0; rf[51] = 0; return 0; }
    let fs = 27000000.0 / float_of(sdiv);
    let fref = float_of(rf[4]) / 4294967296.0 * fs;
    var zc = zout(rf, st) / 16;
    if manual == 1 { zc = rf[28] % 65536; }
    let ztip = scanner(fl, float_of(zc * 16), float_of(sdiv) / 27000000.0);
    let sfc = surface(rf, st, fl);
    let gap = ztip + fl[11] - sfc + fl[38];
    let lever = plant.response(fref, fl[1], fl[2], fl[3]);
    let touch = plant.contact(gap, fl[4]);
    // the tapping-force proxy and the soft sample's indentation, eased in so the loop through the gap stays stable (S9.3)
    fl[35] = fl[32] * lever * (1.0 - touch);
    var soft = 1.0;
    if fl[5] > 0.0 { soft = sfc / fl[5]; }
    if soft < 0.0 { soft = 0.0; }
    if soft > 1.0 { soft = 1.0; }
    var dent = 0.0;
    if fl[33] > 0.0 { dent = fl[35] / fl[33] * soft; }
    fl[38] = fl[38] + 0.2 * (dent - fl[38]);
    let target = lever * touch + plant.forest(fref, fl[1], fl[3], fl[28], fl[29], fl[30], truncate(fl[31]));
    var alpha = 3.141592653589793 * fl[1] / (fl[2] * fs);
    if alpha > 1.0 { alpha = 1.0; }
    fl[0] = plant.lag(fl[0], target, alpha);
    // the converter: 12 bits, mid-scale 2048, the signal at the reference's own phase
    let ph = 6.283185307179586 * float_of(st[0]) / 4294967296.0;
    var v = 2048.0 + deflection_now(st, fl) + 0.5 * fl[0] * light(st, fl) * math.sin(ph + 0.5);
    let nzo = truncate(fl[39] * light(st, fl) + 0.5);
    if nzo > 0 {
        v = v + float_of((st[13] * 22695477 + 1) / 65536 % (2 * nzo + 1) - nzo);
    }
    let nzi = truncate(fl[7]);
    if nzi > 0 {
        v = v + float_of((st[13] * 1103515245 + 12345) / 65536 % (2 * nzi + 1) - nzi);
    }
    var code = truncate(math.round(v));
    code = clampi(code, 0, 4095);
    if fl[9] > 0.5 {
        code = truncate(math.round(float_of(zc) / 65536.0 * 2.5 / 3.3 * 4096.0));
        code = clampi(code, 0, 4095);
    }
    st[15] = code;
    st[16] = 1234;
    // the Pmod AD1's two conversions (OPT_DEFL, OPT_SUM, docs/liquid.md S9.5): in the SPI mode they are the two channels the detector reads (ADC0, ADC1); in the parallel mode
    // they exist only when CTRL.OPT_RUN is set (the converter runs beside the parallel one) and then carry the optical lever's deflection DC level and sum signal, in counts
    // (0 where the optics are not modelled: nothing is wired to the AD1)
    if rf[1] / 128 % 2 == 0 { rf[50] = code; rf[51] = 1234; }
    else if rf[1] / 256 % 2 == 1 {
        rf[50] = clampi(truncate(math.round(2048.0 + deflection_now(st, fl))), 0, 4095);
        rf[51] = clampi(truncate(math.round(sum_now(st, fl))), 0, 4095);
    }
    st[13] = st[13] + 1;
    let ls = lockin.step(lockin.L { phase: st[0], acc_i: st[1], acc_q: st[2], cnt: st[3], done: 0, out_i: st[4], out_q: st[5], amp: st[6] }, code - 2048, rf[4], rf[5]);
    st[0] = ls.phase; st[1] = ls.acc_i; st[2] = ls.acc_q; st[3] = ls.cnt;
    if ls.done == 1 {
        st[4] = ls.out_i; st[5] = ls.out_q; st[6] = ls.amp; st[14] = st[14] + 1;
        if scan == 1 && fl[22] > 0.0 {
            if fl[35] > fl[36] { fl[36] = fl[35]; }
            if fl[34] > 0.0 && fl[35] > fl[34] { fl[37] = fl[37] + 1.0; }
        }
        var big = 0;
        if ls.out_i > 8388607 || ls.out_i < 0 - 8388607 || ls.out_q > 8388607 || ls.out_q < 0 - 8388607 { big = 1; }
        if run == 1 && big == 1 { st[12] = 1; }
        if run == 1 && big == 0 && st[10] == 0 {
            // one loop step per detector window: error = (figure >> shift) - setpoint
            let fig = ls.amp / pow2(rf[7]);
            let err = fig - s32(rf[8]);
            let ps = pid.step(pid.State { integ: st[7], prev: st[8], z: st[9] }, err, rf[9], rf[10], rf[11], rf[12], s32(rf[13]), s32(rf[14]));
            st[7] = ps.integ; st[8] = ps.prev; st[9] = ps.z;
            if scan == 1 {
                fl[22] = fl[22] + 1.0;
                var pd = rf[27];
                if pd < 1 { pd = 1; }
                if st[22] + 1 >= pd {
                    st[22] = 0;
                    if rf[1] / 64 % 2 == 1 {
                        // the phase is st[17], the slow axis y is st[20]; x follows the phase
                        let q = raster_sine.step(raster_sine.S { phase: st[17], line: st[18], y: st[20], done: st[21] }, rf[49] % 131072, rf[22], rf[26]);
                        st[17] = q.phase; st[18] = q.line; st[20] = q.y; st[21] = q.done;
                        st[19] = raster_sine.x_of(q, rf[23], rf[48] % 65536);
                    } else {
                        let r = raster.step(raster.R { t: st[17], line: st[18], x: st[19], y: st[20], done: st[21] }, rf[21], rf[22], rf[23], rf[25], rf[26]);
                        st[17] = r.t; st[18] = r.line; st[19] = r.x; st[20] = r.y; st[21] = r.done;
                    }
                } else {
                    st[22] = st[22] + 1;
                }
            }
        }
    }
    return 0;
}

// Run `n` ADC conversions of simulated time (one conversion = SAMPLE_DIV clocks, 103 by default: 262 kS/s).
pub fn advance[&a, &b, &c](rf: &!a [int], st: &!b [int], fl: &!c [float], n: int) -> [] int {
    var k = 0;
    while k < n {
        step_one(rf, st, fl);
        k = k + 1;
    }
    return 0;
}

// FPGA clocks per ADC sample: SAMPLE_DIV for the Pmod AD1, 2 x HALF for the parallel AD9226 interface (CTRL bit 7, docs/registers.md). The AD9226's 7-sample pipeline delay is NOT modelled
// (the detector is phase-blind; the delay is 7 samples of loop latency, under 3% of a 256-sample window).
pub fn sample_clocks[&a](rf: &a [int]) -> [] int {
    if rf[1] / 128 % 2 == 1 {
        var h = rf[6] % 256;
        if h < 1 { h = 1; }
        return 2 * h;
    }
    if rf[3] < 1 { return 1; }
    return rf[3];
}

// The same, in FPGA clocks.
pub fn advance_clocks[&a, &b, &c](rf: &!a [int], st: &!b [int], fl: &!c [float], clocks: int) -> [] int {
    return advance(rf, st, fl, clocks / sample_clocks(rf));
}

// The tip's Z now, pm, as the scanner model has it (the DAC's own value when the scanner is ideal), for tests and the host.
pub fn z_actual[&a, &b, &c](rf: &a [int], st: &b [int], fl: &c [float]) -> [] float {
    if fl[12] <= 0.0 { return float_of(z_code(rf, st) * 16); }
    return fl[16];
}

// A Z scanner: its resonance (Hz), Q, and the amplifier's slew limit (pm per us, 0 for none). Resonance 0 is the ideal scanner.
pub fn set_scanner[&c](fl: &!c [float], f_res: float, q: float, slew: float) -> [] int {
    fl[12] = f_res; fl[14] = q; fl[15] = slew; fl[19] = 0.0;
    return 0;
}

// The Z DAC code the board would be holding (Z / 16, or the manual register), the X and Y codes, for tests and the host.
pub fn z_code[&a, &b](rf: &a [int], st: &b [int]) -> [] int {
    if rf[1] / 8 % 2 == 1 { return rf[28] % 65536; }
    return zout(rf, st) / 16;
}

pub fn surface_at[&a, &b, &c](rf: &a [int], st: &b [int], fl: &c [float]) -> [] float {
    return surface(rf, st, fl);
}
