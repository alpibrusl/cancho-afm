edition 5;

module fcload;

// `fcload` -- real force curves in, the analysis of sim/forcecurve.cho out (docs/dynamics.md). Reads the generic two-column text a force curve is usually exported as (the format of nanoindent's `read_csv`: z
// and deflection, comma, tab, semicolon or space separated, header lines skipped), puts it in nanometres, orients it the way nanoindent does and cuts it at the turn-around, so that what reaches
// `forcecurve.slb_curve_nb` is a curve it can analyse. NOT TESTED ON ANY REAL FILE: the tests use text written in the tests.
//
// What it does to a file, in order:
//   1. every line is split on commas, tabs, semicolons and spaces; the first two fields are read as numbers (sign, digits, a point, digits, an exponent); a line where either is not a number (a header, a
//      blank line, a unit line) is skipped;
//   2. z and deflection are multiplied to nanometres (`zscale`, `dscale`: 1 for nm, 1e9 for m, 1e3 for um);
//   3. NO THINNING by default (`thin` 1): every row is kept, on the heap, whatever the length, up to `max_rows()` (4,000,000: a longer file is refused, tag 10). `thin` n > 1 keeps every nth row (see below for why
//      you may want that: the breakthrough rule is a SINGLE-STEP force drop, so the rows' spacing matters);
//   4. ORIENTATION as nanoindent's `to_force_indentation`: if z and the deflection are negatively correlated, z is flipped, so that pushing is z increasing and the deflection rising;
//   5. the APPROACH is the rows up to the largest oriented z, assuming the file starts with the approach (a retract before it would be read as the approach): the rest (the retract) is dropped;
//   6. z is then written as -(oriented z), because forcecurve.slb_curve_nb takes z decreasing toward the sample.
// A file with fewer than `min_points` approach rows is refused, tag 9, one with more than `max_rows()` rows tag 10 (forcecurve's own tags are 1 to 6).

import std.math;
import forcecurve;

pub fn min_points() -> [] int { return 80; }
pub fn max_rows() -> [] int { return 4000000; }

pub struct Tok { ok: int, v: float, end: int }

fn is_digit(c: int) -> [] int {
    if c >= 48 && c <= 57 { return 1; }
    return 0;
}

fn is_sep(c: int) -> [] int {
    // space, tab, comma, semicolon, carriage return
    if c == 32 || c == 9 || c == 44 || c == 59 || c == 13 { return 1; }
    return 0;
}

// the number that starts at `from` and ends at a separator, a newline or the end of the text; ok 0 when it is not entirely a number
pub fn parse_number[&a](text: &a [byte], from: int, to: int) -> [] Tok {
    var i = from;
    var neg = 0;
    if i < to && (int_of(text[i]) == 45 || int_of(text[i]) == 43) {
        if int_of(text[i]) == 45 { neg = 1; }
        i = i + 1;
    }
    var mant = 0.0;
    var digits = 0;
    while i < to && is_digit(int_of(text[i])) == 1 {
        mant = mant * 10.0 + float_of(int_of(text[i]) - 48);
        digits = digits + 1;
        i = i + 1;
    }
    if i < to && int_of(text[i]) == 46 {
        i = i + 1;
        var scale = 0.1;
        while i < to && is_digit(int_of(text[i])) == 1 {
            mant = mant + scale * float_of(int_of(text[i]) - 48);
            scale = scale * 0.1;
            digits = digits + 1;
            i = i + 1;
        }
    }
    if digits == 0 { return Tok { ok: 0, v: 0.0, end: i }; }
    var ex = 0;
    if i < to && (int_of(text[i]) == 101 || int_of(text[i]) == 69) {
        i = i + 1;
        var eneg = 0;
        if i < to && (int_of(text[i]) == 45 || int_of(text[i]) == 43) {
            if int_of(text[i]) == 45 { eneg = 1; }
            i = i + 1;
        }
        var ed = 0;
        while i < to && is_digit(int_of(text[i])) == 1 {
            ex = ex * 10 + (int_of(text[i]) - 48);
            ed = ed + 1;
            i = i + 1;
        }
        if ed == 0 { return Tok { ok: 0, v: 0.0, end: i }; }
        if eneg == 1 { ex = 0 - ex; }
    }
    // the token must end here
    if i < to && is_sep(int_of(text[i])) == 0 { return Tok { ok: 0, v: 0.0, end: i }; }
    var v = mant;
    if ex != 0 { v = mant * math.pow(10.0, float_of(ex)); }
    if neg == 1 { v = 0.0 - v; }
    return Tok { ok: 1, v: v, end: i };
}

// the first two numeric fields of the line text[from..to): (z, d) in out[0], out[1]; returns 1 when both were found
fn parse_line[&a, &b](text: &a [byte], from: int, to: int, out: &!b [float]) -> [] int {
    var i = from;
    var got = 0;
    while i < to && got < 2 {
        while i < to && is_sep(int_of(text[i])) == 1 { i = i + 1; }
        if i >= to { return 0; }
        let t = parse_number(text, i, to);
        if t.ok == 0 { return 0; }
        out[got] = t.v;
        got = got + 1;
        i = t.end;
    }
    return 1;
}

// how many lines of the text hold a (z, d) pair
pub fn count_rows[&a](text: &a [byte]) -> [] int {
    var n = 0;
    var i = 0;
    var start = 0;
    region r {
        let two = alloc_slice[r](2, 0.0);
        while i <= len(text) {
            if i == len(text) || int_of(text[i]) == 10 {
                if i > start { n = n + parse_line(text, start, i, two); }
                start = i + 1;
            }
            i = i + 1;
        }
    }
    return n;
}

// Read the rows (every `stride`-th) into z and d (capacity `cap`), in nm; returns how many were stored.
pub fn read_rows[&a, &b, &c](text: &a [byte], stride: int, zscale: float, dscale: float, z: &!b [float], d: &!c [float], cap: int) -> [] int {
    var n = 0;
    var seen = 0;
    var i = 0;
    var start = 0;
    region r {
        let two = alloc_slice[r](2, 0.0);
        while i <= len(text) {
            if i == len(text) || int_of(text[i]) == 10 {
                if i > start && parse_line(text, start, i, two) == 1 {
                    if seen % stride == 0 && n < cap {
                        z[n] = two[0] * zscale;
                        d[n] = two[1] * dscale;
                        n = n + 1;
                    }
                    seen = seen + 1;
                }
                start = i + 1;
            }
            i = i + 1;
        }
    }
    return n;
}

// Orient and cut: returns the number of approach points, with z rewritten as -(oriented z) (decreasing toward the sample). 0 means a curve with no variation to orient.
pub fn approach[&a, &b](z: &!a [float], d: &!b [float], n: int) -> [] int {
    if n < 3 { return n; }
    var mz = 0.0;
    var md = 0.0;
    var i = 0;
    while i < n { mz = mz + z[i]; md = md + d[i]; i = i + 1; }
    mz = mz / float_of(n);
    md = md / float_of(n);
    var sxy = 0.0;
    i = 0;
    while i < n { sxy = sxy + (z[i] - mz) * (d[i] - md); i = i + 1; }
    var s = 1.0;
    if sxy < 0.0 { s = 0.0 - 1.0; }
    // the turn-around: the largest oriented z
    var top = 0;
    i = 1;
    while i < n {
        if s * z[i] > s * z[top] { top = i; }
        i = i + 1;
    }
    i = 0;
    while i <= top { z[i] = 0.0 - s * z[i]; i = i + 1; }
    return top + 1;
}

// the analysis of an oriented approach (n points): forcecurve.slb_curve_nb with the settings sim/fcmodels.cho uses, so that a real curve and a library curve are read the same way: 40 baseline points,
// contact at 8 noise levels, a breakthrough of at least 400 pN, a film of 4.5 nm; refused (tag 9) when there are fewer than min_points
pub fn analyse[&a, &b](z: &a [float], d: &b [float], n: int, k: float, r: float) -> [] forcecurve.Slb {
    return analyse_w(z, d, n, k, r, 0.0);
}

// analyse with the breakthrough rule chosen: window_nm 0 is nanoindent's single-step drop between consecutive rows; window_nm > 0 the largest drop within that much piezo travel (forcecurve.slb_curve_win),
// which does not depend on the row spacing
pub fn analyse_w[&a, &b](z: &a [float], d: &b [float], n: int, k: float, r: float, window_nm: float) -> [] forcecurve.Slb {
    if n < min_points() {
        return forcecurve.Slb { why: 9, breakthrough: 0.0, height: 0.0, height_a: 0.0, contact_z: 0.0, e0: 0.0, e1: 0.0, e2: 0.0, e3: 0.0, kappa_a: 0.0, n_elastic: 0 };
    }
    return forcecurve.slb_curve_win(z, d, n, 40, k, r, 0.5, 8.0, 400.0, 4.5, 0.0, window_nm);
}

// ---- the spread of an experiment's summaries, measured from the experiment itself ----
// A real set of curves is heterogeneous in a way the twin's is not, and the twin's narrow spread then rejects every model. The measured spread is the BOOTSTRAP of the curves: resample the n curves with
// replacement `boots` times, recompute the seven summaries of each resample, and take their variance. It is the sampling variance of the experiment's summaries given its own heterogeneity (it says nothing
// about drift between sessions or a tip that changed, which a single set cannot show).
// per: n rows of 6 floats, one per curve: [analysed (1/0), breakthrough nN, Hertz E, model-1 E, height nm, kappa_A]. out: 8 floats, the variance of each of the seven summaries (the order of
// sim/fcmodels.cho: mean breakthrough, mean E, mean model-1 E, mean height, mean kappa_A, sd of breakthrough, the share analysed). A resample with no analysed curve is skipped.
pub fn bootstrap[&a, &b](per: &a [float], n: int, boots: int, seed: int, out: &!b [float]) -> [] int {
    var j = 0;
    while j < 8 { out[j] = 0.0; j = j + 1; }
    if n < 2 { return 0; }
    var used = 0;
    region r {
        let s1 = alloc_slice[r](8, 0.0);
        let s2 = alloc_slice[r](8, 0.0);
        var bi = 0;
        while bi < boots {
            var ok = 0;
            var sb = 0.0;
            var sb2 = 0.0;
            var se0 = 0.0;
            var se1 = 0.0;
            var sh = 0.0;
            var sk = 0.0;
            var c = 0;
            while c < n {
                // a fixed hash of (resample, draw, seed) picks the curve
                var u = math.sin(12.9898 * float_of(bi * 7919 + c) + 78.233 * float_of(seed) + 4.1414) * 43758.5453;
                if u < 0.0 { u = 0.0 - u; }
                u = u - math.floor(u);
                var pick = truncate(u * float_of(n));
                if pick > n - 1 { pick = n - 1; }
                if per[pick * 6] > 0.5 {
                    let b = per[pick * 6 + 1];
                    sb = sb + b;
                    sb2 = sb2 + b * b;
                    se0 = se0 + per[pick * 6 + 2];
                    se1 = se1 + per[pick * 6 + 3];
                    sh = sh + per[pick * 6 + 4];
                    sk = sk + per[pick * 6 + 5];
                    ok = ok + 1;
                }
                c = c + 1;
            }
            if ok > 0 {
                let f = float_of(ok);
                var v5 = sb2 / f - (sb / f) * (sb / f);
                if v5 < 0.0 { v5 = 0.0; }
                s1[0] = sb / f; s1[1] = se0 / f; s1[2] = se1 / f; s1[3] = sh / f; s1[4] = sk / f; s1[5] = math.sqrt(v5); s1[6] = f / float_of(n);
                j = 0;
                while j < 7 { s2[j] = s2[j] + s1[j]; out[j] = out[j] + s1[j] * s1[j]; j = j + 1; }
                used = used + 1;
            }
            bi = bi + 1;
        }
        if used > 1 {
            j = 0;
            while j < 7 {
                let mu = s2[j] / float_of(used);
                var v = (out[j] - float_of(used) * mu * mu) / float_of(used - 1);
                if v < 0.0 { v = 0.0; }
                out[j] = v;
                j = j + 1;
            }
        } else {
            j = 0;
            while j < 8 { out[j] = 0.0; j = j + 1; }
        }
    }
    return used;
}

// ---- a whole file, any length ----
pub struct Loaded { a: forcecurve.Slb, rows: int, kept: int, approach: int, stride: int }

// Everything a host does with one curve's text: count the rows, keep every `thin`-th (1 = all) on the heap, orient and cut at the turn-around, analyse. The heap arrays are freed before it returns.
pub fn load_and_analyse[&hp, &t](heap: &!hp Heap, text: &t [byte], thin: int, zscale: float, dscale: float, k: float, r: float, window_nm: float) -> [heap] Loaded {
    let rows = count_rows(text);
    var stride = thin;
    if stride < 1 { stride = 1; }
    if rows > max_rows() {
        return Loaded { a: forcecurve.Slb { why: 10, breakthrough: 0.0, height: 0.0, height_a: 0.0, contact_z: 0.0, e0: 0.0, e1: 0.0, e2: 0.0, e3: 0.0, kappa_a: 0.0, n_elastic: 0 }, rows: rows, kept: 0, approach: 0, stride: stride };
    }
    let cap = (rows + stride - 1) / stride + 1;
    let zb = box_slice(heap, cap, 0.0);
    let db = box_slice(heap, cap, 0.0);
    var out = Loaded { a: forcecurve.Slb { why: 9, breakthrough: 0.0, height: 0.0, height_a: 0.0, contact_z: 0.0, e0: 0.0, e1: 0.0, e2: 0.0, e3: 0.0, kappa_a: 0.0, n_elastic: 0 }, rows: rows, kept: 0, approach: 0, stride: stride };
    borrow mut zb as &!zw in {
        borrow mut db as &!dw in {
            let z = contents(zw);
            let d = contents(dw);
            let n_in = read_rows(text, stride, zscale, dscale, z, d, cap);
            let na = approach(z, d, n_in);
            let a = analyse_w(z, d, na, k, r, window_nm);
            out = Loaded { a: a, rows: rows, kept: n_in, approach: na, stride: stride };
        }
    }
    unbox_slice(heap, db);
    unbox_slice(heap, zb);
    return out;
}
