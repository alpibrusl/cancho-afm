edition 5;

module tune;

// `tune` -- from a frequency sweep to the settings the loop needs. Host-side, pure functions: the caller does the measuring (sets the
// drive, waits, reads the detector) and passes the readings in. NOT TESTED ON ANY REAL SENSOR; the main risk of docs/design.md section 3.
//
//   analyse: find the resonance in a sweep: its frequency (parabola through the peak and its neighbours), its Q (the half-power
//            width, by linear interpolation), and refuse, with a reason, when the sweep cannot be trusted.
//   choose:  from that, the drive frequency, the setpoint (a fraction of the free amplitude) and the loop gains, with the rule written out.

// why: 0 ok; 1 the peak is at an edge of the sweep (widen or shift it); 2 no resonance (the peak is not well above the floor);
//      3 the sweep does not bracket both half-power points; 4 the three points at the peak are degenerate
pub struct T { ok: int, why: int, f0: float, q: float, peak: float }

fn fail(why: int) -> [] T {
    return T { ok: 0, why: why, f0: 0.0, q: 0.0, peak: 0.0 };
}

pub fn analyse[&a, &b](f: &a [float], r: &b [float], n: int) -> [] T {
    var m = 0;
    var floor = r[0];
    var i = 1;
    while i < n {
        if r[i] > r[m] { m = i; }
        if r[i] < floor { floor = r[i]; }
        i = i + 1;
    }
    if m == 0 || m == n - 1 {
        return fail(1);
    }
    let peak = r[m];
    var base = floor;
    if base < 1.0 { base = 1.0; }
    if peak < 5.0 * base {
        return fail(2);
    }
    let h = f[m + 1] - f[m];
    let denom = r[m - 1] - 2.0 * r[m] + r[m + 1];
    if denom >= 0.0 {
        return fail(4);
    }
    let f0 = f[m] + 0.5 * h * (r[m - 1] - r[m + 1]) / denom;
    let level = peak / sqrt(2.0);
    // walk left from the peak to the first point at or below the half-power level
    var l = m;
    while l > 0 && r[l] > level { l = l - 1; }
    if r[l] > level {
        return fail(3);
    }
    var u = m;
    while u < n - 1 && r[u] > level { u = u + 1; }
    if r[u] > level {
        return fail(3);
    }
    let fl = f[l] + (level - r[l]) / (r[l + 1] - r[l]) * (f[l + 1] - f[l]);
    let fu = f[u - 1] + (r[u - 1] - level) / (r[u - 1] - r[u]) * (f[u] - f[u - 1]);
    return T { ok: 1, why: 0, f0: f0, q: f0 / (fu - fl), peak: peak };
}

// what the loop is told: the drive frequency; a right-shift `shift` applied to the detector figure before the loop (so the gains have
// room: see choose); the setpoint in shifted counts; Q8 gains for sim/pid.cho and gen/pid_ir.cho; the loop gain that results
pub struct G { drive_hz: float, shift: int, setpoint: int, kp: int, ki: int, alpha: float, gloop: float }

fn rounded(x: float) -> [] int {
    return truncate(x + 0.5);
}

// The rule. The cantilever answers a change of height with a lag of tau = Q / (pi f0); the loop gets one new reading per detector
// window (`window_s` seconds), so alpha = window_s / tau of the way there each time. With the plant gain k counts per pm (after the
// shift: k / 2^shift) and a proportional step of kp/256 of the error, the loop gain per sample is G = kp * k_eff / 256. G is aimed at
// alpha / 2 (never more than 0.5), which keeps the loop stable against that lag.
//
// Q8 gains are coarse: with 16 counts per pm the smallest G is 16/256 = 0.06, six times too much for a tuning fork. So the host
// shifts the figure right by the smallest `shift` that gives kp at least 8 (about 12% resolution), then kp = round(256 G / k_eff).
//
// Integral gain: the integral time Ti = kp / ki samples must be well over the loop's own time (about 1 / alpha samples) or the integral
// term destabilises it (found by simulation: ki = kp / 8, an integral time of 8 samples against a plant lag of 40, made the loop swing
// between its stops). So ki = round(kp * alpha / 8), a Ti of 8 / alpha samples, which is 0 (a proportional-only loop) whenever Q8
// gains are too coarse for it: ki = 1 is already Ti = kp. A P-only loop follows a moving surface with a lag of slope / G and has no
// steady offset against a fixed one, which is enough for slow scans; a finer gain format (16-bit gains over 65536) would give a slow
// integral at any kp, and is a possible change to gen/pid_ir.cho, not made. `frac` is the setpoint as a fraction of the free amplitude.
pub fn choose(t: T, k: float, window_s: float, frac: float) -> [] G {
    let tau = t.q / (3.141592653589793 * t.f0);
    var alpha = window_s / tau;
    if alpha > 1.0 { alpha = 1.0; }
    var target = alpha / 2.0;
    if target > 0.5 { target = 0.5; }
    var shift = 0;
    var keff = k;
    while 256.0 * target / keff < 8.0 && shift < 20 {
        shift = shift + 1;
        keff = keff / 2.0;
    }
    var kp = rounded(256.0 * target / keff);
    if kp < 1 { kp = 1; }
    if kp > 4095 { kp = 4095; }
    let ki = rounded(float_of(kp) * alpha / 8.0);
    var div = 1.0;
    var i = 0;
    while i < shift {
        div = div * 2.0;
        i = i + 1;
    }
    return G { drive_hz: t.f0, shift: shift, setpoint: truncate(frac * t.peak / div), kp: kp, ki: ki, alpha: alpha, gloop: float_of(kp) * keff / 256.0 };
}
