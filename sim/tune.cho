edition 5;

module tune;

// `tune` -- from a frequency sweep to the settings the loop needs. Host-side, pure functions: the caller does the measuring (sets the
// drive, waits, reads the detector) and passes the readings in. NOT TESTED ON ANY REAL SENSOR; the main risk of docs/design.md section 3.
//
//   analyse: find the resonance in a sweep: its frequency (parabola through the peak and its neighbours), its Q (the half-power
//            width, by linear interpolation), and refuse, with a reason, when the sweep cannot be trusted.
//   choose:  from that, the drive frequency, the setpoint (a fraction of the free amplitude) and the loop gains, with the rule written out.

// why: 0 ok; 1 the peak is at an edge of the sweep (widen or shift it); 2 no resonance (the peak is not well above the floor);
//      3 the sweep does not bracket both half-power points; 4 the three points at the peak are degenerate;
//      5 ambiguous: a second, separate peak at 0.7 of the highest or more (docs/liquid.md, S9.2: in liquid the cell's own peaks can sit next to the lever's; the tallest
//        is not known to be the lever, so the sweep is refused rather than a peak guessed)
pub struct T { ok: int, why: int, f0: float, q: float, peak: float }

fn fail(why: int) -> [] T {
    return T { ok: 0, why: why, f0: 0.0, q: 0.0, peak: 0.0 };
}

// 1 when the sweep has a local maximum of at least 0.7 of `peak` that is not the peak's own hump: separated from it by a dip below 0.7 of the lower of the two.
fn second_peak[&b](r: &b [float], n: int, m: int, peak: float) -> [] int {
    var j = 1;
    while j < n - 1 {
        if r[j] > r[j - 1] && r[j] >= r[j + 1] && j != m && r[j] >= 0.7 * peak {
            var lo = r[j];
            var a = m;
            var b = j;
            if j < m { a = j; b = m; }
            var i = a;
            while i <= b { if r[i] < lo { lo = r[i]; } i = i + 1; }
            if lo < 0.7 * r[j] { return 1; }
        }
        j = j + 1;
    }
    return 0;
}

pub fn analyse[&a, &b](f: &a [float], r: &b [float], n: int) -> [] T {
    var m = 0;
    var floor = r[0];
    var i = 1;
    while i < n {
        if r[i] > r[m] { m = i; }
        if r[i] < floor { floor = r[i]; }
        i = i + 1;
    }
    if m == 0 || m == n - 1 {
        return fail(1);
    }
    let peak = r[m];
    var base = floor;
    if base < 1.0 { base = 1.0; }
    // a clear second peak is named before "no resonance": a forest raises the floor and would otherwise be reported as nothing there. Two guards keep a dark or noise-only sweep
    // at tag 2: the peak is at least 2 times the floor, and at least 100 counts of figure (an absolute noise guard, as the 1.0 clamp above is: a free figure is thousands, so 100 is
    // under 1%; the first version had no absolute guard and called a dark photodiode's noise "ambiguous", found by S9.4)
    if peak >= 2.0 * base && peak >= 100.0 && second_peak(r, n, m, peak) == 1 { return fail(5); }
    if peak < 5.0 * base || peak < 100.0 {
        return fail(2);                    // no resonance; under 100 counts of figure is the detector's own noise, not a signal (a dark photodiode, S9.4: noise alone used to pass as a peak)
    }
    let h = f[m + 1] - f[m];
    let denom = r[m - 1] - 2.0 * r[m] + r[m + 1];
    if denom >= 0.0 {
        return fail(4);
    }
    let f0 = f[m] + 0.5 * h * (r[m - 1] - r[m + 1]) / denom;
    let level = peak / sqrt(2.0);
    // walk left from the peak to the first point at or below the half-power level
    var l = m;
    while l > 0 && r[l] > level { l = l - 1; }
    if r[l] > level {
        return fail(3);
    }
    var u = m;
    while u < n - 1 && r[u] > level { u = u + 1; }
    if r[u] > level {
        return fail(3);
    }
    let fl = f[l] + (level - r[l]) / (r[l + 1] - r[l]) * (f[l + 1] - f[l]);
    let fu = f[u - 1] + (r[u - 1] - level) / (r[u - 1] - r[u]) * (f[u] - f[u - 1]);
    return T { ok: 1, why: 0, f0: f0, q: f0 / (fu - fl), peak: peak };
}

// what the loop is told: the drive frequency; a right-shift `shift` applied to the detector figure before the loop (so the gains have
// room: see choose); the setpoint in shifted counts; Q16 gains for sim/pid.cho and gen/pid_ir.cho; the loop gain that results
pub struct G { drive_hz: float, shift: int, setpoint: int, kp: int, ki: int, alpha: float, gloop: float }

fn rounded(x: float) -> [] int {
    return truncate(x + 0.5);
}

// The rule. The cantilever answers a change of height with a lag of tau = Q / (pi f0); the loop gets one new reading per detector
// window (`window_s` seconds), so alpha = window_s / tau of the way there each time. With the plant gain k counts per pm (after the
// shift: k / 2^shift) and a proportional step of kp/65536 of the error, the loop gain per sample is G = kp * k_eff / 65536. G is aimed at
// alpha / 2 (never more than 0.5), which keeps the loop stable against that lag.
//
// Gains are Q16 (they were Q8, whose smallest step, G = k/256 = 0.06 at 16 counts per pm, was six times too much for a tuning fork, and
// whose ki could not be slow enough). The host still shifts the figure right, by the smallest `shift` that gives kp at least 2048 (a 0.05%
// step), because a slow integral needs room: ki = round(kp * alpha / 8) is the integral time Ti = 8 / alpha samples that stability needs
// (found by simulation: an integral time of 8 samples against a plant lag of 40 made the loop swing between its stops), and it must be at
// least 1. `frac` is the setpoint as a fraction of the free amplitude (for example 0.8).
pub fn choose(t: T, k: float, window_s: float, frac: float) -> [] G {
    let tau = t.q / (3.141592653589793 * t.f0);
    var alpha = window_s / tau;
    if alpha > 1.0 { alpha = 1.0; }
    var target = alpha / 2.0;
    if target > 0.5 { target = 0.5; }
    var shift = 0;
    var keff = k;
    while 65536.0 * target / keff < 2048.0 && shift < 20 {
        shift = shift + 1;
        keff = keff / 2.0;
    }
    var kp = rounded(65536.0 * target / keff);
    if kp < 1 { kp = 1; }
    if kp > 65535 { kp = 65535; }
    var ki = rounded(float_of(kp) * alpha / 8.0);
    if ki > 65535 { ki = 65535; }
    var div = 1.0;
    var i = 0;
    while i < shift {
        div = div * 2.0;
        i = i + 1;
    }
    return G { drive_hz: t.f0, shift: shift, setpoint: truncate(frac * t.peak / div), kp: kp, ki: ki, alpha: alpha, gloop: float_of(kp) * keff / 65536.0 };
}

// A scale on the gains `choose` returns, from the Z scanner's resonance `f_scan` (Hz; 0 or less = not known, scale 1, the old behaviour) and the loop's update period `window_s`:
//     scale = 5 f_scan window_s, kept between 0.1 and 1.5.
// Found in the twin (docs/high-speed.md, HS7): the gain at which the lag blows up tracks the scanner's resonance against the loop's update rate (a 30 kHz scanner at a 250 kHz update rate
// loses the loop above about 0.6 of the chosen gains, 50 kHz above 1.1, 70 kHz above 1.6, 100 kHz above 2.3), and below that limit more gain is better. The constants 5 and 1.5 were
// chosen on a grid of 40 twin runs (two levers, four scanners, four pixel times) as the pair that never made a cell more than 1.5 times worse than the unscaled gains and cut the
// geometric-mean lag from 215 to 146 pm. A fit to the twin's scanner model, a guess about a real one.
pub fn scanner_scale(window_s: float, f_scan: float) -> [] float {
    if f_scan <= 0.0 { return 1.0; }
    var s = 5.0 * f_scan * window_s;
    if s > 1.5 { s = 1.5; }
    if s < 0.1 { s = 0.1; }
    return s;
}

// 1 when a pixel of `updates` loop updates is at least 0.7 of the scanner's period long (updates * window_s * f_scan >= 0.7), else 0: shorter than that, no gain rescued any of the twin's
// runs (lag 575 pm and up in every cell below 0.7; the cells above are not all good, and the rule says nothing about them). Unknown scanner (f_scan 0 or less): 1.
pub fn pixel_reachable(updates: int, window_s: float, f_scan: float) -> [] int {
    if f_scan <= 0.0 { return 1; }
    if float_of(updates) * window_s * f_scan < 0.7 { return 0; }
    return 1;
}

// The tapping force the setpoint asks for, pN: stiffness k (N/m) times the amplitude given up, free_pm * (1 - setpoint / free). A PROXY (N/m times pm is pN), the same
// formula the twin's `fl[35]` uses, so against the twin it is a check of the arithmetic and not of the physics; the real peak force depends on the Q and the dissipation too
// (docs/liquid.md, S9.3). `frac` is the setpoint as a fraction of the free amplitude.
pub fn force_estimate(k: float, free_pm: float, frac: float) -> [] float {
    var f = frac;
    if f > 1.0 { f = 1.0; }
    if f < 0.0 { f = 0.0; }
    return k * free_pm * (1.0 - f);
}
