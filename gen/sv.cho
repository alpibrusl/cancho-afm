edition 7;

module sv;

import std.buffer;
import ir;

fn app[&h, &r](heap: &!h Heap, b: buffer.Buffer, s: &r [byte]) -> [heap] buffer.Buffer { return buffer.append(heap, b, s); }

fn nat[&h](heap: &!h Heap, b: buffer.Buffer, n: int) -> [heap] buffer.Buffer { return buffer.push_nat(heap, b, n); }

fn name[&h](heap: &!h Heap, b: buffer.Buffer, i: int) -> [heap] buffer.Buffer {
    return nat(heap, app(heap, b, "n"), i);
}

// Operand x as read at cycle `tin`: the node itself, or its copy delayed by tin - stage(x) registers (constants never delay).
fn ref[&h, &a, &c](heap: &!h Heap, b: buffer.Buffer, t: &a [int], stg: &c [int], x: int, tin: int) -> [heap] buffer.Buffer {
    var o = name(heap, b, x);
    if ir.op(t, x) != 1 {
        let d = tin - stg[x];
        if d > 0 {
            o = nat(heap, app(heap, o, "_d"), d);
        }
    }
    return o;
}

fn decl[&h, &k](heap: &!h Heap, b: buffer.Buffer, kind: &k [byte], w: int) -> [heap] buffer.Buffer {
    return nat(heap, app(heap, app(heap, b, "  "), kind), w - 1);
}

// The graph `t` as the pipelined SystemVerilog module `mname`: a clock, `nin` signed 32-bit input words in0.. (each truncated to the
// width its range needs), `nout` signed 32-bit outputs out0.. (the nodes in `outs`), LATENCY cycles from inputs to outputs, one new
// set of inputs accepted every cycle. Every node's width comes from `lo`/`hi`; a register follows each multiply and clamp, and
// `delays` balances the rest. No reset: it is a datapath, the state lives outside. Generated; do not edit.
pub fn emit[&h, &a, &b, &c, &d, &e, &m](heap: &!h Heap, t: &a [int], outs: &b [int], nout: int, nin: int, stg: &c [int], lo: &d [int], hi: &e [int], mname: &m [byte]) -> [heap] buffer.Buffer {
    var o = buffer.empty(heap, 4096);
    region r {
        let need = alloc_slice[r](512, 0);
        ir.delays(t, stg, outs, nout, need);
        let lat = ir.latency(stg, outs, nout);
        o = app(heap, o, "// Generated by gen/main.cho. Do not edit.\nmodule ");
        o = app(heap, o, mname);
        o = app(heap, o, "(\n  input clk,\n");
        var k = 0;
        while k < nin {
            o = nat(heap, app(heap, o, "  input signed [31:0] in"), k);
            o = app(heap, o, ",\n");
            k = k + 1;
        }
        k = 0;
        while k < nout {
            o = nat(heap, app(heap, o, "  output signed [31:0] out"), k);
            if k + 1 < nout { o = app(heap, o, ",\n"); } else { o = app(heap, o, "\n"); }
            k = k + 1;
        }
        o = app(heap, o, ");\n");
        o = nat(heap, app(heap, o, "  localparam LATENCY = "), lat);
        o = app(heap, o, ";\n");
        var i = 0;
        while i < ir.count(t) {
            let op = ir.op(t, i);
            let x = ir.arg_a(t, i);
            let y = ir.arg_b(t, i);
            let z = ir.arg_c(t, i);
            let w = ir.width(lo[i], hi[i]);
            let ti = ir.tin(t, stg, i);
            o = decl(heap, o, "wire signed [", w);
            o = app(heap, o, ":0] ");
            o = name(heap, o, i);
            if ir.registered(op) == 1 { o = app(heap, o, "_c"); }
            o = app(heap, o, " = ");
            if op == 0 { o = app(heap, nat(heap, app(heap, nat(heap, app(heap, o, "in"), x), "["), w - 1), ":0]"); }
            if op == 1 { o = nat(heap, app(heap, nat(heap, o, w), "'sd"), x); }
            if op == 2 { o = ref(heap, app(heap, ref(heap, o, t, stg, x, ti), " + "), t, stg, y, ti); }
            if op == 3 { o = ref(heap, app(heap, ref(heap, o, t, stg, x, ti), " - "), t, stg, y, ti); }
            if op == 4 { o = ref(heap, app(heap, ref(heap, o, t, stg, x, ti), " * "), t, stg, y, ti); }
            if op == 5 { o = nat(heap, app(heap, ref(heap, o, t, stg, x, ti), " / 32'sd"), y); }
            if op == 9 { o = ref(heap, o, t, stg, x, ti); }
            if op == 6 {
                o = ref(heap, app(heap, ref(heap, o, t, stg, x, ti), " < "), t, stg, y, ti);
                o = ref(heap, app(heap, o, " ? "), t, stg, y, ti);
                o = ref(heap, app(heap, ref(heap, app(heap, o, " : ("), t, stg, x, ti), " > "), t, stg, z, ti);
                o = ref(heap, app(heap, ref(heap, app(heap, o, " ? "), t, stg, z, ti), " : "), t, stg, x, ti);
                o = app(heap, o, ")");
            }
            if op == 7 {
                o = ref(heap, app(heap, ref(heap, o, t, stg, x, ti), " < "), t, stg, y, ti);
                o = nat(heap, app(heap, nat(heap, app(heap, o, " ? "), w), "'sd1 : "), w);
                o = app(heap, o, "'sd0");
            }
            if op == 8 {
                o = ref(heap, app(heap, ref(heap, o, t, stg, x, ti), " != 0 ? "), t, stg, y, ti);
                o = ref(heap, app(heap, o, " : "), t, stg, z, ti);
            }
            o = app(heap, o, ";\n");
            if ir.registered(op) == 1 {
                o = decl(heap, o, "reg signed [", w);
                o = name(heap, app(heap, o, ":0] "), i);
                o = name(heap, app(heap, name(heap, app(heap, o, ";\n  always @(posedge clk) "), i), " <= "), i);
                o = app(heap, o, "_c;\n");
            }
            var m = 1;
            while m <= need[i] {
                o = decl(heap, o, "reg signed [", w);
                o = nat(heap, app(heap, name(heap, app(heap, o, ":0] "), i), "_d"), m);
                o = nat(heap, app(heap, name(heap, app(heap, o, ";\n  always @(posedge clk) "), i), "_d"), m);
                o = name(heap, app(heap, o, " <= "), i);
                if m > 1 { o = nat(heap, app(heap, o, "_d"), m - 1); }
                o = app(heap, o, ";\n");
                m = m + 1;
            }
            i = i + 1;
        }
        var q = 0;
        while q < nout {
            o = nat(heap, app(heap, o, "  assign out"), q);
            o = name(heap, app(heap, o, " = "), outs[q]);
            let dd = lat - stg[outs[q]];
            if dd > 0 { o = nat(heap, app(heap, o, "_d"), dd); }
            o = app(heap, o, ";\n");
            q = q + 1;
        }
        o = app(heap, o, "endmodule\n");
    }
    return o;
}

// The closed loop around the pipeline: `z_loop` holds the three state words, takes one sample (start + err) at a time,
// and updates the state when the result emerges LATENCY cycles later, so a sample takes LATENCY + 1 clocks. It clamps
// its output to the host's [zmin, zmax] whatever the PID did, and a deadman (no `kick` for `timeout` clocks) latches
// `fault`, after which Z goes to the clamped `zretract` and new samples are refused until `rst`. Generated; do not edit.
pub fn emit_loop[&h](heap: &!h Heap, b: buffer.Buffer, lat: int) -> [heap] buffer.Buffer {
    var o = app(heap, b, "\nmodule z_loop(\n  input clk, input rst, input start, input kick,\n");
    o = app(heap, o, "  input signed [31:0] err, kp, ki, kd, ilim, zmin, zmax, zinit, zretract,\n");
    o = app(heap, o, "  input [31:0] timeout,\n  output signed [31:0] z_out,\n  output busy,\n  output fault\n);\n");
    o = nat(heap, app(heap, o, "  localparam L = "), lat);
    o = app(heap, o, ";\n  reg signed [31:0] integ_q, prev_q, z_q;\n  reg [L-1:0] pend;\n  reg [31:0] wd;\n  reg fault_q;\n");
    o = app(heap, o, "  assign busy = |pend;\n  assign fault = fault_q;\n  wire accept = start && !busy && !fault_q;\n");
    o = app(heap, o, "  wire signed [31:0] o_integ, o_prev, o_z;\n");
    o = app(heap, o, "  pid_step core(clk, integ_q, prev_q, z_q, err, kp, ki, kd, ilim, zmin, zmax, o_integ, o_prev, o_z);\n");
    o = app(heap, o, "  wire signed [31:0] zc = (z_q < zmin) ? zmin : ((z_q > zmax) ? zmax : z_q);\n");
    o = app(heap, o, "  wire signed [31:0] rc = (zretract < zmin) ? zmin : ((zretract > zmax) ? zmax : zretract);\n");
    o = app(heap, o, "  assign z_out = fault_q ? rc : zc;\n");
    o = app(heap, o, "  always @(posedge clk) begin\n    if (rst) begin\n      integ_q <= 0; prev_q <= 0; z_q <= zinit; pend <= 0; wd <= 0; fault_q <= 0;\n    end else begin\n");
    o = app(heap, o, "      pend <= {pend[L-2:0], accept};\n      if (pend[L-1]) begin integ_q <= o_integ; prev_q <= o_prev; z_q <= o_z; end\n");
    o = app(heap, o, "      if (kick) wd <= 0; else if (wd != 32'hffffffff) wd <= wd + 1;\n");
    o = app(heap, o, "      if (timeout != 0 && wd >= timeout) fault_q <= 1;\n    end\n  end\nendmodule\n");
    return o;
}

// The raster around its tick function (module `raster_step`, combinational): the five state words in registers, one step per `tick`
// when neither `hold` nor `done` stops it, and `trace` high while the point is a recorded pixel (the first npix ticks of a line).
// Positions and counts are the host's 32-bit words. Generated; do not edit.
pub fn emit_raster[&h](heap: &!h Heap, b: buffer.Buffer) -> [heap] buffer.Buffer {
    var o = app(heap, b, "\nmodule raster(\n  input clk, input rst, input tick, input hold,\n");
    o = app(heap, o, "  input signed [31:0] npix, nlines, x0, y0, dx, dy,\n");
    o = app(heap, o, "  output signed [31:0] x_out, y_out, pix, line_out,\n  output trace,\n  output done\n);\n");
    o = app(heap, o, "  reg signed [31:0] t_q, line_q, x_q, y_q;\n  reg done_q;\n  wire signed [31:0] n_t, n_line, n_x, n_y, n_done;\n");
    o = app(heap, o, "  raster_step core(clk, t_q, line_q, x_q, y_q, {31'b0, done_q}, npix, nlines, x0, dx, dy, n_t, n_line, n_x, n_y, n_done);\n");
    o = app(heap, o, "  assign x_out = x_q;\n  assign y_out = y_q;\n  assign pix = t_q;\n  assign line_out = line_q;\n  assign done = done_q;\n");
    o = app(heap, o, "  assign trace = !done_q && (t_q < npix);\n");
    o = app(heap, o, "  always @(posedge clk) begin\n    if (rst) begin\n      t_q <= 0; line_q <= 0; x_q <= x0; y_q <= y0; done_q <= 0;\n    end else if (tick && !hold && !done_q) begin\n");
    o = app(heap, o, "      t_q <= n_t; line_q <= n_line; x_q <= n_x; y_q <= n_y; done_q <= n_done[0];\n    end\n  end\nendmodule\n");
    return o;
}

// The amplitude detector around its square-root pipeline (module `lockin_core`: inputs I and Q, output the amplitude figure).
// One ADC sample per cycle when `valid`; the reference phase advances by `tuning`; I and Q accumulate x times the signs of cos and sin
// of the phase; after `window` samples the sums are latched, `amp_valid` rises LATENCY + 1 cycles later with `amp` = floor(sqrt(I^2 + Q^2)),
// and `overflow` says a sum left +-8,388,607 (the core's 24-bit input; the figure is then not valid). Generated; do not edit.
pub fn emit_lockin[&h](heap: &!h Heap, b: buffer.Buffer, lat: int) -> [heap] buffer.Buffer {
    var o = app(heap, b, "\nmodule lockin(\n  input clk, input rst, input valid,\n  input signed [15:0] x_in,\n  input [31:0] tuning,\n  input [31:0] window,\n");
    o = app(heap, o, "  output [31:0] amp,\n  output amp_valid,\n  output overflow,\n  output signed [31:0] i_out, q_out,\n  output [31:0] phase_out\n);\n");
    o = nat(heap, app(heap, o, "  localparam L = "), lat);
    o = app(heap, o, ";\n  reg [31:0] phase;\n  reg signed [31:0] acc_i, acc_q, i_l, q_l;\n  reg [31:0] cnt;\n  reg [L:0] pend;\n  reg ovf;\n");
    o = app(heap, o, "  wire signed [31:0] xe = x_in;\n  wire cs = ~(phase[31] ^ phase[30]);\n  wire sn = ~phase[31];\n");
    o = app(heap, o, "  wire signed [31:0] ni = acc_i + (cs ? xe : -xe);\n  wire signed [31:0] nq = acc_q + (sn ? xe : -xe);\n");
    o = app(heap, o, "  wire last = valid && (cnt + 1 >= window);\n  wire signed [31:0] core_out;\n");
    o = app(heap, o, "  lockin_core core(clk, i_l, q_l, core_out);\n");
    o = app(heap, o, "  assign amp = core_out;\n  assign amp_valid = pend[L];\n  assign overflow = ovf;\n  assign i_out = i_l;\n  assign q_out = q_l;\n  assign phase_out = phase;\n");
    o = app(heap, o, "  always @(posedge clk) begin\n    if (rst) begin\n      phase <= 0; acc_i <= 0; acc_q <= 0; cnt <= 0; pend <= 0; i_l <= 0; q_l <= 0; ovf <= 0;\n    end else begin\n");
    o = app(heap, o, "      pend <= {pend[L-1:0], last};\n      if (valid) begin\n        phase <= phase + tuning;\n        if (last) begin\n");
    o = app(heap, o, "          i_l <= ni; q_l <= nq; acc_i <= 0; acc_q <= 0; cnt <= 0;\n");
    o = app(heap, o, "          ovf <= (ni > 8388607) || (ni < -8388607) || (nq > 8388607) || (nq < -8388607);\n        end else begin\n");
    o = app(heap, o, "          acc_i <= ni; acc_q <= nq; cnt <= cnt + 1;\n        end\n      end\n    end\n  end\nendmodule\n");
    return o;
}

// The SPI master for the Pmod AD1, as text (a sequential block, not a dataflow graph); generated: do not edit.
pub fn emit_spi_adc[&h](heap: &!h Heap, b: buffer.Buffer) -> [heap] buffer.Buffer {
    var o = b;
    o = app(heap, o, "// Master for the Pmod AD1 (AD7476A): see sim/spi.cho for the protocol and the one-clock-at-a-time reference this must equal.\n");
    o = app(heap, o, "// `half` (FPGA clocks per half SCK period, 1 to 255) is read when a frame starts and held for that frame.\n");
    o = app(heap, o, "module spi_adc(\n");
    o = app(heap, o, "  input clk, input rst, input start, input [7:0] half, input d0, input d1,\n");
    o = app(heap, o, "  output reg cs, output reg sck, output reg busy, output reg done,\n");
    o = app(heap, o, "  output reg [11:0] s0, output reg [11:0] s1\n");
    o = app(heap, o, ");\n");
    o = app(heap, o, "  reg [8:0] pos;\n");
    o = app(heap, o, "  reg [4:0] bit_i;\n");
    o = app(heap, o, "  reg [15:0] sh0, sh1;\n");
    o = app(heap, o, "  reg [7:0] hl;\n");
    o = app(heap, o, "  wire [7:0] hin = (half == 8'd0) ? 8'd1 : half;\n");
    o = app(heap, o, "  wire [8:0] twoh = {hl, 1'b0};\n");
    o = app(heap, o, "  always @(posedge clk) begin\n");
    o = app(heap, o, "    if (rst) begin\n");
    o = app(heap, o, "      busy <= 0; cs <= 1; sck <= 1; pos <= 0; bit_i <= 0; sh0 <= 0; sh1 <= 0; done <= 0; s0 <= 0; s1 <= 0; hl <= 1;\n");
    o = app(heap, o, "    end else begin\n");
    o = app(heap, o, "      done <= 0;\n");
    o = app(heap, o, "      if (!busy) begin\n");
    o = app(heap, o, "        if (start) begin busy <= 1; cs <= 0; sck <= 1; pos <= 0; bit_i <= 0; sh0 <= 0; sh1 <= 0; hl <= hin; end\n");
    o = app(heap, o, "      end else if (!cs) begin\n");
    o = app(heap, o, "        if (pos == hl - 1) begin sh0 <= {sh0[14:0], d0}; sh1 <= {sh1[14:0], d1}; end\n");
    o = app(heap, o, "        if (pos == twoh - 1) begin\n");
    o = app(heap, o, "          pos <= 0; sck <= 1;\n");
    o = app(heap, o, "          if (bit_i == 15) cs <= 1; else bit_i <= bit_i + 1;\n");
    o = app(heap, o, "        end else begin\n");
    o = app(heap, o, "          pos <= pos + 1; sck <= (pos + 1 < hl);\n");
    o = app(heap, o, "        end\n");
    o = app(heap, o, "      end else begin\n");
    o = app(heap, o, "        if (pos == hl - 1) begin busy <= 0; done <= 1; pos <= 0; bit_i <= 0; s0 <= sh0[11:0]; s1 <= sh1[11:0]; end\n");
    o = app(heap, o, "        else pos <= pos + 1;\n");
    o = app(heap, o, "      end\n");
    o = app(heap, o, "    end\n");
    o = app(heap, o, "  end\n");
    o = app(heap, o, "endmodule\n");
    return o;
}

// The SPI master for the Pmod DA3, as text; generated: do not edit.
pub fn emit_spi_dac[&h](heap: &!h Heap, b: buffer.Buffer) -> [heap] buffer.Buffer {
    var o = b;
    o = app(heap, o, "// Master for the Pmod DA3 (AD5541A): see sim/spi.cho. ~LDAC is held low, so the output updates when CS rises.\n");
    o = app(heap, o, "// `half` is read when a write starts and held for that frame.\n");
    o = app(heap, o, "module spi_dac(\n");
    o = app(heap, o, "  input clk, input rst, input write, input [15:0] data, input [7:0] half,\n");
    o = app(heap, o, "  output reg cs, output reg sclk, output reg din, output ldac, output reg busy, output reg done\n");
    o = app(heap, o, ");\n");
    o = app(heap, o, "  assign ldac = 1'b0;\n");
    o = app(heap, o, "  reg [1:0] stage;\n");
    o = app(heap, o, "  reg [8:0] pos;\n");
    o = app(heap, o, "  reg [4:0] bit_i;\n");
    o = app(heap, o, "  reg [15:0] sh;\n");
    o = app(heap, o, "  reg [7:0] hl;\n");
    o = app(heap, o, "  wire [7:0] hin = (half == 8'd0) ? 8'd1 : half;\n");
    o = app(heap, o, "  wire [8:0] twoh = {hl, 1'b0};\n");
    o = app(heap, o, "  always @(posedge clk) begin\n");
    o = app(heap, o, "    if (rst) begin\n");
    o = app(heap, o, "      busy <= 0; stage <= 0; cs <= 1; sclk <= 0; din <= 0; pos <= 0; bit_i <= 0; sh <= 0; done <= 0; hl <= 1;\n");
    o = app(heap, o, "    end else begin\n");
    o = app(heap, o, "      done <= 0;\n");
    o = app(heap, o, "      if (!busy) begin\n");
    o = app(heap, o, "        if (write) begin busy <= 1; stage <= 0; cs <= 0; sclk <= 0; din <= data[15]; pos <= 0; bit_i <= 0; sh <= {data[14:0], 1'b0}; hl <= hin; end\n");
    o = app(heap, o, "      end else if (stage == 0) begin\n");
    o = app(heap, o, "        if (pos == twoh - 1) begin\n");
    o = app(heap, o, "          pos <= 0; sclk <= 0;\n");
    o = app(heap, o, "          if (bit_i == 15) stage <= 1;\n");
    o = app(heap, o, "          else begin bit_i <= bit_i + 1; din <= sh[15]; sh <= {sh[14:0], 1'b0}; end\n");
    o = app(heap, o, "        end else begin\n");
    o = app(heap, o, "          pos <= pos + 1; sclk <= (pos + 1 >= hl);\n");
    o = app(heap, o, "        end\n");
    o = app(heap, o, "      end else if (stage == 1) begin\n");
    o = app(heap, o, "        if (pos == hl - 1) begin stage <= 2; cs <= 1; pos <= 0; end else pos <= pos + 1;\n");
    o = app(heap, o, "      end else begin\n");
    o = app(heap, o, "        if (pos == hl - 1) begin busy <= 0; stage <= 0; pos <= 0; bit_i <= 0; done <= 1; end else pos <= pos + 1;\n");
    o = app(heap, o, "      end\n");
    o = app(heap, o, "    end\n");
    o = app(heap, o, "  end\n");
    o = app(heap, o, "endmodule\n");
    return o;
}
