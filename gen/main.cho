edition 7;

import std.buffer;
import ir;
import pid_ir;
import sv;

// Prints the SystemVerilog of the PID step to standard output. Writes no file, opens no other program.
fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi); release(fs); release(args); release(net); release(clock); release(signals); release(exec);
    var code = 0;
    borrow mut heap as &!h in {
        region r {
            let t = alloc_slice[r](1 + 4 * 96, 0);
            let outs = alloc_slice[r](3, 0);
            pid_ir.build(t, outs);
            let inlo = alloc_slice[r](10, 0);
            let inhi = alloc_slice[r](10, 0);
            pid_ir.input_ranges(inlo, inhi);
            let lo = alloc_slice[r](96, 0);
            let hi = alloc_slice[r](96, 0);
            ir.ranges(t, inlo, inhi, lo, hi);
            let stg = alloc_slice[r](96, 0);
            ir.stages(t, stg);
            let body = sv.emit(h, t, outs, 3, 10, stg, lo, hi, "pid_step");
            let text = sv.emit_loop(h, body, ir.latency(stg, outs, 3));
            borrow mut io as &!w in { borrow text as &b in { code = buffer.write(w, b); } }
            buffer.drop(h, text);
        }
    }
    release(heap);
    release(io);
    if code < 0 {
        return 1;
    }
    return 0;
}
