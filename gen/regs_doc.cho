edition 7;

import std.buffer;
import regs;

// Prints docs/registers-table.md from host/regs.cho. Do not edit the output.
fn text[&h, &r](heap: &!h Heap, b: buffer.Buffer, s: &r [byte]) -> [heap] buffer.Buffer { return buffer.append(heap, b, s); }

fn nat[&h](heap: &!h Heap, b: buffer.Buffer, n: int) -> [heap] buffer.Buffer { return buffer.push_nat(heap, b, n); }

fn kind_text(k: int) -> [] &static [byte] {
    if k == 1 { return "RO"; }
    if k == 2 { return "WO"; }
    return "RW";
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi); release(fs); release(args); release(net); release(clock); release(signals); release(exec);
    var code = 0;
    borrow mut heap as &!h in {
        var o = buffer.empty(h, 16384);
        o = text(h, o, "<!-- Generated by gen/regs_doc.cho from host/regs.cho: do not edit. -->\n\n| Index | Address | Name | Access | Reset | Bit fields | What |\n|---|---|---|---|---|---|---|\n");
        var k = 0;
        while k < regs.count() {
            o = nat(h, text(h, o, "| "), k);
            o = text(h, o, " | 0x4000");
            var a = 4 * k;
            o = buffer.push(h, o, byte_of(48 + a / 4096 % 16 % 10));
            o = buffer.push(h, o, byte_of(48 + a / 256 % 16 % 10));
            var hi = a / 16 % 16;
            var lo = a % 16;
            if hi < 10 { o = buffer.push(h, o, byte_of(48 + hi)); } else { o = buffer.push(h, o, byte_of(87 + hi)); }
            if lo < 10 { o = buffer.push(h, o, byte_of(48 + lo)); } else { o = buffer.push(h, o, byte_of(87 + lo)); }
            o = text(h, o, " | ");
            o = text(h, o, regs.name_at(k));
            o = text(h, o, " | ");
            o = text(h, o, kind_text(regs.kind_at(k)));
            o = nat(h, text(h, o, " | "), regs.reset_at(k));
            o = text(h, o, " | ");
            var nf = regs.nfields(k);
            var j = 0;
            while j < nf {
                o = text(h, o, regs.field_name(k, j));
                o = nat(h, text(h, o, " ["), regs.field_msb(k, j));
                o = text(h, o, ":");
                o = nat(h, o, regs.field_lsb(k, j));
                o = text(h, o, "]");
                if j + 1 < nf { o = text(h, o, ", "); }
                j = j + 1;
            }
            if nf == 0 { o = text(h, o, "32 bits"); }
            o = text(h, o, " | ");
            o = text(h, o, regs.doc_at(k));
            o = text(h, o, " |\n");
            k = k + 1;
        }
        borrow mut io as &!w in { borrow o as &b in { code = buffer.write(w, b); } }
        buffer.drop(h, o);
    }
    release(heap);
    release(io);
    if code < 0 { return 1; }
    return 0;
}
