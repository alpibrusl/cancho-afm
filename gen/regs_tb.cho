edition 7;

import std.buffer;
import regs;

// Prints a Verilog testbench that checks the REAL register file of afm_top (the generated glue) against the table in host/regs.cho, by forcing the bus address
// and reading the answer combinationally: every mapped register answers without error, reads its reset value (read-only registers other than the identifier
// are not compared: they show live signals), write-only ones read 0, a write is refused exactly for the read-only ones, and every unmapped, misaligned or
// out-of-range address is refused.
fn text[&h, &r](heap: &!h Heap, b: buffer.Buffer, s: &r [byte]) -> [heap] buffer.Buffer { return buffer.append(heap, b, s); }

fn nat[&h](heap: &!h Heap, b: buffer.Buffer, n: int) -> [heap] buffer.Buffer { return buffer.push_nat(heap, b, n); }

fn hexd(d: int) -> [] int {
    if d < 10 { return 48 + d; }
    return 87 + d;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi); release(fs); release(args); release(net); release(clock); release(signals); release(exec);
    var code = 0;
    borrow mut heap as &!h in {
        var o = buffer.empty(h, 16384);
        o = text(h, o, "// Generated by gen/regs_tb.cho from host/regs.cho: do not edit.\nmodule contract_tb;\n");
        o = text(h, o, "  reg clk = 0; always #18.5 clk = ~clk;\n  wire txd; wire adc_cs, adc_sck, dz_cs, dz_din, dz_sclk, dx_cs, dx_din, dx_sclk, dy_cs, dy_din, dy_sclk, dd_cs, dd_din, dd_sclk, ldac, motor_step, motor_dir, motor_en_n; wire adc_clk; wire [11:0] adc_p = 12'd0;\n");
        o = text(h, o, "  afm_top dut(clk, 1'b1, txd, adc_cs, adc_sck, 1'b0, 1'b0, dz_cs, dz_din, dz_sclk, dx_cs, dx_din, dx_sclk, dy_cs, dy_din, dy_sclk, dd_cs, dd_din, dd_sclk, ldac, motor_step, motor_dir, motor_en_n, adc_clk, adc_p, 1'b0);\n");
        o = text(h, o, "  integer fails = 0;\n");
        o = text(h, o, "  // read the register at `addr`: it must answer with error = want_err, and (if cmp) the value `want`\n");
        o = text(h, o, "  task rd(input [31:0] addr, input [31:0] want, input cmp, input want_err, input [255:0] name);\n    begin\n      @(negedge clk); force dut.b_addr = addr; force dut.b_we = 1'b0; #2;\n");
        o = text(h, o, "      if (dut.b_err !== want_err) begin fails = fails + 1; $display(\"FAIL read %0s (%h): error flag %b, wanted %b\", name, addr, dut.b_err, want_err); end\n");
        o = text(h, o, "      if (cmp && dut.b_rdata !== want) begin fails = fails + 1; $display(\"FAIL read %0s (%h): value %h, wanted %h\", name, addr, dut.b_rdata, want); end\n");
        o = text(h, o, "      release dut.b_addr; release dut.b_we;\n    end\n  endtask\n");
        o = text(h, o, "  // a write to `addr` must be refused (want_err) or accepted; nothing is clocked while it is forced, so no register changes\n");
        o = text(h, o, "  task wr(input [31:0] addr, input want_err, input [255:0] name);\n    begin\n      @(negedge clk); force dut.b_addr = addr; force dut.b_we = 1'b1; #2;\n");
        o = text(h, o, "      if (dut.b_err !== want_err) begin fails = fails + 1; $display(\"FAIL write %0s (%h): error flag %b, wanted %b\", name, addr, dut.b_err, want_err); end\n");
        o = text(h, o, "      release dut.b_addr; release dut.b_we;\n    end\n  endtask\n");
        o = text(h, o, "  initial begin\n    repeat (400) @(posedge clk);\n");
        var k = 0;
        while k < regs.count() {
            // mapped: read answers without error; its reset value is compared for read-write registers and the identifier, 0 for write-only ones
            var cmp = 0;
            if regs.kind_at(k) == 0 || k == 0 { cmp = 1; }
            o = text(h, o, "    rd(32'h400000");
            var hi = k * 4 / 16;
            var lo = k * 4 % 16;
            o = buffer.push(h, o, byte_of(hexd(hi)));
            o = buffer.push(h, o, byte_of(hexd(lo)));
            o = nat(h, text(h, o, ", 32'd"), regs.reset_at(k));
            o = nat(h, text(h, o, ", 1'b"), cmp);
            o = text(h, o, ", 1'b0, \"");
            o = text(h, o, regs.name_at(k));
            o = text(h, o, "\");\n    wr(32'h400000");
            o = buffer.push(h, o, byte_of(hexd(hi)));
            o = buffer.push(h, o, byte_of(hexd(lo)));
            if regs.kind_at(k) == 1 { o = text(h, o, ", 1'b1, \""); } else { o = text(h, o, ", 1'b0, \""); }
            o = text(h, o, regs.name_at(k));
            o = text(h, o, "\");\n");
            k = k + 1;
        }
        // every address that is not a register must be refused, on read and on write
        o = text(h, o, "    // the unmapped indices up to 63, a misaligned address, the wrong base, and the top of the space\n");
        var u = regs.count();
        while u < 64 {
            o = nat(h, text(h, o, "    rd(32'h40000000 + 4 * "), u);
            o = text(h, o, ", 32'd0, 1'b0, 1'b1, \"unmapped\");\n");
            o = nat(h, text(h, o, "    wr(32'h40000000 + 4 * "), u);
            o = text(h, o, ", 1'b1, \"unmapped\");\n");
            u = u + 1;
        }
        o = text(h, o, "    rd(32'h40000001, 32'd0, 1'b0, 1'b1, \"misaligned\"); rd(32'h00000004, 32'd0, 1'b0, 1'b1, \"wrong base\"); rd(32'h40000100, 32'd0, 1'b0, 1'b1, \"past the map\"); rd(32'hC0000004, 32'd0, 1'b0, 1'b1, \"high base\");\n");
        o = text(h, o, "    $display(\"contract check: ");
        o = nat(h, o, regs.count());
        o = text(h, o, " registers, %0d failures\", fails);\n    $finish;\n  end\nendmodule\n");
        borrow mut io as &!w in { borrow o as &b in { code = buffer.write(w, b); } }
        buffer.drop(h, o);
    }
    release(heap);
    release(io);
    if code < 0 { return 1; }
    return 0;
}
